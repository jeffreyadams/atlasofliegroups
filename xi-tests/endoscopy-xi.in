prints("### torus gate relaxation: xi=1/2 cover of split R^x (type z!=1)")
set T=split_torus(1)
xi_cover(T,[1/2])
prints("canonicalization mod X^*: ", cover_xi(xi_cover(T,[3/2])), " ", cover_xi(xi_cover(T,[-1/2])), " equal forms: ", xi_cover(T,[3/2])=xi_cover(T,[1/2]))
set Tx=xi_cover(T,[1/2])
set p=param(KGB(Tx,0),[0],[3/2])
prints("genuine param: ", p, " lambda=", p.lambda)
prints("### endoscopic_group_xi: SL(2,R), s=diag(1,-1)")
set (H,M,Hv)=endoscopic_group_xi(SL(2,R),[1/2])
prints("H = ", H)
prints("genuine packet of H at gamma=1/2:")
for q in all_parameters_gamma_xi(H,[1/2]) do prints("  ",q) od
prints("### endoscopic_group_xi: Sp(4,R), v=[1,1]/2")
set (H2,M2,H2v)=endoscopic_group_xi(Sp(4,R),[1,1]/2)
prints("H2 = ", H2)
prints("### trivial datum collapses to plain G")
set (H0,,)=endoscopic_group_xi(SL(2,R),[0/1])
prints("H0 = ", H0, "  plain: ", =cover_xi(H0))
prints("### xi=0 agreement: all_parameters_gamma_xi vs original (SL(2,R), gamma=rho)")
set A=all_parameters_gamma(SL(2,R),[1/1]), B=all_parameters_gamma_xi(SL(2,R),[1/1])
prints("counts ", #A, "=", #B, "  same sets: ", all(for a in A do any(for b in B do b=a od) od) and #A=#B)
prints("### is_valid_xi at xi=0 = is_valid (must agree on both branches)")
set y=KGB_elt_gen(dual(inner_class(SL(2,R))), id_mat(1), [1/2])
prints("invalid y: ", is_valid(y,[1/1]), " ", is_valid_xi(SL(2,R),y,[1/1]), "   [expect false false: agreement]")
set yv=KGB_elt_gen(dual(inner_class(SL(2,R))), id_mat(1), [0/1])
prints("valid y:   ", is_valid(yv,[1/1]), " ", is_valid_xi(SL(2,R),yv,[1/1]), "   [expect true true: agreement]")
prints("### real-parabolic descent from a cover now works (was blocked)")
set Gx=xi_cover(GL(2,R),[1,1]/2)
set pd=param(KGB(Gx,KGB_size(Gx)-1),[1,0],[3,-3]/2)
cuspidal_data(pd)
