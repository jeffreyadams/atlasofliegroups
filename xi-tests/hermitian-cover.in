prints("### R^x cover: unitary genuine character mu (lambda=1/2)")
set T=split_torus(1)
set Tx=xi_cover(T,[1/2])
set mu=param(KGB(Tx,0),[0],[0/1])
mu
prints("is_hermitian(mu): ", is_hermitian(mu), "   [expect true: mu unitary]")
prints("hermitian_dual(mu)=mu: ", hermitian_dual(mu)=mu)
prints("### R^x cover: |.|^s twist, s=1: not hermitian (matches group analogue)")
set mus=param(KGB(Tx,0),[0],[1/1])
prints("is_hermitian(mus): ", is_hermitian(mus), "   group analogue: ",
       is_hermitian(param(KGB(T,0),[0],[1/1])))
prints("### form computation on projective-twist cover is gated")
hermitian_form_irreducible(mu)
prints("### GL(2,R) det/2 cover: lift of trivial is hermitian")
set G=GL(2,R)
set Gx=xi_cover(G,[1,1]/2)
set lp=param(KGB(Gx,1),[0,0],[1,-1]/2)
prints("is_hermitian(lift): ", is_hermitian(lp), "   [expect true]")
prints("### kappa=0 cover (compact torus): old twist path intact")
set Cx=xi_cover(compact_torus(1),[1/2])
set pc=param(KGB(Cx,0),[3],[0/1])
prints("is_hermitian(pc): ", is_hermitian(pc))
prints("hermitian_form_irreducible(pc): ")
hermitian_form_irreducible(pc)
prints("### done")
quit
