prints("### R^x cover: no delta-fixed xi exists; rejected in v1")
set T=split_torus(1)
xi_cover(T,[1/2])
prints("### GL(2,R) det/2 cover: same-x hermitian dual")
set G=GL(2,R)
set Gx=xi_cover(G,[1,1]/2)
set lp=param(KGB(Gx,1),[1,0],[1,-1]/2)
prints("is_hermitian(lift of trivial): ", is_hermitian(lp), "   [expect true]")
set lps=param(KGB(Gx,1),[1,0],[2,-1]/1)
prints("is_hermitian(asymmetric nu): ", is_hermitian(lps), "   [expect false: nu built asymmetric]")
prints("### form computation gated on non-equal-rank covers")
hermitian_form_irreducible(lp)
prints("### kappa=0 cover (compact torus): forms computable (equal rank)")
set Cx=xi_cover(compact_torus(1),[1/2])
set pc=param(KGB(Cx,0),[3],[0/1])
prints("is_hermitian(pc): ", is_hermitian(pc))
hermitian_form_irreducible(pc)
prints("### done")
quit
