<basic.at { for |s_to_1| and many others }
<count.at { for |char_counter| }
<parameters.at { for |dual_inner_class| }
<hash.at {for hashed low function}
<integrality_hash.at
<polynomial.at {for eval}
<translate.at {for translate_param_by}
<K.at {for parameter@KType}
{ KL stuff, including character formulas and composition series
  This implementation seeks to avoid using KL_block, and instead uses
  KL_sum_at_s, as this function stores earlier results
  Also (compared to old implementation) no regular/singular case distinction
}

set integrality_datum(Param p) = RootDatum:
    if IH_flag
    then integrality_datum_hash(p)
    else integrality_datum(p)
    fi

set integrality_datum(RootDatum rd, ratvec gamma) = RootDatum:
    if IH_flag
    then integrality_datum_hash(rd,gamma)
    else integrality_datum(rd,gamma)
    fi

{convention: "to_height" always computes with a to height algorithm. "to_ht" may
choose whether "to height" or "to infinity" algorithm is faster.}

{<time.at {for print_time_string}}
{
  Basic object: column of KL matrix (P-matrix), of polynomials evaluated as s,
  which by setting s=1 gives formula for irreducible as sum of standards

  main functions:

  character_formula(p): irreducible(p) as sum of standards
  composition_series(p): standard(p) as sum of irreducibles

  signed_KL_mat_at_1(p): signed P-matrix evaluated at 1 (integral matrix)
  KL_inverse_mat_at_1(p): Q-matrix evaluated at 1 (integral matrix)

  also
    print_character_formula,print_composition_series
}

{ ------------------------------------------------------------------- }
{seat_belt_on:=false}

set twisted_KL_sum_at_s_library(Param p) = twisted_KL_sum_at_s(p)

{Move the param out where W_int(p)  can act}
set regularize_new(Param p) = Param:
    let gamma = p.infinitesimal_character, rd = p.root_datum
    then shift = sum(#gamma, for av@j in rd.simple_coroots
    	       	     if (av*gamma).=
		     do rd.fundamental_weights[j]
		     fi
		     od).numer
    in translate_param_by (p, shift)

set regularize_new_flag = true

{Move the param out where W_int(p)  can act}
set regularize(Param p) = Param:
    if regularize_new_flag
    then regularize_new(p)
    else translate_param_by (p, p.root_datum.two_rho)
    fi

set dualPBTime = int: 0

{first return is partial block above p; second is dual, for predicting time for KL_sum_at_s_to_height}
set dual_partial_block_sizes(Param p, int HT) = (int,int):
    let start = elapsed_ms(), p2r = p.root_datum.two_rho
    then preg = translate_param_by (p, p2r)
    then (Breg,m) = block(preg)
    then M = m-first(for j:m+1 do height(translate_param_by(Breg[m-j],-p2r)) > HT od)
    in (m, if M > m
       	   then #Breg - m
       	   else #Breg - M
       	   fi) next dualPBTime +:= elapsed_ms() - start

{whether to turn on u_predictor and u_predictor_to_ht in hermitian.at}
set predictor_flag = false {evening 12/21/25; was false until 12/19, when something went wrong}

{whether to use to_ht instead of truncating full_deform}
set to_ht_over_u_flag = true

{set CF_flag = false}
set charTime = int:0

set charTimeToHt = int:0

{ the next type is the same as |Maybe<KTypePol>|, but injector names differ }
set_type maybe_KTP = (void timed_out | KTypePol done)

set_type maybe_PP =  (void timed_out_PP | ParamPol done_PP)

set is_done(maybe_KTP P) = bool:
    case P
    | timed_out: false
    | done: true
    esac

set is_done(maybe_PP P) = bool:
    case P
    | none: false
    | some: true
    esac

set KL_sum_at_s(Param p) = ParamPol:
    let start = elapsed_ms()
    in KL_sum_at_s(p) next charTime +:= elapsed_ms() - start; char_counter.use()

set character_formula (Param p) = ParamPol:
    s_to_1(KL_sum_at_s(p))

set character_formula (ParamPol P) = ParamPol: map(character_formula@Param,P)

{height of a Param of infl char gamma and KGBElt x}
set height(KGBElt x, ratvec gamma) = int:
    let gamthgam = (1+x.involution)*gamma, rd = x.root_datum
    then q = dominant(rd,gamthgam)*rd.rho_check
    in q.numer\q.denom

{ Block of p, including zero parameters. Relevant because that's where
KL calculations need to happen }
set full_block(Param p) = [Param]:
    let tworho = two_rho(p.real_form)
    then q0 = parameter(p.x,p.lambda +tworho, p.nu+tworho)
    in for q in block_of(q0)
       do parameter(q.x,q.lambda-tworho, q.nu-tworho)
       od

set easy_full_size_flag = true

{in is_unitary_to_ht(HT), KL calculations live in this subset of
full_block}
set full_block_to_ht(Param p, int HT) = [Param]:
    for q in full_block(p)
    ~do if height(q) <= HT
       then q
       else break
       fi
    od

set full_block_down_size(Param p) = int:
    if easy_full_size_flag
    then p.x.number
    else let tworho = two_rho(p.real_form)
    	 then q0 = parameter(p.x,p.lambda +tworho, p.nu+tworho)
    	 in #partial_block(q0)
    fi

{need to compute on loading; if it's repeated,
the second invocation will be too fast}
{Divide by 4 as unexplained heuristic to improve guess}
set KL_rate = rat:
    let start = elapsed_ms()
    then m = #KL_sum_at_s(E6_s.trivial)
    {then  (,m,,) = KL_block(E6_s.trivial)} {size of E6_s block above trivial}
    in (elapsed_ms() - start)*2^(13-2)/(m^2*3^6)

set KL_rate(RealForm G) = rat:
    let start = elapsed_ms()
    then m = #KL_sum_at_s(G.trivial)
    {then  (,m,,) = KL_block(G.trivial)} {size of G block above trivial}
    in (elapsed_ms() - start)*2^(2*G.semisimple_rank+1)/(m^2*3^(G.semisimple_rank))

{predicted time in milliseconds to compute KL in block of p}
set KL_predictor_full(Param p) = int:
    let rk = semisimple_rank(integrality_datum(p))
    in floor((#full_block(p))^2*3^rk* KL_rate/2^(2*rk+1))
    {next prints("we're in KL_pred_full at ",p)}
{number of extremal pairs in full block is ROUGHLY: (x,y) so tau(y)\cap tau(x) is empty.
Number of pairs of [bool] with ANSWER IS 3^rank.}

{this one is relevant to KL_sum_at_s_to_height, I think?}
{predicted time in milliseconds to compute KL to height HT in block of p}
{typically applied near principal series, where all tau invts large; so (3/4)^rk factor is not justified}
{Extra factof of 4 is unexplained heuristic; undo rate heuristic}
set KL_predictor_to_ht(Param p, int HT) = int:
    {let rk = semisimple_rank(integrality_datum(p))}
    floor((#full_block_to_ht(p,HT))^2 * {3^rk*}KL_rate/2{/2^({2*rk+}1)})
{next prints("we're in KL_pred_up at ",p)}

{relevant to KL_sum_at_s for p}
set KL_predictor(Param p) = int:
    let rk = semisimple_rank(integrality_datum(p))
    in floor((full_block_down_size(p))^2*3^rk*KL_rate/2^(2*rk + 1))
{next prints("we're in KL_pred at ",p)}

set lowp_count= int:0
set lowp_time = int:0
{for predicting whether to_ht or is_unitary is faster}
set low(Param p) = (int,int,int):
    let start = elapsed_ms(), ic = p.inner_class, theta = p.x.involution, gamma = p.infinitesimal_character
    then LAM = (dominant(ic,(1+theta)*gamma)*ic.two_rho_check)\2 {this is
    height(p); size of lambda}
    then NU = (dominant(ic, (1-theta)*gamma) *ic.two_rho_check)\2 {size of nu}
    then GAM = (p.infinitesimal_character* ic.two_rho_check)\1 {this is max height at infl char}
    	 {is_unitary_to_ht(p,GAM) means unitary}
    in (LAM,NU,GAM) next lowp_count+:=1; lowp_time +:= elapsed_ms() - start

set GAM(Param p) = int: (p.infinitesimal_character*p.inner_class.two_rho_check)\1

{gamma meant to be dominant. count reducibility hyperplanes (gamma0,alphav) >0 int,
(gamma0,theta*alphav) <0 int) crossed in deforming gamma to local zero
(gamma+theta*gamma)/2. Estimates cost of is_unitary(x,gamma)}
set red_walls(KGBElt x, ratvec gamma) = int:
    let theta = x.involution, rd = x.root_datum, answer = rat:0
    in for av@j in rd.poscoroots
       do let pos = floor(av*gamma), neg = ceil(av*theta*gamma)
       	  in if pos >=1 and neg <= -1
       	     then answer+:= if (av+av*theta).= {forces pos=neg}
	     	  	    then (pos+1)/2
			    else min(pos,-neg)/2
			    fi
	     fi
       od;
       floor(answer)

<Levix.at { Levix, Levix_simp, rho_C, rho_C_Levi, pL, pL_simp, simp_lift, simp_flag }

set std_quo(Param p) = ParamPol:
    1*p-character_formula(1*p)

set ind_quoTIME = int:0

set ind_quo(KGBElt x, ratvec lambda, vec av, rat t) = KTypePol:
    let start = elapsed_ms()
    then pL = pL(x,lambda,av,t)
    in K_type_pol(std_quo(pL))  next ind_quoTIME+:= elapsed_ms() - start

set ind_quo_simp(KGBElt x, ratvec lambda, vec av, rat t) = (KTypePol,mat):
    let start = elapsed_ms(), (pL_simp,M) = pL_simp(x,lambda,av,t)
    in (K_type_pol(std_quo(pL_simp)),M) next ind_quoTIME+:= elapsed_ms() - start

set to_ht_G(RealForm G, KTypePol QL, int HT) = KTypePol:
    if HT.< then return QL fi;
    sum(QL.real_form,
	for c@tauL in QL
    	do if dominant(G,parameter(tauL).d_lambda)*(G.two_rho_check) <= HT
	   then c*tauL
	   else 0*tauL
	   fi
	od)

{M is for restricting weights on G to the Levi where QL lives}

set to_ht_G_simp(RealForm G, ratvec dlambda, KTypePol QL, int HT, mat M) = KTypePol:
    if HT.< then return QL fi;
    let (J,d) = simp_lift(G,M)
    then lambda0 = dlambda - (J*(M*dlambda))/d
    in sum(QL.real_form,
	for c@tauL in QL
    	do if dominant(G,lambda0 +(J* parameter(tauL).d_lambda)/d)*(G.two_rho_check) <= HT
	   then c*tauL
	   else 0*tauL
	   fi
	od)

set testTIME = int: 0

{the uncached form, kept as the definition the cache below must agree with}
set test_simp_uncached(KGBElt x, ratvec lambda, vec av, rat t, int HT) = bool:
    let start = elapsed_ms(), (QL,M) = ind_quo_simp(x,lambda,av,t)
    in to_ht_G_simp(x.real_form, (lambda+x.involution*lambda)/2, QL, HT, M).!= next testTIME +:=elapsed_ms() - start

{The HT dependence of test_simp is only a threshold: either QL is zero, and the test is
false for every HT, or QL has a lowest G-height H1, and the test is HT>=H1 (HT<0 means no
truncation at all, so the test is then true). So what gets cached is H1, and one entry
serves every HT. Two layers: the K-type differentials of QL, which are the expensive part
and depend on lambda only through M*lambda, and the threshold itself, which is a few
dominant() calls on top of them.}

{canonical key: %ratvec and %rat are normalised, so equal values give equal keys}
set simp_key(vec av, ratvec lam, rat t) = vec:
    let (ln,ld) = %lam, (tn,td) = %t in av ## ln ## [ld,tn,td]

set simp_dl_hits = int:0
set simp_dl_misses = int:0
set simp_dlTIME = int:0

{layer 1: the distinct d_lambdas of the K-types of std_quo(pL_simp), in Lsimp coordinates}
set (simp_dlambdas,simp_dlambdas_report) =
    (((KGBElt,ratvec,vec,rat)->[ratvec]),(void -> void)):
    let KGBhash = make_KGBElt_hash()
    then vechashes = [vec_hash]: [] {one for each KGBElt}
    then answers = [[[ratvec]]]: [] {1st index is x, second (av,M*lambda,t)}
    in (
    (((KGBElt,ratvec,vec,rat)->[ratvec]): (KGBElt x, ratvec lambda, vec av, rat t) [ratvec]:
    let start = elapsed_ms(), N = KGBhash.size()
    then n = KGBhash.match(x)
    in if n=N
       then vechashes#:=make_vec_hash();
       	    answers#:= ([[ratvec]]:[])
       fi;
       let (,,,M,) = Levix_simp(x,av)
       then key = simp_key(av,M*lambda,t)
       then J = vechashes[n].size()
       then j = vechashes[n].match(key)
       in if j=J
	  then simp_dl_misses+:=1;
	       let (QL,) = ind_quo_simp(x,lambda,av,t)
	       then dls = [ratvec]: []
	       in for @tauL in QL
	       	  do let v = ratvec: parameter(tauL).d_lambda
		     in if none(#dls,(int i)bool: dls[i]=v) then dls#:=v fi
		  od;
		  answers[n]#:= dls
	  else simp_dl_hits+:=1
	  fi;
	  answers[n][j] next simp_dlTIME +:=elapsed_ms() - start)
    , @: {simp_dlambdas_report}
      prints("simp_dlambdas is hashing ",sum(for vechash in vechashes do vechash.size() od),
      	     " triples (av,M*lambda,t), ",simp_dl_hits," hits, ",simp_dl_misses,
	     " misses, in time ",print_time_string(simp_dlTIME))
       )

set simp_H1_hits = int:0
set simp_H1_misses = int:0
set simp_H1TIME = int:0

{layer 2: the threshold H1, or -1 when QL is zero (heights of K-types are never negative)}
set (simp_H1,simp_H1_report) = (((KGBElt,ratvec,vec,rat)->rat),(void -> void)):
    let KGBhash = make_KGBElt_hash()
    then vechashes = [vec_hash]: [] {one for each KGBElt}
    then answers = [[rat]]: [] {1st index is x, second (av,lambda,t)}
    in (
    (((KGBElt,ratvec,vec,rat)->rat): (KGBElt x, ratvec lambda, vec av, rat t) rat:
    let start = elapsed_ms(), N = KGBhash.size()
    then n = KGBhash.match(x)
    in if n=N
       then vechashes#:=make_vec_hash();
       	    answers#:= ([rat]:[])
       fi;
       let key = simp_key(av,lambda,t)
       then J = vechashes[n].size()
       then j = vechashes[n].match(key)
       in if j=J
       	  then simp_H1_misses+:=1;
	       let dls = simp_dlambdas(x,lambda,av,t)
	       in if #dls=0
	       	  then answers[n]#:= (rat: -1)
		  else let G = x.real_form, (,,,M,) = Levix_simp(x,av)
		       then (Jl,d) = simp_lift(G,M)
		       then dlambda = (lambda+x.involution*lambda)/2
		       then lambda0 = dlambda - (Jl*(M*dlambda))/d
		       then m = rat: -1
		       in for v in dls
		       	  do let h = dominant(G,lambda0+(Jl*v)/d)*(G.two_rho_check)
			     in if m < 0 or h < m then m := h fi
			  od;
			  answers[n]#:= m
		  fi
	  else simp_H1_hits+:=1
	  fi;
	  answers[n][j] next simp_H1TIME +:=elapsed_ms() - start)
    , @: {simp_H1_report}
      prints("simp_H1 is hashing ",sum(for vechash in vechashes do vechash.size() od),
      	     " triples (av,lambda,t), ",simp_H1_hits," hits, ",simp_H1_misses,
	     " misses, in time ",print_time_string(simp_H1TIME))
       )

set test_simp(KGBElt x, ratvec lambda, vec av, rat t, int HT) = bool:
    let start = elapsed_ms()
    then H1 = simp_H1(x,lambda,av,t)
    in (if H1 < 0 then false {QL is zero: false at every HT}
        elif HT.< then true {no truncation: QL is nonzero}
	else H1 <= HT
	fi) next testTIME +:=elapsed_ms() - start

set test(KGBElt x, ratvec lambda, vec av, rat t, int HT) = bool:
    if simp_flag
    then return test_simp(x,lambda,av,t,HT)
    else let start = elapsed_ms(), QL = ind_quo(x,lambda,av,t)
    	 in to_ht_G(x.real_form, QL,HT).!= next testTIME +:=elapsed_ms() - start
    fi

{END TAKEN FROM STEVE}

set rwTIME = int:0

set red_walls(Param p) = int:
    let start = elapsed_ms(), theta = p.x.involution, rd = p.root_datum, gamma=p.infinitesimal_character 
    then p0 = p*0, answer = rat:0
    in for av@j in rd.poscoroots
       do let pos = floor(av*gamma), neg = ceil(av*theta*gamma)
       	  in if pos >=1 and neg <= -1
       	     then answer+:= if (av+av*theta).= {forces pos=neg}
	     	  	    then if is_parity(rd.posroots[j], p0)
			    	 then pos\2
			         else (pos+1)\2
				 fi
			    else min(pos,-neg)/2
			    fi
	     fi
       od;
       answer\1 next rwTIME +:=elapsed_ms() - start

set next_x(KGBElt x, ratvec gamma, int HT) = KGBElt:
let nx = x.number, G= x.real_form
then ans = first(for j:nx do @bool: (height(KGB(G,nx-j),gamma) > HT) od)
in if ans < 0
   then KGB(G,0)
   else KGB(G,nx-ans)
   fi

{
opposite to red_walls: in dual KGB algorithm, start more or less on x_open and work up (to next_x).
This counts walls crossed in the process, so estimates cost of is_unitary_to_ht(x,gamma,HT)}
{set red_walls_to_ht(KGBElt x, ratvec gamma, int HT) = int:
    let xH = next_x(x,gamma,HT)
    in red_walls(x_open(x.real_form),gamma) - red_walls(xH,gamma)
}
set rwhTIME = int:0

set red_walls_to_ht(Param p, int HT) = int:
    let start = elapsed_ms(), x = p.x, lambda = p.lambda, answer = rat:0
    then theta = p.x.involution, rd = p.root_datum, gamma=p.infinitesimal_character 
    in for av@j in rd.poscoroots
       do let pos = floor(av*gamma), neg = ceil(av*theta*gamma)
       	  in if pos >=1 and neg <= -1
       	     then for t: min(pos,-neg) from 1
	     	  do if test(x,lambda, av, t,HT)
		     then answer+:= 1/(if (av + (av*theta)).= then 1 else 2 fi)
		     fi
		  od
	     fi
       od;
       answer\1 next rwhTIME:=elapsed_ms() - start


{gamma meant to be dominant. count reducibility hyperplanes (gamma0,alphav) >0 int,
(gamma0,theta*alphav) <0 int). Estimates cost of KL_sum_at_s(x,gamma)}
set red_walls_int(KGBElt x, ratvec gamma) = int:
    let theta = x.involution, rd = x.root_datum, answer = rat:0
    {then gamma_reg = gamma+rd.rho}
    in for av in rd.poscoroots
       do if is_integer(av*gamma) and av*theta*gamma{_reg} < 0
       	     {could also check parity}
       	  then answer+:= 1/2
	  fi
       od;
       answer\1

set rwiTIME = int:0

set red_walls_int(Param p) = int:
    let start = elapsed_ms(), x = p.x,  gamma = p.infinitesimal_character
    then theta = x.involution, rd = x.root_datum, answer = rat:0
    in for av@j in rd.poscoroots
       do if is_integer(av*gamma) and av*gamma > 0 and av*theta*gamma < 0
       	  then if is_real(j,x)
	       then if is_parity(rd.posroots[j],p)
	       	    then answer+:=1
		    fi
	       else answer +:= 1/2
	       fi
	  fi
       od;
       answer\1 next rwiTIME+:=elapsed_ms() - start

set red_walls_to_ht_int(KGBElt x, ratvec gamma, int HT) = int:
    let start = elapsed_ms(), xH = next_x(x,gamma,HT)
    in max(red_walls_int(x_open(x.real_form),gamma) - red_walls_int(xH,gamma),0)

set rwhiTIME = int:0

set red_walls_to_ht_int(Param p, int HT) = int:
    let start = elapsed_ms(), x = p.x, gamma = p.infinitesimal_character, lambda = p.lambda,
    	answer = rat: 0/1
    then theta = p.x.involution, rd = p.root_datum, gamma=p.infinitesimal_character
    in for av@j in rd.poscoroots
       do if is_integer(av*gamma) and  av*gamma > 0 and av*theta*gamma < 0 and
       	     test(x,lambda, av, av*gamma,HT)
       	  then answer +:= if (av*(1+theta)).=
	       	       	  then 1
		       	  else 1/2
		       	  fi
       	  fi
       od;
       answer\1 next rwhiTIME +:= elapsed_ms() - start

set prefer_red_char_flag = true

{how much should to_ht win by to use to_ht?}
set red_mult_char = rat:3/2

{How many reducibility walls are needed to make to_ht worth considering?}
set red_NUM_char = int: 10

set low_red_char(Param p, int HT) = bool:
    if HT < 0 then return true fi;
    let RWI = red_walls_int(p)
    in RWI > red_NUM_char and red_walls_to_ht_int(p,HT)*red_mult_char < RWI


{If NU (nu part) > LAM (lambda part) *nu_frac, then figure to_ht could work better}
set nu_frac = 1/1

{if target height < GAMMA*gamma_frac, then figure to_ht could be faster. So largest
reasonable target height is GAMMA*gamma_frac. INCREASE to use to_ht
more often}
{In E7_s, gamma_frac = 1/3 and test25 = params of infl char rho so low(p, ht(p)+25)
let to character_formula MUCH faster than character_formulas_to_ht: 178 secs vs 978 secs}
set gamma_frac = 1/4

{part of condition that u_to_ht might be faster is GAM > lam_mult*LAM}

{if diff_mult*rank*(HT - LAM) >= GAM then don't try is_unitary_to_ht.
So largest reasonable target height is (1/(diff_mult*rank))*GAM + LAM.
DECREASE to use to_ht more often, range is (0,infty)}
set diff_mult = rat: 3/2 {switch from 1/1 8/11/26}

{if target height < GAM*diff_char_frac, then figure
{formerly (GAM - LAM)*diff_frac}
is_unitary_to_ht could be faster. So largest reasonable target height
is (GAM-LAM)*diff_frac. INCREASE to use to_ht more often}
{3/4 best for Spin(6,6) after 3/31/26 MvL improvements}
set diff_char_frac = rat: 1/9 {1/10}{1/6, 1/4 much worse for E7 4/2/26}
    		   {1/8 and 1/12 used a bit more memory and time in
    		     	       spherical E7_s}
		{2/5/26: for Spin(6,6), .20 was faster than .15 or .25}
		{2/12/26: 1/3 was better than 1/5 or 1/2 for E7_s (20925,[ 1, 2, 2, 1, 1, 2, 2 ]/1)}
		{2/14/26: 1/4 better than 1/3 for E7_s[20000:20025]}
		{2/15/26: 1/8 much better than 1/4 20800-20810}
		{4/2/26: 1/4 best for Spin(6,6), with diff_KGB_char_frac 1/2?}

{if diff_char_mult*rank*(HT - LAM) >= GAM then don't try char_to_ht.
So largest reasonable target height is (1/(diff_char_mult*rank))*GAM + LAM.
DECREASE to use char_to_ht more often, range is (0,infty)}
set diff_char_mult = rat: 2/1

set diff_KGB_char_frac = rat: 1/2 {9/10} {switch 4/2/26 based on Spin(6,6), E7_s near 17000}

{if lam_mult*LAM >= GAM (big lambda), don't try to_ht
In range [1/1,infty). DECREASE to use to_ht more often.}
set lam_mult = rat: 2/1

{whether to use to_height in computing to height N}
{true means large nu/small ht, so is_unitary_to_ht could be better}
set low_nu(Param p, int HT) = bool:
    if HT < 0 then return  false fi;
    let (,NU,) = low(p)
    in NU > HT*nu_frac

{set strict_low_nu(Param p, int HT) = bool:
    if HT < 0 then return  false fi;
    let (,NU,) = low(p)
    in (strict_factor*NU > HT*nu_frac)}

{true means GAM big compared to HT, so is_unitary_to_ht could be better}
{If N>= GAM, then to_ht gives answer to unitarity.}
set low_gamma(Param p, int HT) = bool:
    if HT < 0 then return  false fi;
    {let (,,GAM) = low(p)
    in} (GAM(p)*gamma_frac) > HT


{NOT USED now 6/1/26} 
set low_rank_mult = rat: 2/1

{true means to_ht should REALLY be better; LESS true than low_diff}
set low_diff_def_ht(Param p, int HT) = bool:
    let LAM = p.height, GAM = GAM(p), rk = p.real_form.rank
    in lam_mult*LAM < GAM and
       2*diff_mult*(HT - LAM)*rk < GAM
       {(5/4)*(p.real_form.rank)*(HT - LAM) < GAM} {rm LAM 5/27/26}

{true means is_u should REALLY be better; less true than low_diff is false}
set low_diff_def_u(Param p, int HT) = bool:
    let LAM = p.height, GAM = GAM(p), rk = p.real_form.rank
    in lam_mult*LAM > GAM or
       (1/2)*diff_mult*rk*(HT - LAM) > GAM {6/1 revert to mid-april}
       {(4/5)*(p.real_form.rank)*(HT - LAM) < GAM} {rm LAM 5/27/26}

{Note HT must be in [LAM,GAM) True says it's near the bottom of that range: small HT, to_ht better}
{to get more to_ht, DECREASE lam_mult and diff_mult}
set low_diff(Param p, int HT) = bool:
    if (HT < 0) then return  false fi;
    let LAM = p.height, GAM = GAM(p), rk = p.real_form.rank
    in lam_mult*LAM < GAM and
       diff_mult*rk*(HT - LAM) < GAM
       {(p.real_form.rank)*(HT - LAM) < GAM} {rm LAM 5/27/26; bad idea??}
    {more or less trying diff_frac = 1/G.rank}
    {(LAM < lam_frac*GAM) and} {(HT < diff_frac*GAM)}
    {(LAM < lam_frac*GAM) and ((GAM - LAM)*diff_frac) > HT {(HT-LAM)}}

{how much should to_ht win by to prefer unitary_to_ht?}
set red_mult = rat:4/3

{How many reducibility walls are needed to make unitary_to_ht worth considering?}
set red_NUM = int: 40

{true means to_ht should REALLY be better; LESS true than low_red}
set low_red_def_ht(Param p, int HT) = bool:
    if (HT < 0) then return  false fi;
    let RW = red_walls(p)
    in RW > (3/2)*red_NUM and (3/2)*red_walls_to_ht(p,HT)*red_mult < RW

{true means is_u should REALLY be better; LESS true than low_diff is false}
set low_red_def_u(Param p, int HT) = bool:
    if (HT < 0) then return  false fi;
    let RW = red_walls(p)
    in (3/2)*RW < red_NUM or red_walls_to_ht(p,HT)*red_mult > (3/2)*RW

{Note HT must be in [LAM,GAM) True says it's near the bottom of that range: small HT, to_ht better}
set low_red(Param p, int HT) = bool:
    if (HT < 0) then return  false fi;
    let RW = red_walls(p)
    in RW > red_NUM and red_walls_to_ht(p,HT)*red_mult < RW

set low_diff_char_mult = rat: 1
set low_diff_char_old_flag = true
set low_diff_char_time = int:0

{true if we're SURE KL_sum_at_s_to_ht is faster}
set low_diff_char_def_ht(Param p, int HT) = bool:
    if (HT < 0) then return  false fi;
    let start = elapsed_ms()
    then ans = p.x.number > diff_KGB_char_frac*KGB_size(p.real_form)
	       and (HT < (1/2)*diff_char_frac*GAM(p)) {forces LAM < diff_char_frac*GAM}
    in ans {next low_diff_char_time +:= (elapsed_ms() - start)}

{false if we're SURE KL_sum_at_s is faster}
set low_diff_char_def_inf(Param p, int HT) = bool:
    if (HT < 0) then return  false fi;
    let start = elapsed_ms()
    then ans = p.x.number > diff_KGB_char_frac*KGB_size(p.real_form)
	       and (HT < 2*diff_char_frac*GAM(p)) {forces LAM < diff_char_frac*GAM}
    in ans {next low_diff_char_time +:= (elapsed_ms() - start)}


{if true, allow KL_sum_at_s_to_height}
{when true, use KL_sum_at_s_to_height; when false, truncate the full KL_sum_at_s.
 The height condition says the span HT-height(p) to be covered is small next to GAM(p),
 i.e. truncation is preferred for SMALL gamma and LARGE height, to_ht otherwise.  The
 x.number condition is a separate restriction to large x; drop_x_char_gate removes it, so
 the criterion rests on gamma and height alone.}
set drop_x_char_gate = false

set low_diff_char_old(Param p, int HT) = bool: {false {ALWAYS use KL_sum_at_s}}
    if (HT < 0) then return  false fi;
    let start = elapsed_ms(), rk = p.real_form.rank
    then ans = (drop_x_char_gate or
    	        p.x.number > diff_KGB_char_frac*KGB_size(p.real_form))
	       and diff_char_mult*rk*(HT-height(p)) < GAM(p)
    in ans next low_diff_char_time +:= (elapsed_ms() - start)

{how to-ht estimate should win by to choose KL_sum_at_s_to_height}
set KL_char_mult = rat:18/1 {4 seems too small E7 spherical; 16 beats 12}

{if true, allow KL_sum_at_s_to_height}
set low_diff_char(Param p, int HT) = bool: {false {ALWAYS use KL_sum_at_s}}
    if low_diff_char_old_flag then return low_diff_char_old(p,HT) fi;
    if (HT < 0) then return  false fi;
    if low_diff_char_def_ht(p,HT) then return true fi;
    if not low_diff_char_def_inf(p,HT) then return false fi;
    let start = elapsed_ms()
    in low_diff_char_mult*red_walls_to_ht_int(p,HT) < red_walls_int(p)\
       next low_diff_char_time +:= (elapsed_ms() - start)

set low_KL_char(Param p, int HT) = bool:
    {prints("we're in low_KL_char at ",p);}
    p.x.number > diff_KGB_char_frac*KGB_size(p.real_form) and
    (let (T,TH) = dual_partial_block_sizes(p,HT) in TH*KL_char_mult < T)
    {KL_predictor_to_ht(p,HT) < KL_predictor(p)}

set quick_frac = rat: 1/6 {1/10: 406 seconds for E7 ht 27} {change from 1/5 8/8/26}

{meant to predict ratio (to_ht time)/u time)}
set low_quick_frac(Param p,int HT) = rat:
    if p.nu.= then return 1/1 fi;
    let preg = translate_param_by(p,p.real_form.two_rho)
    then (LAMreg,,GAMreg) = low(preg)
    in (LAMreg+HT)/(GAMreg - LAMreg)

{true means u_to_ht should REALLY be better; LESS true than low_quick}
set low_quick_def_ht(Param p, int HT) = bool:
    3*low_quick_frac(p, HT) < quick_frac


{true means u should REALLY be better; LESS true than low_quick is false}
set low_quick_def_u(Param p, int HT) = bool:
    low_quick_frac(p, HT) > 3*quick_frac

{true means allow to_ht, so DECREASING quick_frac means less to_ht}
set low_quick(Param p, int HT) = bool:
    {if predictor_flag then 0/0 fi;}
    low_quick_frac(p, HT) < quick_frac

{    let preg = translate_param_by(p,p.real_form.two_rho)
     then (LAMreg,,GAMreg) = low(preg)
     in (LAMreg+HT) < quick_frac*(GAMreg - LAMreg)
}

{How small the to_ht block should be vs orig block for to_ht to be faster}
set quick_char_frac = rat: 1/9

{KL for p works in block fraction [GAMreg LAMreg]. For dual (to_ht), range is [LAMreg+HT,0].
So to_ht fast means GAMreg-LAMreg much bigger than LAMreg+HT.}
set low_quick_char(Param p, int HT) = bool:
    let (LAM,,GAM) = low(p)
    in (LAM+HT) < quick_char_frac*(GAM - LAM)
{    let preg = translate_param_by(p,p.real_form.two_rho) {dropped this 17:00 4.27.26}
    then (LAMreg,,GAMreg) = low(preg)
    in (LAMreg+HT) < quick_char_frac*(GAMreg - LAMreg)}

{Switching to HT -LAM 1/26 didn't work well; adding the small LAM condition is meant to alleviate??}

{bad experiences Jan 26 suggested this version}
set low_lam(Param p, int HT) = bool:
    if HT < 0 then return  false fi;
    {let (LAM, , GAM) = low(p)
    in}  (lam_mult*p.height < GAM(p))

set prefer_red_flag = true {changed 8/4/26, back to false 8/7/26, true 8/13}

set prefer_quick_flag = false {true; changed 6/5/26 evening back 8/8/26}

set prefer_quick_char_flag = false {terrible luck with true on x_open(E7_s)}

set prefer_dual_flag = false {try true again with short_dual_diffs}

set prefer_KL_flag = false
set prefer_KL_char_flag = false {switch to false 8/13/26}

set prefer_diff_flag = false {true used to give true for parameter(E7_s,773,[0,1,1,1,1,1,0]/1,
    [-3,0,0,0,6,-6,0]/2) and HT 327, leading to a very slow is_unitary_to_ht}

set prefer_gamma_flag = false

set prefer_lam_flag = false

{whether to apply test to switcb from is_unitary_to_ht to is_unitary}
set low_flag = true

{whether to apply test to switcb from KL_sum_to_ht to KL_sum}
{ false makes low_char return true throughout, i.e. ALWAYS compute to height.
  Was true, which let low_diff_char promote truncated KL sums to full ones.  On E7_s
  spherical (x_open, lambda = rho) that promotion fired 243720 times and a stored
  KL_sum_at_s was reused only 9 times, so the extra work was never recovered.  Turning it
  off takes that case from 2212sec to 1020sec: character time rises in aggregate
  (475sec of char_to_ht against 91sec of char calcs) but the to_ht UNITARITY tests fall
  from 1748sec to 427sec, because the promotion was inflating the character work done
  inside them, which is billed to to_ht rather than to char calcs.  Reuse of a stored
  KL_sum_at_s also inverts, 9 -> 1717.  Character cost grows with x, so a gain at x_open
  is the case that matters most.
  Worth revisiting whether the gate can be made valuable rather than simply disabled. }
{ REVERTED to true.  Setting it false (always compute to height) helped E7_s spherical
  (2212 -> 1020sec) and the small whole groups E6_s and SO(5,6), but that evidence was
  drawn entirely from x_open and from groups small enough that every x is "large".  On a
  full E7_s run at KGBElt 8001 -- 38% of the way through KGB, hence BELOW the
  diff_KGB_char_frac threshold of x > 10463 -- it costs 769sec of character work against
  175sec, a 4.4x loss: 402451 promotions become 0, and the work moves from 175sec of char
  to 74sec + 695sec of char_to_ht.
  The existing gate already has the right shape: low_diff_char_old uses to_ht only when
  x.number > diff_KGB_char_frac*KGB_size, which is the large-x regime where character
  calculations are dear.  The spherical gain should be recovered by tuning that gate --
  diff_KGB_char_frac or diff_char_mult -- not by disabling it. }
set low_char_flag = true

{
 Decide low_char once per KGB element rather than per parameter.  Measured on E7_s:
 uniformly truncating (low_char_flag false) costs 64.2sec at x in [7990,8010] but only
 988sec at x_open, against 54.0sec and 2243sec for the uniform full-sum default -- so each
 setting wins in one regime.  But MIXING them per parameter is worse than either
 (diff_char_mult:=1/2 gave 3892sec at x_open), which looks like a caching effect: a
 truncated sum cannot serve a later full request nor the reverse, so a per-parameter gate
 leaves neither store warm.  Deciding per x keeps whichever store is being filled warm for
 the whole element.  Large x truncates, small x computes full sums, using the same
 diff_KGB_char_frac boundary the old gate already used. }
set low_char_per_x_flag = true

set TRUELISTht = [(Param,int)]:[]
set TRUELISTu = [(Param,int)]:[]
set TRUELIST = [(Param,int)]: []

set low_def_ht_time = int: 0
set low_def_ht_count = int: 0
{true means form_to_ht REALLY faster than form: LESS true than low}
set low_def_ht(Param p, int HT) = bool:
    if HT < 0 then return false fi;
    let start = elapsed_ms(), ansht = if not low_flag
    then true
    elif prefer_red_flag
    then low_red_def_ht(p,HT)
    elif prefer_quick_flag
    then low_quick_def_ht(p,HT)
    elif prefer_diff_flag
    then low_diff_def_ht(p,HT)
    elif prefer_gamma_flag
    then {strict_}low_gamma(p,HT)
    elif prefer_lam_flag
    then low_lam(p,HT) and low_red(p,HT)
    else {strict_}low_nu(p,HT)
    fi
    in if ansht then TRUELISTht#:=(p,HT) fi;
       ansht next low_def_ht_time +:= elapsed_ms() - start; low_def_ht_count +:= 1

set low_def_u_time = int: 0
set low_def_u_count = int: 0

{true means form REALLY faster than form_to_ht, so truncate u;  LESS true than low is false}
set low_def_u(Param p, int HT) = bool:
    if HT < 0 then return true fi;
    let start=elapsed_ms(), ansu = if prefer_red_flag
    then low_red_def_u(p,HT)
    elif prefer_quick_flag
    then low_quick_def_u(p,HT)
    elif prefer_diff_flag
    then low_diff_def_u(p,HT)
    elif prefer_gamma_flag
    then {strict_}low_gamma(p,HT)
    elif prefer_lam_flag
    then low_lam(p,HT) and low_red(p,HT)
    else {strict_}low_nu(p,HT)
    fi
    in if ansu then TRUELISTu#:=(p,HT) fi;
       ansu next low_def_u_time +:= elapsed_ms() - start; low_def_u_count +:= 1

{if true, allow hermitian_form_irreducible_to_ht; if false, truncate hermitian_form_irreducible}

set low_time = int: 0
set low_count = int: 0

set low(Param p, int HT) = bool:
    if HT < 0 then return false fi;
    {elif predictor_flag then return true {decided elsewhere to try to_ht}}
    let start = elapsed_ms(), ans = if prefer_red_flag
    then low_red(p,HT)
    elif prefer_quick_flag
    then low_quick(p,HT)
    elif prefer_diff_flag
    then low_diff(p,HT)
    elif prefer_gamma_flag
    then {strict_}low_gamma(p,HT)
    elif prefer_lam_flag
    then low_lam(p,HT) and low_red(p,HT)
    else {strict_}low_nu(p,HT)
    fi
    in if ans then TRUELIST#:=(p,HT) fi;
       ans next low_time +:= elapsed_ms() - start; low_count +:= 1

set low_char_time = int: 0
set low_char_count = int: 0

{whether to consider replacing KL_sum_to_ht with KL_sum}
set low_char(Param p, int HT) = bool:
    let start=elapsed_ms() in
    if (HT < 0 or p.x.number < diff_KGB_char_frac*KGB_size(p.real_form)) then return false
    elif not low_char_flag
    then return true {ALWAYS do to_height}
    elif prefer_KL_char_flag
    then low_KL_char(p,HT)
    elif prefer_red_flag
    then low_red_char(p,HT)
    elif prefer_quick_char_flag {false 8/4/26; true 4/29/26}
    then low_quick_char(p,HT)
    elif prefer_diff_flag
    then low_diff_char(p,HT)
    {elif prefer_strict_KL_flag
    then strict_low_KL_char(p,HT)}
    else false{ALWAYS truncate to KL_sum}
    fi next low_char_time +:= elapsed_ms() - start; low_char_count+:=1

set to_ht (KTypePol P,int N) = KTypePol:
  if N<0 then return P fi;
  let (below,)=height_split(P,N) in below

set to_ht(maybe_KTP P,int N) = maybe_KTP:
    if N < 0 then return P fi;
    case P
    | timed_out: timed_out()
    | done(r): done(to_ht(r,N))
    esac

set to_ht_PP (int N) = (ParamPol->ParamPol): (ParamPol P):
  if N < 0 then P
  else let (below,)=height_split(P,N) in below
  fi

set to_ht (int N) = (KTypePol->KTypePol): (KTypePol P):
  if N < 0 then P
  else let (below,)=height_split(P,N) in below
  fi

set KL_new_count = int:0
set KL_false_low_count = int:0

set stored_count = int:0
set unstored_count = int:0

set KL_sum_at_s_to_ht_new(int HT) = (Param p) ParamPol: {should check whether library knows KL_sum_at_s, use that}
    let start = elapsed_ms()
    in if HT < 0
       then KL_sum_at_s(p)
       else let mKLS = stored_KL_sum_at_s(p)
       	    in case mKLS
	       | none: unstored_count+:=1;
       	       	 let ans = KL_sum_at_s_to_height(p,HT)
		 in charTimeToHt +:= elapsed_ms() - start;
		    char_counter_to_ht.use();
		    ans
 	       | some(KLS): stored_count+:=1;
	       	 let (below,) = height_split(KLS,HT)
    	       	 in KL_new_count +:= 1;
		    charTimeToHt +:= elapsed_ms() - start;
		    below
	       esac
       fi

{switch back to true after making invocation depend on low_char}
set KL_sum_to_ht_new_flag = true {false}

{should test that x is pretty big??}
set KL_sum_at_s_to_ht(int HT) = (Param p) ParamPol: 
    let start = elapsed_ms()
    in if HT < 0
       then KL_sum_at_s(p)
       elif low_char(p,HT)
       then KL_sum_at_s_to_ht_new(HT)(p)
       else let (below,) = height_split(KL_sum_at_s(p),HT) {this records char_counter, time?}
    	    in KL_false_low_count+:=1;
	       below
       fi

set KL_new_inter_count = int:0

set KL_sum_at_s_to_ht_new_inter(int HT) = (Param p,int time) maybe_PP:
    let start = elapsed_ms()
    in if  HT < 0
       then char_counter.use();
       	    KL_sum_at_s_to_height(p, -1, time) next charTime+:=elapsed_ms() - start
       else char_counter_to_ht.use();
       	    let mKLS = stored_KL_sum_at_s(p)
       	    in case mKLS
	       | none: unstored_count+:=1;
	       	       KL_sum_at_s_to_height(p,HT,time) next charTimeToHt +:= elapsed_ms() - start
	       | some(KLS): stored_count+:=1;
	       	 	       let (below,) = height_split(KLS,HT)
    	       	 	       in KL_new_count +:= 1;
			       	  charTimeToHt +:= elapsed_ms() - start;
			          below.some
	       esac
        fi next KL_new_inter_count +:=1

{should test that x is pretty big??}
set KL_sum_at_s_to_ht_inter(int HT) = (Param p,int time) maybe_PP:
    let start = elapsed_ms()
    in if low_char(p,HT)
       then KL_sum_at_s_to_ht_new_inter(HT)(p,time) {in "else" HT >= 0, but we're required to truncate}
       else char_counter.use();
       	    let full = KL_sum_at_s_to_height(p,-1,time)
	    in charTime +:= elapsed_ms() -start;
	       case full
	       | none: full
	       | some(ans): truncate_above_height(ans,HT).some
	       esac
       fi

set twisted_KL_sum_at_s(Param p) = ParamPol:
    let start = elapsed_ms()
    in twisted_KL_sum_at_s(p) next charTime +:= elapsed_ms() - start; char_counter.use()


set twisted_KL_sum_at_s_to_ht(int HT) = (Param p) ParamPol:
    if HT < 0 then return twisted_KL_sum_at_s(p)
    else let start = elapsed_ms()
    	 in height_split(twisted_KL_sum_at_s(p),HT).fst \
	    next charTimeToHt +:= elapsed_ms() - start; char_counter_to_ht.use()
    fi

{next two never try not to_ht}
set character_formula_to_height(Param p, int HT) = ParamPol:
    s_to_1(KL_sum_at_s_to_height(p,HT))

set character_formula_to_height (ParamPol P, int HT) = ParamPol:
    map(((Param->ParamPol): (Param p): character_formula_to_height(p, HT)), P)

{these use low_char(p,HT) to decide whether to truncate full char}
set character_formula_to_ht(Param p, int HT) = ParamPol:
    s_to_1(KL_sum_at_s_to_ht(HT)(p))

set character_formula_to_ht (ParamPol P, int HT) = ParamPol:
    map(((Param->ParamPol): (Param p): character_formula_to_ht(p, HT)), P)

{
 Hashed K_type_pol(character_formula_to_ht(p,HT)), modelled on defHashHtTime.  For each
 Param we keep the KTypePol already computed and the greatest height it was computed to, so
 a later call at a SMALLER height truncates the stored answer instead of recomputing.
 KL_sum_at_s_to_ht_new keeps nothing: on a miss it recomputes from scratch every time, so it
 pays a stored_KL_sum_at_s lookup and a second evaluation of low_char per call and still
 repeats the work.
 Storing the K_type_pol rather than the ParamPol is much cheaper in memory, since
 K_type_pol collapses many different ParamPols onto a small number of KTypePols -- and it
 is the form nearly every caller actually wants.  Values are deduplicated through a
 KTypePol hash exactly as defHashHtTime does.
 Truncating a stored height-H answer down to HT is sound: the terms are height-graded, so
 restricting below HT gives what computing directly to HT would.
 The library's own stored full sum is not consulted here; a miss goes through
 character_formula_to_ht, which reaches stored_KL_sum_at_s downstream anyway.
 Access is behind KT_char_hash_flag so it can be measured against the current code.
}
set KT_char_hash_flag = false

set KT_char_hit = int:0    {answered by truncating a stored KTypePol}
set KT_char_miss = int:0   {had to be computed}

set KT_char_params = make_Param_hash()
set KT_char_pols = make_KTypePol_hash()
set KT_char_loc = vec: []  {jth entry: location in KT_char_pols of the answer for Param #j}
set KT_char_hts = vec: []  {jth entry: greatest height Param #j has been computed to}

{
 Repeated calls for one p almost always ask for an INCREASING sequence of heights, so a
 cache keyed on "already computed to at least HT" would never be consulted: every call
 would miss, store, and be superseded.  The hash only earns its keep if something computes
 AHEAD of what is asked.  Hence this form: compute to HTup, store that, and return the
 truncation to HT.  A caller that knows it will later want the bigger of two heights should
 pass it as HTup and take the smaller answer now.  That trade is favourable because the
 cost of character_formula_to_height grows more slowly with height than is_unitary_to_ht
 does, so a little unnecessary character work buys a later hit cheaply.
}
set char_to_ht_hashed(Param p, int HT, int HTup) = KTypePol:
    if HT < 0 then return K_type_pol(character_formula(p)) fi;
    let top = max(HT,HTup)
    then I = KT_char_params.size()
    then j = KT_char_params.match(p)
    in if j < I and KT_char_hts[j] >= HT
       then KT_char_hit +:= 1;
       	    to_ht(KT_char_pols.index(KT_char_loc[j]),HT)
       else KT_char_miss +:= 1;
       	    let ans = K_type_pol(character_formula_to_ht(p,top))
	    then m = KT_char_pols.match(ans)
	    in if j = I
	       then KT_char_loc #:= m; KT_char_hts #:= top
	       else KT_char_loc[j] := m; KT_char_hts[j] := top
	       fi;
	       to_ht(ans,HT)
       fi

{how much higher than asked to compute, when the caller gives no better height}
set KT_char_ahead = int: 0

set char_to_ht_hashed(Param p, int HT) = KTypePol:
    char_to_ht_hashed(p,HT,HT+KT_char_ahead)

set clear_char_to_ht_hash() = void:
    KT_char_params.clear(); KT_char_pols.clear();
    KT_char_loc := (vec: []); KT_char_hts := (vec: []);
    KT_char_hit := 0; KT_char_miss := 0

set report_char_to_ht_hash() = void:
    prints("char_to_ht_hash: ",KT_char_hit," from hash, ",KT_char_miss," computed; ",
    	   KT_char_params.size()," Params, ",KT_char_pols.size()," KTypePols")


{ ------------------------------------------------------------------- }

{ composition series }

set composition_series_old(ParamPol P) = ParamPol:
  null_module(P)+
  while !=P { non null module }
  do let (coef,p):term=first_term(P) in P -:= coef*character_formula(p); term
  od

set composition_series_old (Param p) = ParamPol: composition_series_old(ParamPol: p)

set composition_series_to_height_old(ParamPol P, int HT) = ParamPol:
  if HT.< then return composition_series_old(P) fi;
  let (PHT,) = height_split(P,HT)
  in null_module(P)+
  while !=PHT { non null module }
  do let (coef,p):term=first_term(PHT)
     in PHT -:= coef*character_formula_to_ht(p,HT)
     ; term
  od

set composition_series_to_height_old (Param p,int HT) = ParamPol:
    composition_series_to_height_old(ParamPol: p, HT)

set composition_series(Param p) = ParamPol:
    let (B,m,M,polys) = dual_KL_block(p) {lower triangular; jth col is mult in stds of B[j]}
    in sum(p.real_form,for q@j in B[:m+1] do eval(polys[M[m,j]],1)*q od)

set composition_series(ParamPol P) = ParamPol:
    sum(P.real_form, for c@q in P do c*composition_series(q) od)

set composition_series_to_height(Param p, int HT) = ParamPol:
    if HT < 0 then return composition_series(p) fi;
    let (B,m,M,polys) = dual_KL_block(p) {lower triangular; jth col is mult in stds of B[j]}
    in sum(p.real_form, for q@j in B[:m+1] do if height(q) <= HT then eval(polys[M[m,j]],1)*q else 0*q fi od)

set composition_series_to_height (ParamPol P,int HT) = ParamPol:
    sum(P.real_form, for c@q in P do c*composition_series_to_height(q, HT) od)

set CSB_KGB_char_frac = 9/10
set CSB_frac = 1/8
set lowCSB_time = int:0
set CS_time = int:0

set lowCSB(Param p, int HT) = bool:
    if (HT < 0) then return  false fi;
    let start = elapsed_ms()
    then ans = p.x.number > CSB_KGB_char_frac*KGB_size(p.real_form)
	       and (HT < CSB_frac*GAM(p)) {forces LAM < CSB_frac*GAM}
    in lowCSB_time +:= (elapsed_ms() - start);
       ans

set composition_series_to_ht(ParamPol P, int HT) = ParamPol:
  if HT.< then return composition_series(P) fi;
  P:=to_ht_PP(HT)(P);
  if #P = 0 then return P fi;
  let p0 = first_param(P), start = elapsed_ms()
  in if not lowCSB(p0,HT)
     then to_ht_PP(HT)(composition_series(P))
     else null_module(P) +
     	  while !=P { non null module }
  	  do let (coef,p):term=first_term(P)
     	  in P -:= coef*character_formula_to_ht(p,HT)
     	  ; term
  	  od next CS_time +:= elapsed_ms() - start
     fi
set composition_series_to_ht (Param p,int H) = ParamPol: composition_series_to_ht(ParamPol: p, H)


set tabulate_at_1 ([Param] block, (Param->ParamPol) f) = mat:
  for y in block { y determines a column of the result }
  do let fy=f(y) in for x in block do fy[x].s_to_1 od
  od

set signed_KL_mat_at_1(Param p) = mat:
  tabulate_at_1(partial_block(p), character_formula@Param)

set KL_inverse_mat_at_1(Param p) = mat:
  tabulate_at_1(partial_block(p), composition_series@Param)

{ versions that do the whole block rather than a partial block }
set full_signed_KL_mat_at_1(Param p) = mat:
  tabulate_at_1(block_of(p),character_formula@Param)
set full_KL_inverse_mat_at_1(Param p) = mat:
  tabulate_at_1(block_of(p),composition_series@Param)


set print_formatted (ParamPol P) = void:
  for w@p in P do prints(split_factor_format(w),"*",p) od

set print_character_formula (Param p) = void:
  print_formatted(character_formula(p))

set print_composition_series(Param p) = void:
  print_formatted(composition_series(p))

set print_with_length (ParamPol P) = void:
  for c@p in P do prints(c.split_factor_format, "*"  , p, " ", p.length) od

{ print out high length terms as they become available }
set composition_series_verbose (ParamPol P) = ParamPol:
   let result=null_module(P), max=max(for p in monomials(P) do length(p) od)
in for L:max+1 ~ { reverse }
   do prints("Length: ", L)
   ;  let result_new=null_module(P)
   in for c@p in P
      do if length(p)=L then result_new +:=c*composition_series(p) fi
      od
   ;  result := result+result_new
   ;  prints("terms in result of length ", L, ":")
   ;  for c@p in result
      do if length(p)=L
         then prints(c.split_factor_format, "*",p, " ", p.length)
	 fi
      od
   od ; prints("result:"); print_with_length(result); result

{ simpler and faster: trace progress while computing |composition_series| }
set composition_series_trace (ParamPol P) = ParamPol:
  null_module(P)+
  while !=P { non null module }
  do let (coef,p):term=first_term(P)
  in P -:= coef*character_formula(p)
  ; prints(coef.int_part,"*",p," [",height(p),"]") { coefficients are integer }
  ; term
  od
