< coherent {for Cayley_sum}
< extended_misc {for cross}
< translate {for translate_param_by}
< hash {for hash tables}
< W_reps {for taus(Weyl group rep)}
< associated_variety_annihilator {for GK_dim}
< time.at {for print_time_string}

{Goal is to compute the special representation sigma(p) of the
integral Weyl group W_int(p) attached to a Param p}

{Move the param out where W_int(p)  can act}
set regularize_new(Param p) = Param:
    let gamma = p.infinitesimal_character, rd = p.root_datum
    then shift = sum(#gamma, for av@j in rd.simple_coroots
    	       	     if (av*gamma).=
		     do rd.fundamental_weights[j]
		     fi
		     od).numer
    in translate_param_by (p, shift)

set regularize_new_flag = true

{Move the param out where W_int(p)  can act}
set regularize(Param p) = Param:
    if regularize_new_flag
    then regularize_new(p)
    else translate_param_by (p, p.root_datum.two_rho)
    fi

set Cayley_cross_sum(int j, Param p) = ParamPol:
    let q = Cayley(j,p)
    in if q = p
       then if {is_complex(j,p.x) This is wrong: refers to G-simple root #j, not integ datum}
       	       ((status(j,p)%4).=)
	    then 1*cross(j,p) {genuine complex cross}
	    else 0*p
	    fi
        else {now genuine Cayley} q + cross(j,q)
       	fi

{all these guys have the SAME sigma}
set Talphabetas_old(Param p) = [Param]:
    let q = if is_regular(p.root_datum,p.infinitesimal_character)
    	    then p
	    else regularize(p)
	    fi, G = p.real_form
    then gamma = q.infinitesimal_character, empty = null_module(G), tau = tau(q)
    then R = integrality_datum(G, gamma)
    then S = R.simple_roots
    then P1 = sum(G, for j:#S {was Cayley_sum(j,q)}
    	      	     do Cayley_cross_sum(j,q)
		     od)
    in for @t in P1
       if not is_subset(tau(t), tau(q)) and
       	  not is_subset(tau(q), tau(t))
       do t
       fi
       od

{all these guys have the SAME sigma}
set Talphabetas = (Param -> [Param]):
    let pHash = make_Param_hash()
    then TabHash = make_Param_hash()
    then answers = [vec]: [] {vec #j is list of entries in TabHash for Tab(entry j in pHash)}
    in (Param -> [Param]): (Param p):
    let q = if is_regular(p.root_datum,p.infinitesimal_character)
    	    then p
	    else regularize(p)
	    fi, G = p.real_form
    then N = pHash.size()
    then n = pHash.match(q)
    in if n = N
       then let gamma = q.infinitesimal_character, empty = null_module(G), tau = tau(q)
       	    then R = integrality_datum(G, gamma)
    	    then S = R.simple_roots
    	    then P1 = (sum(G, for j:#S
    	      	      	     do Cayley_cross_sum(j,q)
		     	     od))
	    in answers #:= (vec: for @t in P1
       	    	     if not is_subset(tau(t), tau(q)) and
       	  	     	not is_subset(tau(q), tau(t))
       		     do TabHash.match(t)
		     fi
		     od)
       fi;
       assert(@:pHash.size() = #answers,"Talphabetas is damaged");
       for j in answers[n] do TabHash.index(j) od
       {regroup(p.real_form,TabHash.index(j)) od}

set TalphabetaRepeat_time = int:0
set TalphabetaRepeat_count = int:0

{gives all Param's accessible from p by T_{alpha,beta}}
{for each q in this list, sigma(p) contains sign of W_{tau(q)}, AND
sigma contains trivial of W_(complement of tau(q)). Want to list all
special sigma with those two properties.}
{This function ran in a few minutes on my laptop for a
discrete series of E8_s}
set TalphabetaRepeat(Param p) = [Param]:
    TalphabetaRepeat_count+:=1;
    let start = elapsed_ms(), q = regularize(p), G = p.real_form
    then nullmod = null_module(G)
    then gamma = q.infinitesimal_character, toDo = ParamPol: 1*q
    then pHash = make_Param_hash() {will hold answer}
    then () = while #toDo > 0
	      do {first record toDo's in pHash}
	      	 for @r in toDo
	      	 do pHash.match(r)
		 od; {next compute all their Talphabeta}
	      	 toDo := sum(G, for @r in toDo
	      	  	    	do sum(G, for t in Talphabetas(r) do 1*t od)
				od); {next step eliminate already handled from toDo}
		 toDo := sum(G, for @r in toDo
		      	 	do let j = pHash.lookup(r)
				   in if j < 0
				      then 1*r
				      else nullmod
				      fi
				od)
              od
    in pHash.list() next TalphabetaRepeat_time+:=elapsed_ms() - start

set pHashOut = make_Param_hash()

{jth term is all Param's accessible from p by <=j T_{alpha,beta}'s}
{seek a result of size N + 1 >= 1}
set TalphabetaRepeats(Param p, int N) = [[Param]]:
    let q = regularize(p), G = p.real_form
    then nullmod = null_module(G)
    then gamma = q.infinitesimal_character, toDo = 1*q
    then () = pHashOut.clear()
    {
    then pHash = make_Param_hash() {will hold answer.##; always things where Talphabeta
    	       	 		      already computed}}
    then answer = [[Param]]:[]
    then size = int:0
    in while #toDo > 0 and #answer < N
       do for @r in toDo
	  do pHashOut.match(r)
	  od;
	  size:= pHashOut.size();
	  answer #:= pHashOut.list();
	  toDo := sum(G, for @r in toDo
	      	  	 do sum(G, for t in Talphabetas(r)
				   do let j = pHashOut.match(t)
				      in if j >=size
					 then 1*t
					 else nullmod
					 fi
				   od)
			  od)
        od;
    	answer#pHashOut.list()


{jth term is all Param's accessible from p by <=j T_{alpha,beta}'s}
set TalphabetaRepeats(Param p) = [[Param]]:
    let q = regularize(p), G = p.real_form
    then nullmod = null_module(G)
    then gamma = q.infinitesimal_character, toDo = 1*q
    {
    then pHash = make_Param_hash() {will hold answer.##; always things where Talphabeta
    	       	 		      already computed}
    }
    then () = pHashOut.clear()
    then answer = [[Param]]:[]
    then size = int:0
    in while #toDo > 0
       do for @r in toDo
	  do pHashOut.match(r)
	  od;
	  size:= pHashOut.size();
	  answer #:= pHashOut.list();
	  toDo := sum(G, for @r in toDo
	      	  	 do sum(G, for t in Talphabetas(r)
				   do let j = pHashOut.match(t)
				      in if j >=size
					 then 1*t
					 else nullmod
					 fi
				   od)
			  od)
        od;
    	answer#pHashOut.list()

{all distinct tau invariants reachable by T_{alpha,beta}'s from p}

set TalphabetaTaus(Param p) = [vec]:
    for q in TalphabetaRepeat(p) do tau(q) od.sort_u_lex


{previous made into a big_int bitset (largest possible size (2^(semisimple_rank(integrality_datum)))}

set TalphabetaTaus_bitset(Param p) = [int]:
    for tau in TalphabetaTaus(p) do to_bitset(tau) od

{jth term is all tau invariants found in <= j T_{alpha,beta}'s from p}
set TalphabetaTauss(Param p,int N) = [[vec]]:
    for list in TalphabetaRepeats(p,N) do for q in list do tau(q) od.sort_u_lex od

{jth term is all tau invariants found in <= j T_{alpha,beta}'s from p}
set TalphabetaTauss(Param p) = [[vec]]:
    for list in TalphabetaRepeats(p) do for q in list do tau(q) od.sort_u_lex od

{Tauss made into a list of of length at most N+1 of big_int bitsets}
set TalphabetaTauss_bitset(Param p,int N) = [int]:
    let answer = for list in TalphabetaTauss(p,N)
    	       	 do to_bitset(for tau in list
		    	      do to_bitset(tau)
			      od)
		 od
    then len = first(for N in answer do N=answer~[0] od)
    in answer[:len+1]

{Tauss made into a list of big_int bitsets}
set TalphabetaTauss_bitset(Param p) = [int]:
    let answer = for list in TalphabetaTauss(p)
    	       	 do to_bitset(for tau in list
		    	      do to_bitset(tau)
			      od)
		 od
    then len = first(for N in answer do N=answer~[0] od)
    in answer[:len+1]


{If N is TalphabetaTaus_bitset(q), then this is a necessary condition for p and q to have
the same primitive ideal}

set same_PI(Param p, [int] Taus_bitset) = bool:
    TalphabetaTaus_bitset(p) = Taus_bitset


{If Ns is TalphabetaTauss_bitset(q), then this is a necessary condition for p and q to have
the same primitive ideal; need N >= 1.}
set same_PI_step(Param p, [int] Tauss_bit, int N) = bool:
    if to_bitset([to_bitset(tau(p))]) != Tauss_bit[0] then return false fi;
    let q = regularize(p), G = p.real_form, step = int:0, pHash = make_Param_hash()
    then test = int:0
    then gamma = q.infinitesimal_character, toDo = 1*q, nullmod = null_module(G), size = int:0
    in while #toDo > 0 and step < N
       do for @r in toDo
	  do pHash.match(r)
	  od;
	  size:=pHash.size();
	  test:=to_bitset(for r in pHash.list() do to_bitset(tau(r)) od );
	  {prints("at step = ",step,", test = ",test, ", Tauss_bit = ",
	  	      Tauss_bit[min(step,#Tauss_bit - 1)]);}
	  if test != Tauss_bit[min(step,#Tauss_bit - 1)]
	  then return false
	  fi;
	  toDo := sum(G, for @r in toDo
	      	  	 do sum(G, for t in Talphabetas(r)
				   do let j = pHash.match(t)
				      in if j>= size
				      	 then 1*t
					 else nullmod
					 fi
				   od)
			 od);
	  step +:=1
       od;
       test:=to_bitset(for r in pHash.list() do to_bitset(tau(r)) od );
       {prints("After while, step = ",step, ", #toDo = ",#toDo,", test = ",test,", #Tauss_bit = ",
       #Tauss_bit);}
       step <= #Tauss_bit and test = Tauss_bit[min(step, #Tauss_bit -1)]

{If Ns is TalphabetaTauss_bitset(q), then this is a necessary condition for p and q to have
the same primitive ideal.}
set same_PI_step(Param p, [int] Tauss_bit) = bool:
    if to_bitset([to_bitset(tau(p))]) != Tauss_bit[0] then return false fi;
    let q = regularize(p), G = p.real_form, step = int:0, pHash = make_Param_hash()
    then test = int:0
    then gamma = q.infinitesimal_character, toDo = 1*q, nullmod = null_module(G), size = int:0
    in while #toDo > 0
       do for @r in toDo
	  do pHash.match(r)
	  od;
	  size:=pHash.size();
	  test:=to_bitset(for r in pHash.list() do to_bitset(tau(r)) od );
	  {prints("at step = ",step,", test = ",test, ", Tauss_bit = ",
	  	      Tauss_bit[min(step,#Tauss_bit -1)]);}
	  if test != Tauss_bit[min(step,#Tauss_bit -1)]
	  then return false
	  fi;
	  toDo := sum(G, for @r in toDo
	      	  	 do sum(G, for t in Talphabetas(r)
				   do let j = pHash.match(t)
				      in if j>= size
				      	 then 1*t
					 else nullmod
					 fi
				   od)
			 od);
	  step +:=1
       od;
       {prints("After while, step = ",step, ", #Tauss_bit = ",#Tauss_bit);}
       step >= #Tauss_bit and
       to_bitset(for r in pHash.list() do to_bitset(tau(r)) od) =
       Tauss_bit~[0]

{lists the numbers AMONG SPECIAL REPS of the special W reps that admit all the taus
in Talphabetataus(p)}

set cand_sigmas(Param p) = [int]:
    let rd = integrality_datum(p)
    then special_tauss_bitsets = special_taus_bitsets(rd)
    then M = to_bitset(TalphabetaTaus_bitset(p)) {now test if M \subset N}
    in for N@i in special_tauss_bitsets if AND(M,N) = M do i fi od

{meant to hold Param's for which #js > 1}
set badTab_hash = make_Param_hash()

set GK_dim_new(Param p) = int:
    let js = cand_sigmas(p), CT = character_table(integrality_datum(p))
    then special_inds = for j:#CT.characters if is_special_representation(CT,j) do j fi od
    in if #js =	1
       then #posroots(p.root_datum) - CT.generic_degree(special_inds[js[0]])
       else badTab_hash.match(p); prints("Sorry, had to revert; p =",p); GK_dim(p)
       fi

{#posroots of Levi defined by dual tau invariant to S; a lower bound for GK_codim of dual}
set dualcodim(RootDatum rd, [int] S) = int:
    let T = complement(rd.semisimple_rank,S)
    in nr_of_posroots(Levi_datum(rd,T))

{check whether a set of tau invariants can correspond to a dual orbit of codim D}
{S0 is the target tau invariant, the set of singular simple for the infl char}
set allowed(RootDatum rd, [[int]] taus, [int] S0) = bool:
    let D0 = dualcodim(rd,S0), CT = character_table(rd), rk = rd.semisimple_rank
    then S0c = complement(rk,S0)
    then r0 = truncate_induce_sign(CT,S0c)
    in all(for S in taus
       	   do @bool: let D1 = dualcodim(rd,S)
	      	     in D1 < D0
		     	or D1 = D0 and truncate_induce_sign(CT,complement(rk,S)) = r0
	   od)

set testArthur(Param p, [int] S0) = bool:
    tau(p) = S0 and allowed(p.integrality_datum,TalphabetaTaus(p),S0)

set ideal_intList_hash = make_int_list_hash()

{tests whether  TalphabetaTauss_bitset to N really distinguished primitive ideals}
set test_faster_packets(RootDatum rd, int N) = bool:
    let start = elapsed_ms(), G = split_form(rd)
    then B = block_of(G.trivial)
    then PInum = num_prim_ideals(character_table(rd))
    then freq = min(#B\10 + 1,1000)
    in ideal_intList_hash.clear();
       for p@j in B
       do if (j%freq).=
       	  then prints("at block elt ",j," out of ",#B," at time ",
	  print_time_string(elapsed_ms() -start),"; so far ",ideal_intList_hash.size(),
	       " out of ",PInum," different prim ideals")
	  fi;
	  ideal_intList_hash.match(TalphabetaTauss_bitset (p, N))
       od;
       prints("Total time = ",print_time_string(elapsed_ms() -start),
       	      " to distinguish ",ideal_intList_hash.size(), " prim ideals to level ",N);
       PInum = ideal_intList_hash.size()

{tests whether  TalphabetaTauss_bitset really distinguished primitive ideals}
set test_faster_packets(RootDatum rd) = bool:
    let start = elapsed_ms(), G = split_form(rd)
    then B = block_of(G.trivial)
    then PInum = num_prim_ideals(character_table(rd))
    then freq = min(#B\10 + 1,1000)
    in ideal_intList_hash.clear();
       for p@j in B
       do if (j%freq).=
       	  then prints("at block elt ",j," out of ",#B," at time ",
	  print_time_string(elapsed_ms() -start),"; so far ",ideal_intList_hash.size(),
	       " out of ",PInum," different prim ideals")
	  fi;
	  ideal_intList_hash.match(TalphabetaTauss_bitset (p))
       od;
       prints("Total time = ",print_time_string(elapsed_ms() -start),
       	      " to distinguish ",ideal_intList_hash.size(), " prim ideals.");
       PInum = ideal_intList_hash.size()

{Since previous test gave false for Spin(6,6), test whether TalphabetaTauss_bitset distinguishes
primitive ideals in case of distinguished nilpotent}
{E7 tested positive!}

{If preload isn't empty, should be all distinguished unipotent}

set test_faster_distinguished_packets(RootDatum rd, [Param] preload, int N) = bool:
    let start = elapsed_ms(), G = split_form(rd), rd_dual = dual(rd)
    then distHs = for H in distinguished_Hs(rd_dual) ~do H od
    then distps = for H in distHs
    	 	  do parameter(x_open(G),G.rho,H/2)
		  od
    then ST_dual = Springer_table(rd_dual)
    then O_duals = for H in distHs do (rd_dual,(),H) od
    then Os = for O_dual in O_duals do ST_dual.dual_map(O_dual) od
    then () = prints("At time ",print_time_string(elapsed_ms() - start),
    	      	     ", starting computation of target GK_dims.")
    then Dims = for O in Os do dim(O)\2 od
    then () = prints("At time ",print_time_string(elapsed_ms() - start),
    	      	     ", completed computation of target GK_dims.")
    then () = prints("At time ",print_time_string(elapsed_ms() - start),
    	 	  ", starting to compute Tauss_bitset to ",N," for ",#distHs," parameters.")
    then distTauss_bits = for p in distps
    	 		  do  TalphabetaTauss_bitset(p,N)
			  od
    then () = prints("At time ",print_time_string(elapsed_ms() - start),
    	 	  ", completed computing Tauss_bitset to ",N," for ",#distHs," parameters.")
    in all(#distps, (int j) bool:
	   let allH = all_parameters_gamma(G,distHs[j]/2)
	   then actualsH =
	   	if #preload > 0
	   	then for q in preload
		     if q.infinitesimal_character = distHs[j]/2
		     do q
		     fi
		     od
	   	else [Param]:[]
	   	fi
	   in
	   prints("At time ",print_time_string(elapsed_ms() - start),
	   	 " started testing distinguished orbit #",j);
	   prints("need to test ",#allH," candidates");
	   let candsH = for q@k in allH
			 do if same_PI_step(q,distTauss_bits[j],N)
			    then {prints("positive result for cand #",k," of ",#allH);}
			         [q]
			    else []
			    fi
			 od.##
	   then actualsH =
	   	if #preload = 0
	   	then for q in candsH if GK_dim(q) = Dims[j] do q fi od
	   	else actualsH
	   	fi
	   in
	   prints("candsH = ",candsH);
	   prints("actualsH = ",actualsH);
	   if #candsH > #actualsH
	   then prints("for j = ",j," and H = ",distHs[j],", the ",#candsH - #actualsH,
	   	" extra candidates are ",
		       for q in candsH if first(for r in actualsH do q=r od) = -1
		       do q fi od);
		       false
	   elif #candsH < #actualsH
	   then prints("for j = ",j," and H = ",distHs[j],", the ",#actualsH - #candsH,
	   	" missing candidates are ",
		       for q in actualsH if first(for r in candsH do q=r od) = -1
		       do q fi od);
		       false
	   else prints("for j = ",j," and H = ",distHs[j],", identified correctly the ",
	   	#candsH," unipotent representations");
	   true
	   fi) next prints("Finished at ",print_time_string(elapsed_ms() - start))

set test_faster_distinguished_packets(RootDatum rd, [Param] preload) = bool:
    let start = elapsed_ms(), G = split_form(rd), rd_dual = dual(rd)
    then distHs = for H in distinguished_Hs(rd_dual) ~do H od
    then distps = for H in distHs
    	 	  do parameter(x_open(G),G.rho,H/2)
		  od
    then ST_dual = Springer_table(rd_dual)
    then O_duals = for H in distHs do (rd_dual,(),H) od
    then Os = for O_dual in O_duals do ST_dual.dual_map(O_dual) od
    then Dims = for O in Os do dim(O)\2 od
    {then Dims = for  p in distps do GK_dim(p) od}
    then () = prints("At time ",print_time_string(elapsed_ms() - start),
    	 	  ", starting to compute Tauss_bitset for ",#distHs," parameters.")
    then distTauss_bits = for p in distps
    	 		  do  TalphabetaTauss_bitset(p)
			  od
    then () = prints("At time ",print_time_string(elapsed_ms() - start),
    	 	  ", completed computing Tauss_bitset for ",#distHs," parameters.")
    in all(#distps, (int j) bool:
	   prints("At time ",print_time_string(elapsed_ms() - start),
	   	 " started testing distinguished orbit #",j);
	   let allH = all_parameters_gamma(G, distHs[j]/2)
	   then cands = for q in allH
			 if same_PI_step(q,distTauss_bits[j])
			 do q
			 fi
			 od
	   then actuals = if #preload > 0
			   then for q in preload
			   	  if q.infinitesimal_character = distHs[j]/2
				  do q
				  fi
				  od
			   else for q in cands
			   	  if GK_dim(q) = Dims[j]
				  do q
				  fi
				  od
			   fi
	   in if #cands != #actuals
	   then prints("for j = ",j," and H = ",distHs[j],", bad candidates are ",
		       for q in cands if first(for r in actuals do q=r od) = -1
		       do q fi od);
		       false
	   else true
	   fi) next prints("Finished at ",print_time_string(elapsed_ms() - start))

set test_faster_distinguished_packets(RootDatum rd, int N) = bool:
    test_faster_distinguished_packets(rd,[],N)

set test_faster_distinguished_packets(RootDatum rd) = bool:
    test_faster_distinguished_packets(rd,[])