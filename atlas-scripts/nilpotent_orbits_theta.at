<basic.at
<nilpotent_orbits.at
<conjugate.at { for |permuting_transporter| }
<lattice.at { for |in_lattice_subspace_sum| }
<hash.at { for |make_vec_hash| }

{		Component groups of K-orbits of nilpotent elements of p

  nilpotent_orbits.at lists, for a complex nilpotent orbit O=G.e, the conjugacy
  classes of A(O)=G^e/(G^e)^0, following Sommers. This file does the same for a
  K-orbit O_theta=K.e on the nilpotent elements of p, and the group
  A_K(O_theta)=K^e/(K^e)^0. The description of the conjugacy classes is due to
  Salah Mehdi, Pavle Pandzic, David Vogan and Roger Zierau; it is the real
  analogue of Sommers' description.

  Let phi=(H,e,f) be a normal triple (H in k, e and f in p), so that
  A_K(O_theta)=Z_K(phi)/Z_K(phi)^0, and let C=Z_G(phi), a theta-stable reductive
  group with C^theta=Z_K(phi). Let s in Z_K(phi) be semisimple, let S be a
  fundamental (maximally compact) theta-stable maximal torus of Z_C(s)^0, and let
  E=Z_G(sS)^0. Then
   * E is a theta-stable pseudo-Levi subgroup of G (a "real pseudo-Levi" E_R);
   * S=Z(E)^0, s is in Z(E)^theta, and E=Z_G(s Z(E)^0)^0 ("s is regular");
   * e is distinguished in E (Bala-Carter): Z_E(phi)^0=Z(E)^0;
   * S fundamental: (Z(E)^theta)^0 is a maximal torus of Z_K(phi,s)^0.
  The conjugacy class of s in A_K(O_theta) corresponds to the K-conjugacy class
  of the triple (E, s(Z(E)^theta)^0, K_E.e), K_E=E^theta, and every triple with
  these four properties occurs. Dropping the theta's gives Sommers' triple
  (E, s, e) for the class of s in A(O), O=G.e.
  In the notation (E_R,q_theta): E_R is the real form of E defined by theta, and
  q_theta is the theta-stable parabolic of E defined by H, whose open orbit on
  g_2(H) cap p is the orbit K_E.e.

  Implementation. Each triple is K-conjugate to one in which E contains a
  theta-stable Cartan T that is fundamental in E (E has no real roots), and the
  G(R)-conjugacy class of T is determined by the triple. So for each Cartan
  class of G(R) we fix one involution theta of X^*, and list tuples (x,E,H,t):
   x  a KGB element with involution theta; x determines K=K_x
   E  a theta-stable set of roots with no real roots, of the form
      {alpha | <alpha,u> integral} for some theta-fixed torus element exp(2 pi i u)
   H  a theta-fixed coweight, neutral element of a K_E-orbit distinguished in E,
      dominant for a fixed theta-stable positive system of E
   t  a coweight, exp(2 pi i t) in Z(E)^theta and regular, modulo (Z(E)^theta)^0
  Two tuples give K-conjugate triples exactly when some w in W^theta (the
  centralizer of theta in W) carries one to the other (by the cross action on x).
  The K-orbit of e is |real_nilpotent(H,x)|.

  Tests, with l the Levi of H, and dims of complex groups:
   distinguished: dim l_E - dim g_2(H)_E = dim z(E)    (that is dim Z_E(phi))
   K_E.e exists:  dim(l_E cap k) - dim(g_2(H)_E cap p) = dim z(E)^theta
                  (Noel's criterion: the open K_E^H-orbit on g_2(H) cap p has
                  neutral element H; for distinguished e it says Z_{K_E}(phi)^0
                  =(Z(E)^theta)^0)
   S fundamental: with E_K=Z_G(s (Z(E)^theta)^0)^0 (roots integral on t and
                  vanishing on z(E)^theta), dim l_{E_K} - dim g_2(H)_{E_K} = dim z(E).
                  Then Z_{E_K}(phi)^0=Z(E)^0, so Z_K(phi,s,(Z(E)^theta)^0)^0
                  =(Z(E)^theta)^0, and (Z(E)^theta)^0 is a maximal torus of
                  Z_K(phi,s)^0.

  The natural map A_K(O_theta) -> A(O), O=G.e, takes the class of s to the class
  of s in A(O), with Sommers' triple (E,s,e); |complex_component_index| finds
  that class in the list |component_representatives_plus(O)| of nilpotent_orbits.at.

  |K_component_data(RealForm)| uses the E-first algorithm described before
  |involution_fibers| below, which avoids running over W and is meant to work
  up to E8. The first algorithm (|K_component_data_old|, over the whole Weyl
  group, small rank only) is kept for comparison.
}

{ (x,E,H,t) as above; E is a sorted list of positive root indices of G }
set_type KNilpotentComponent = (KGBElt x, [int] E, vec H, ratvec t)

{ sorted positive root indices of the roots (columns) |roots| }
set root_set (RootDatum rd, mat roots) = [int]:
   sort_u(for a in roots do posroot_index(rd,a) od)

{ the root datum (same X^*) of the subsystem E of rd, positive roots those of rd }
set datum_of_root_set (RootDatum rd, [int] E) = RootDatum:
   let flags = for :n_columns(rd.posroots) do false od
   in for i in E do flags[i] := true od; sub_datum(rd,(int i) bool: flags[i])

{ image under w of the subsystem E }
set act (WeylElt w, [int] E) = [int]:
   let rd=w.root_datum in sort_u(for i in E do posroot_index(rd,w*rd.posroots[i]) od)

{ E is theta-stable and has no real roots for theta }
set is_theta_fundamental (RootDatum rd, mat theta, [int] E) = bool:
   all(for i in E
       do let a=rd.posroots[i] then b=theta*a
       in b != -a and find(E,posroot_index(rd,b))>=0
       od)

{ all theta-stable subsystems E with no real roots that are conjugate to
  pseudo-Levi subsystems; |Wlist| is all of W }
set theta_fundamental_pseudo_Levis (RootDatum rd, mat theta, [WeylElt] Wlist) = [[int]]:
   let seen = make_vec_hash(), result = [[int]]: []
   in for L in pseudo_Levi_subgroups(rd)
      do let S = root_set(rd,L.posroots)
      in for w in Wlist
         do let E = act(w,S), N = seen.size()
	 in if seen.match(E)=N and is_theta_fundamental(rd,theta,E)
	    then result #:= E
	    fi
	 od
      od; result

{ The finite group Z(E)^theta/(Z(E)^theta)^0, and (Z(E)^theta)^0.
  A coweight v gives an element exp(2 pi i v) of Z(E)^theta when N*v is
  integral, N the matrix with rows the simple roots of E and the rows of
  ^theta-1. The kernel of N is the Lie algebra of (Z(E)^theta)^0, and
  v -> N*v identifies the finite group with (N Q^n cap Z^m)/N Z^n.
  Returns (representatives, matrix whose columns span Lie((Z(E)^theta)^0)). }
set theta_center (RootDatum rd, mat theta, [int] E) = ([ratvec],mat):
   let n=rd.rank
   then N = mat: ^(datum_of_root_set(rd,E).simple_roots ## (theta-id_mat(n)))
   then (B,d) = Smith(N)
   then gens = for i:#d if d[i]>1 do requisition(solve(N,ratvec:B[i])) fi od
   ,    ords = for i:#d if d[i]>1 do d[i] fi od
   then reps =
      if #gens=0 then [null(n)/1]
      else for c in all_words(ords)
           do let v = null(n)/1 in for g@j in gens do v +:= c[j]*g od; v%1
	   od
      fi
   in (reps,kernel(N))

{ the roots alpha with <alpha,t> integral that vanish on the columns of |K|: the
  roots of Z_G(exp(2 pi i t) S)^0, S the torus with Lie algebra spanned by |K| }
set integral_roots_on (RootDatum rd, ratvec t, mat K) = [int]:
   for a@i in rd.posroots do if is_integer(t*a) and =a*K then [i] else [] fi od.##

{ exp(2 pi i t) is regular: Z_G(exp(2 pi i t) Z(E)^0)^0 = E; |Z| spans Lie Z(E) }
set is_regular (RootDatum rd, [int] E, ratvec t, mat Z) = bool:
   #integral_roots_on(rd,t,Z) = #E

{ columns spanning the Lie algebra of Z(E)^0 }
set center_of_root_set (RootDatum rd, [int] E) = mat:
   kernel(^datum_of_root_set(rd,E).simple_roots)

{ dim Z_E(phi) = dim l - dim g_2(H), computed in E; complex groups }
set centralizer_dim (RootDatum rd, [int] E, vec H) = int:
   let pr=rd.posroots in
   rd.rank + for i in E do let h=H*pr[i] in if h=0 then 2 elif h=2 or h=-2 then -1 else 0 fi od.sum

{ is the orbit with neutral element H distinguished in E? |dz|=dim z(E) }
set is_distinguished (RootDatum rd, [int] E, vec H, int dz) = bool:
   centralizer_dim(rd,E,H) = dz

{ Noel's test that K_E.e exists: dim(l cap k) - dim(g_2(H) cap p) = |dz| (=dim(z(E)^theta)) }
set has_K_E_orbit (KGBElt x, [int] E, vec H, int dz) = bool:
   let rd=x.root_datum, theta=x.involution, cpt=is_compact_imaginary(x)
   then pr=rd.posroots, n=rd.rank
   then dim_t = n_columns(kernel(theta-id_mat(n)))
   then twice_lk = { 2 dim(l cap k) }
      2*dim_t +
      for i in E
      do let a=pr[i] in
         if !=H*a then 0 elif theta*a!=a then 2 elif cpt(a) then 4 else 0 fi
      od.sum
   , twice_g2p = { 2 dim(g_2 cap p), counting roots alpha and -alpha }
      for i in E
      do let a=pr[i] then h=H*a in
         if h!=2 and h!=-2 then 0 elif theta*a!=a then 1 elif cpt(a) then 0 else 2 fi
      od.sum
   in twice_lk-twice_g2p = 2*dz

{ E with a theta-stable positive system: the positive roots of E are those
  positive on x+x*theta, x a generic coweight }
set theta_positive_datum (RootDatum rd, mat theta, [int] E) = RootDatum:
   let pr=rd.posroots, pcr=rd.poscoroots, n=rd.rank
   then M = 1+2*max(0#for i in E do max(0#for c in pr[i]+theta*pr[i] do abs(c) od) od)
   then x = for j:n do M^j od
   then v0 = x+x*theta
   then sg = for i in E do if v0*pr[i]>0 then 1 else -1 fi od
   in root_datum_from_positive(
        (n # for i@k in E do sg[k]*pr[i] od, n # for i@k in E do sg[k]*pcr[i] od)
	,rd.prefers_coroots)

{ theta-fixed coweights H, dominant for the theta-stable positive system of E,
  which are neutral elements of nilpotent orbits of E }
set theta_fixed_neutral_elements (RootDatum rd, mat theta, [int] E) = [vec]:
   if #E=0 then [null(rd.rank)]
   else for O in nilpotent_orbits(theta_positive_datum(rd,theta,E))
        if O.H*theta=O.H do O.H fi
	od
   fi

{ all tuples (x,E,H,t) for the involution theta (unreduced) }
set K_component_tuples (RealForm G, mat theta, [WeylElt] Wlist) = [KNilpotentComponent]:
   let rd=G.root_datum
   then fiber = for x in KGB(G) if x.involution=theta do x fi od
   in for E in theta_fundamental_pseudo_Levis(rd,theta,Wlist)
      do let (reps,Kth) = theta_center(rd,theta,E), Z = center_of_root_set(rd,E)
         then ts = for t in reps if is_regular(rd,E,t,Z) do t fi od
	 , dz = n_columns(Z), dzth = n_columns(Kth)
      in for H in theta_fixed_neutral_elements(rd,theta,E)
         do if not is_distinguished(rd,E,H,dz) then []
	    else let ts_H = { S fundamental, tested in E_K }
	       for t in ts if centralizer_dim(rd,integral_roots_on(rd,t,Kth),H)=dz do t fi od
	    in if #ts_H=0 then []
	       else for x in fiber
	            do if has_K_E_orbit(x,E,H,dzth) then for t in ts_H do (x,E,H,t) od else [] fi
		    od.##
	       fi
	    fi
	 od.##
      od.##

{ do (x1,E1,H1,t1) and (x2,E2,H2,t2) (same involution) give K-conjugate triples? }
set is_equivalent (KNilpotentComponent (x1,E1,H1,t1), KNilpotentComponent (x2,E2,H2,t2),
                   [WeylElt] Wtheta) = bool:
   #E1=#E2 and
   (let rd=x1.root_datum then (,K)=theta_center(rd,x2.involution,E2)
    then in_SE = in_lattice_subspace_sum(id_mat(rd.rank),K)
    in any(for w in Wtheta
           do cross(w,x1)=x2 and H1*inverse(w)=H2 and act(w,E1)=E2
	      and in_SE(t1*inverse(w)-t2)
	   od))

{ the first algorithm, kept for comparison (runs over W; small rank only):
  for each orbit in |real_nilpotent_orbits(G)|, a list of KNilpotentComponents,
  one for each conjugacy class }
set K_component_data_old (RealForm G) = [(RealNilpotent,[KNilpotentComponent])]:
   let rd=G.root_datum, Wall=W(G.root_datum), orbits=real_nilpotent_orbits(G)
   then classes = for :#orbits do [KNilpotentComponent]:[] od
   in for c:nr_of_Cartan_classes(G)
      do let theta=involution(Cartan_class(G,c))
         then Wtheta = for w in Wall if matrix(w)*theta=theta*matrix(w) do w fi od
      in for tup in K_component_tuples(G,theta,Wall)
         do let (x,,H,)=tup then j=find_conjugate(orbits,real_nilpotent(H,x))
	 in assert(j>=0,"K-orbit of tuple not found");
	    if none(for c in classes[j]
	            do c.x.involution=theta and is_equivalent(c,tup,Wtheta)
		    od)
	    then classes[j] #:= tup
	    fi
	 od
      od; for O@j in orbits do (O,classes[j]) od

{ the order of the class of s=exp(2 pi i t) in A_K(O_theta): the least n with s^n in
  (Z(E)^theta)^0, that is, n*t in X_* + Lie((Z(E)^theta)^0) (a coweight plus a theta-fixed
  vector vanishing on the roots of E). Since (Z(E)^theta)^0 is in Z_K(phi)^0, the class order
  divides this n; the order of its image in A(O) divides the class order. }
set component_order (KNilpotentComponent (x,E,,t)) = int:
   let rd=x.root_datum then (,K) = theta_center(rd,x.involution,E)
   then in_SE = in_lattice_subspace_sum(id_mat(rd.rank),K), n=1
   in while not in_SE(n*t) do n+:=1 od; n

{ ------------------------------------------------------------------------------
  The E-first algorithm, for groups up to E8.

  Every class has a representative tuple (x,E0,H,t) with E0 one of the standard
  pseudo-Levi subsystems |pseudo_Levi_subgroups(rd)|, with simple roots Pi0 and
  positive roots P0, and
   (N1) theta=x.involution permutes Pi0,
   (N2) H is dominant for P0.
  (Conjugate E to E0. Then theta preserves E0 and E0 has no real roots, so E0 has a
  theta-stable positive system for which H is dominant: the roots positive on H,
  and on the roots vanishing on H the positive system of a generic theta-fixed
  vector. Some w in W_E0 carries it to P0; w fixes E0, and fixes t modulo X_*.)

  Two normalized tuples are equivalent exactly when they are related by
   * Omega={w in W | w*Pi0=Pi0}, generated by the reflections in the roots
     orthogonal to E0 (these generate the pointwise stabilizer of span(Pi0), by
     Steinberg's theorem) and one lift of each diagram automorphism of Pi0
     realized in W; and
   * W_{L_H}^theta, acting on x alone, L_H the Levi of H in E0: its generators
     are the longest elements of the theta-orbits on the simple roots of L_H
     (s_b; s_b s_b' for b orthogonal to b'=theta b; s_b s_b' s_b otherwise).
  (If w=u*omega with u in W_E0, omega in Omega carries one normalized tuple to
  another, then u fixes H (both dominant), so u is in W_{L_H}; and theta and
  u*theta*u^-1 both permute Pi0, which forces u=pi(u), pi the diagram
  automorphism of theta: so u is in W_{L_H}^theta and fixes theta.)

  So for each E0: list the KGB involutions theta permuting Pi0; find their Omega-
  orbits; on one theta0 per orbit list the valid (x,H,t); and find the orbits of
  the group generated by Omega and the W_{L_H}^theta on the valid tuples over the
  whole Omega-orbit of theta0 (a breadth-first search; t is compared after moving
  back to theta0). Validity is Omega-invariant, so invalid orbits cost one test.

  The K-orbit of each class is found without |real_nilpotent_orbits(G)|: the
  identity classes (component_order=1) are in bijection with the K-orbits, and
  every other class is compared only with the identity classes having the same
  complex orbit, using |=@(RealNilpotent,RealNilpotent)| (dominant H and the
  KGP element of q(H)), as |real_nilpotent_orbit_KGPs| does. (|is_conjugate_orbit|
  gives the same answers on groups up to E6_s, but takes 15 s per call in E7_s.)
------------------------------------------------------------------------------ }

{ the distinct involutions of KGB(G), as a hash, and the fiber of each. One pass over
  KGB(G), about 15 s for E8_s (if this were ever a bottleneck, the library's own list
  of involutions could be exported). }
set involution_fibers (RealForm G) = (Hash<mat>,[[KGBElt]]):
   let h=make_mat_hash(), fibers=[[KGBElt]]:[]
   in for x in KGB(G)
      do let n=h.size() then i=h.match(x.involution)
      in if i=n then fibers#:=[x] else fibers[i]#:=x fi
      od; (h,fibers)

{ generators of Omega={w in W | w*Pi=Pi}, Pi the simple roots of the subsystem L }
set Omega_generators (RootDatum rd, RootDatum L) = [WeylElt]:
   let Pi = for a in L.simple_roots do root_index(rd,a) od
   in for a in centralizer(rd,L.simple_roots).simple_roots do W_elt_of_reflection(rd,a) od ##
      for f in maps@(RootDatum,[int],[int])(rd,Pi,Pi)
      do if all(for v@i in f do v=i od) then [] { identity }
         else case transporter(rd,Pi,for v in f do Pi[v] od)
              | none: [] | some(,w): [w]
	      esac
	 fi
      od.##

{ indices in |invs| of the involutions theta permuting the simple roots of L }
set normalizing_involutions ([mat] invs, RootDatum rd, RootDatum L) = [int]:
   let tr = two_rho(L), Pi=L.simple_roots
   then Pidx = for a in Pi do root_index(rd,a) od
   in for th@i in invs
      if th*tr=tr and all(for a in th*Pi do find(Pidx,root_index(rd,a))>=0 od) do i fi
      od

{ one element of each orbit on |S0| (indices in |h|) of the group generated by the
  matrices |mats| (pairs (M,M^-1)), acting by conjugation }
set orbit_representatives (Hash<mat> h, [int] S0, [(mat,mat)] mats) = [int]:
   let pos=make_int_hash(S0), seen = for :#S0 do false od, reps=[int]:[]
   in for i@k in S0
      do if not seen[k]
         then reps#:=i; seen[k]:=true
	 ;  let queue=[i], q=0
	    in while q<#queue
	       do let th=h.index(queue[q]) in q+:=1
	       ;  for (M,Mi) in mats
	          do let j=lookup(h)(M*th*Mi) then kk=lookup(pos)(j)
		  in assert(kk>=0,"conjugate involution not normalizing")
		  ;  if not seen[kk] then seen[kk]:=true; queue#:=j fi
		  od
	       od
	 fi
      od; reps

{ generators of W_{L_H}^theta: longest elements of the theta-orbits on the simple roots
  of Pi (columns) vanishing on H }
set folded_generators (RootDatum rd, mat Pi, mat theta, vec H) = [WeylElt]:
   let J = for a in Pi if =H*a do root_index(rd,a) fi od
   then refl(int a) = WeylElt: W_elt_of_reflection(rd,a)
   in for a@k in J
      do let l=find(J,root_index(rd,theta*root(rd,a))) in
         assert(l>=0,"theta does not permute the simple roots of L_H");
	 if l=k then [refl(a)]
	 elif l<k then []
	 elif =coroot(rd,a)*root(rd,J[l]) then [refl(a)*refl(J[l])]
	 else [refl(a)*refl(J[l])*refl(a)]
	 fi
      od.##

{ the classes (x,E,H,t), E the roots of L, over the Omega-orbit of the involution
  number |i|; |dist| lists the dominant distinguished neutral elements of L }
set orbit_classes (RootDatum rd, RootDatum L, [vec] dist, [WeylElt] gens,
                   Hash<mat> h, [[KGBElt]] fibers, int i) = [KNilpotentComponent]:
   let E = root_set(rd,L.posroots), Pi=L.simple_roots, theta0=h.index(i)
   then Z = center_of_root_set(rd,E), (reps0,K0) = theta_center(rd,theta0,E)
   then dz = n_columns(Z), dzth = n_columns(K0)
   ,    in_SE0 = in_lattice_subspace_sum(id_mat(rd.rank),K0)
   then canon(ratvec t) = int: first(for r in reps0 do in_SE0(t-r) od)
   ,    ts = for t in reps0 if is_regular(rd,E,t,Z) do t fi od
   then init =
      for H in dist
      if H*theta0=H
      do let ts_H = for t in ts if centralizer_dim(rd,integral_roots_on(rd,t,K0),H)=dz do t fi od
         in if #ts_H=0 then []
	    else for x in fibers[i] if has_K_E_orbit(x,E,H,dzth) do for t in ts_H do (x,H,t) od fi od.##
	    fi
      fi od.##
   in if #init=0 then [] else
   let thetas = make_int_hash([i]), taus = [id_W(rd)] { involution(tau.x0)=that of x }
   , fold_keys = make_vec_hash(), folds = [[WeylElt]]:[]
   , states = make_vec_hash(), data = [(KGBElt,vec,ratvec,int)]:[] { int: index in taus }
   , classes = [KNilpotentComponent]:[]
   then tau_index (KGBElt x, WeylElt w_from) = int: { w_from: tau of the predecessor, times w }
           let j=lookup(h)(x.involution), n=thetas.size() then k=thetas.match(j)
	   in if k=n then taus#:=w_from fi; k
   , fold (int k, vec H) = [WeylElt]:
           let n=fold_keys.size() then m=fold_keys.match(k#H) in
	   if m=n then folds#:=folded_generators(rd,Pi,h.index(thetas.index(k)),H) fi; folds[m]
   then add (KGBElt x, vec H, ratvec t, int k) = void:
           let n=states.size() in
	   if states.match((#x)#H#canon(t*taus[k]))=n then data#:=(x,H,t,k) fi
   in for (x,H,t) in init
      do let q=states.size() in add(x,H,t,0)
      ;  if q<states.size() { new class }
         then classes#:=(x,E,H,t)
	 ;  while q<#data
	    do let (y,K,s,k)=data[q] in q+:=1
	    ;  for w in gens
	       do let y2=cross(w,y) in add(y2,K*inverse(w),s*inverse(w),tau_index(y2,w*taus[k]))
	       od
	    ;  for u in fold(k,K) do add(cross(u,y),K,s,k) od
	    od
	 fi
      od; classes
   fi

{ all classes for G, from all standard pseudo-Levis }
set K_component_classes (RealForm G) = [KNilpotentComponent]:
   let rd=G.root_datum, (h,fibers)=involution_fibers(G)
   then invs=h.list()
   in for L in pseudo_Levi_subgroups(rd)
      do let E=root_set(rd,L.posroots) then dz=n_columns(center_of_root_set(rd,E))
         then dist = if #E=0 then [null(rd.rank)]
	             else for O in nilpotent_orbits(L) if is_distinguished(rd,E,O.H,dz) do O.H fi od
		     fi
	 , gens = Omega_generators(rd,L)
	 then mats = for w in gens do (matrix(w),matrix(inverse(w))) od
      in for i in orbit_representatives(h,normalizing_involutions(invs,rd,L),mats)
         do orbit_classes(rd,L,dist,gens,h,fibers,i)
	 od.##
      od.##

{ the conjugacy classes of A_K(O_theta) for every K-orbit O_theta of G: a list of
  (O,classes), one for each K-orbit O, sorted by dimension; the first class of each
  list is the identity }
set K_component_data (RealForm G) = [(RealNilpotent,[KNilpotentComponent])]:
   let rd=G.root_datum, cl=K_component_classes(G)
   then ids = for c in cl if component_order(c)=1 do c fi od
   then orbits = for (x,,H,) in ids do make_dominant_H(real_nilpotent(H,x)) od
   then doms = for O in orbits do O.H od
   then groups = for c in ids do [c] od
   in for c in cl
      do if component_order(c)!=1
         then let (x,,H,)=c then d=dominant(H,rd)
	    then cand = for j:#orbits if doms[j]=d do j fi od
	    then j = if #cand=1 then cand[0]
	             else let O=real_nilpotent(H,x)
		     in cand[first(for j in cand do orbits[j]=O od)]
		     fi
	    in groups[j]#:=c
	 fi
      od;
      let dims = for O in orbits do O.dimension od
   in for d in sort_u(dims) do for j:#orbits if dims[j]=d do (orbits[j],groups[j]) fi od od.##

set K_component_data (RealNilpotent O) = [KNilpotentComponent]:
   let data=K_component_data(O.real_form), d=dominant(O.H,O.root_datum)
   then j=first(for (P,) in data do P.H=d and P=O od)
   in let (,c)=data[j] in c

{ the class of s=exp(2 pi i t) in A(O), O=G.e, as an index into
  |component_representatives_plus(O)|; -1 if no class (or more than one) matches.
  Drop the theta's: the class is that of Sommers' triple (E,s,e), compared with
  each (M,H_M,v) after conjugating E to M. }
set complex_component_index (KNilpotentComponent (x,E,H,t)) = int:
   let rd=x.root_datum then O=complex_nilpotent(rd,H)
   in if rd.is_abelian then 0
   else
   let reps = component_representatives_plus(O)
   , mamas = for a in datum_of_root_set(rd,E).simple_roots do root_index(rd,a) od
   then matches =
      for (M,H_M,v)@k in reps
      do let papas = for a in M.simple_roots do root_index(rd,a) od
      in if #papas!=#mamas then []
         else case permuting_transporter(rd,mamas,papas)
              | none: []
	      | some(w):
	        let (,Levi_H_M) = Levi_of_coweight(rd,H_M)
		in if dominant(H*inverse(w),M)=dominant(H_M,M) and
		      is_semisimple_element_conjugate_mod_torus
		        (t*inverse(w),v,Levi_H_M,radical_basis(M))
		   then [k] else []
		   fi
	      esac
	 fi
      od.##
   in if #matches=1 then matches[0] else -1 fi
   fi

{ the map on conjugacy classes A_K(O_theta) -> A(O) }
set K_to_complex_component_map (RealNilpotent O) = [int]:
   for c in K_component_data(O) do complex_component_index(c) od

{ printing, parallel to the ComplexNilpotent functions of nilpotent_orbits.at }

{ orders of the conjugacy classes of A_K(O_theta), in the order of K_component_data }
set conjugacy_class_orders ([KNilpotentComponent] cl) = [int]:
   for c in cl do component_order(c) od
set conjugacy_class_orders (RealNilpotent O) = [int]:
   conjugacy_class_orders(K_component_data(O))

set number_conjugacy_classes_component_group (RealNilpotent O) = int:
   #K_component_data(O)
set number_conjugacy_classes_A = (RealNilpotent->int):
   number_conjugacy_classes_component_group@RealNilpotent

{ one orbit, with its classes (from K_component_data) }
set print_component_info (RealNilpotent O, [KNilpotentComponent] cl) = void:
   prints("Component info for K-orbit:",new_line,"H=",O.H," x=",#O.x," diagram:",
          O.complex_orbit.diagram," dim:",O.dimension);
   prints("orders of conj. classes of A_K(O_theta): ",conjugacy_class_orders(cl),
          "; A(O): ",conjugacy_class_orders(O.complex_orbit));
   tabulate(["E","x","H","t","order","A(O)"]#
      for c in cl
      do let (x,E,H,t)=c in
         [datum_of_root_set(O.real_form.root_datum,E).nice_format, (#x).to_string, H.to_string,
          t.to_string, component_order(c).to_string, complex_component_index(c).to_string]
      od)

set print_component_info (RealNilpotent O) = void:
   print_component_info(O,K_component_data(O))

{ all K-orbits of G; computes K_component_data(G) once }
set print_component_info (RealForm G) = void:
   prints("Component groups A_K(O_theta) of K-orbits of nilpotents in p",new_line,"G=",G);
   prints("E: theta-stable pseudo-Levi; x, H: q_theta in E; t: s=exp(2 pi i t);");
   prints("order: of the class; A(O): index of its image in component_representatives_plus(O)");
   for (O,cl)@i in K_component_data(G)
   do prints(new_line,"Orbit #",i); print_component_info(O,cl)
   od

set print_K_component_info = (RealForm->void): print_component_info@RealForm

{ one line per K-orbit: index in real_nilpotent_orbits(G), H, x, diagram, dim, class orders
  of A_K(O_theta) and of A(O) }
set print_component_info_short (RealForm G) = void:
   tabulate(["i","H","x","diag","dim","A_K(O_theta)","A(O)"]#
      for (O,cl)@i in K_component_data(G)
      do [i.to_string,O.H.to_string,(#O.x).to_string,O.complex_orbit.diagram.to_string,
          O.dimension.to_string,conjugacy_class_orders(cl).to_string,
          conjugacy_class_orders(O.complex_orbit).to_string]
      od)

{ real Bala-Carter Levi and real centralizer, from the identity class (x,E,H,t) of A_K(O_theta):
  E is the complex Bala-Carter Levi of e, S=Z(E)^0 is a theta-stable maximal torus of
  C=Z_G(phi)^0, fundamental in C, and (Z(E)^theta)^0 is a maximal torus of Z_K(phi)^0. }

set identity_class ([KNilpotentComponent] cl) = KNilpotentComponent:
   let j=first(for c in cl do component_order(c)=1 od)
   in assert(j>=0,"no identity class"); cl[j]

{ the real form defined by x on the theta-stable subsystem with root datum L }
set real_form_of_subsystem (RootDatum L, KGBElt x) = RealForm:
   let theta=involution(x) in real_form(inner_class(L,theta),theta,torus_factor(x))

{ real Bala-Carter Levi: the Levi E of the identity class (x,E,H,t), with the real form
  defined by x. E is the complex Bala-Carter Levi of e, theta-stable with no real roots;
  E_R is a real Levi subgroup of G, not necessarily the Levi of a theta-stable parabolic. }
set real_Bala_Carter_Levi (KNilpotentComponent (x,E,,)) = RealForm:
   real_form_of_subsystem(datum_of_root_set(x.root_datum,E),x)

{ the real form of C=Z_G(phi)^0 (phi=(H,e,f)), on its fundamental Cartan S=Z(E)^0.
  Roots of C: restrictions beta to S of roots alpha of G, with
  #{alpha|S=beta, <alpha,H>=0} - #{alpha|S=beta, <alpha,H>=2} = 1 (as in nilpotent_centralizer.at).
  An imaginary root beta is compact iff dim(g_{0,beta} cap k) - dim(g_{2,beta} cap p) = 1,
  since ad e maps g_{0,beta} cap k onto g_{2,beta} cap p. }
set centralizer_real_form (KNilpotentComponent (x,E,H,)) = RealForm:
   let rd=x.root_datum, theta=x.involution, cpt=is_compact_imaginary(x)
   then T = radical_basis(datum_of_root_set(rd,E)) { columns: basis of X_*(S) }
   then n=n_columns(T)
   then inE(vec a) = bool: find(E,posroot_index(rd,a))>=0
   then outside = for a in rd.roots if not inE(a) do a fi od
   then keys = sort_u_lex(for a in outside do a*T od)
   then over(vec b) = [vec]: for a in outside if a*T=b do a fi od
   then is_C_root(vec b) = bool:
           let l=over(b) in for a in l do #(=H*a) od.sum - for a in l do #(H*a=2) od.sum = 1
   then broots = for b in keys if !=b and is_C_root(b) do b fi od
   then M = n # for v in ^theta*T do ratvec_as_vec(requisition(solve(T,v))) od
   then theta_C = ^M
   then is_pos(vec b) = bool: { lexicographic in b+theta_C*b: C has no real roots, so this
                                is a theta_C-stable positive system }
           let v=b+theta_C*b then j=first(for c in v do c!=0 od) in v[j]>0
   then pos = for b in broots if is_pos(b) do b fi od
   then coroot_C(vec b) = vec:
           let l=over(b) then v = sum(rd.rank # for a in l do coroot(rd,a) od)
           then w = 2*v/(v*l[0]) in ratvec_as_vec(requisition(solve(T,w)))
   then rd_C = root_datum_from_positive((n # pos, n # for b in pos do coroot_C(b) od),rd.prefers_coroots)
   then kdim(vec b,int j) = int: { 2*dim(g_{j,beta} cap k) }
           for a in over(b) if H*a=j
           do if theta*a=a then if cpt(a) then 2 else 0 fi else 1 fi
           fi od.sum
   , pdim(vec b,int j) = int:
           for a in over(b) if H*a=j
           do if theta*a=a then if cpt(a) then 0 else 2 fi else 1 fi
           fi od.sum
   then imag = for b in pos if theta_C*b=b do b fi od
   then cpts = for b in imag do kdim(b,0)-pdim(b,2)=2 od
   then ic = inner_class(rd_C,theta_C)
   then matches (RealForm Gc) = bool: { theta_C is distinguished: look at the fundamental fiber }
           let found=false, i=0 in
	   while not found and i<KGB_size(Gc)
	   do let y=KGB(Gc,i) in
	      if length(y)>0 then break fi;
	      found := involution(y)=theta_C and
	               all(for b@k in imag do is_compact_imaginary(b,y)=cpts[k] od);
	      i+:=1
	   od; found
   then forms = real_forms(ic), j=0
   in while j<#forms and not matches(forms[j]) do j+:=1 od;
      assert(j<#forms,"no real form of the centralizer matches"); forms[j]

{ one line per K-orbit: index in K_component_data(G), H, x, diagram, dim, the real
  Bala-Carter Levi, the real form of Z_G(phi)^0, and the class orders of A_K(O_theta) }
set show_nilpotent_orbits (RealForm G) = void:
   prints("real nilpotent orbits for ",G);
   prints("i: index in K_component_data(G)");
   prints("BC Levi: real Bala-Carter Levi E_R (E, x of the identity class of A_K(O))");
   prints("Cent: real form of the identity component of Cent(SL(2))");
   prints("A_K(O): orders of conj. classes in K^e/(K^e)^0");
   tabulate(["i","H","x","diagram","dim","BC Levi","Cent","A_K(O)"]#
      for (O,cl)@i in K_component_data(G)
      do let c=identity_class(cl) in
         [i.to_string,O.H.to_string,(#O.x).to_string,O.complex_orbit.diagram.to_string,
          O.dimension.to_string,form_name(real_Bala_Carter_Levi(c)),
          (let C=form_name(centralizer_real_form(c)) in if C="" then "-" else C fi),
          sort(conjugacy_class_orders(cl)).to_string]
      od)
