<basic.at

{ given an n by n symmetric nonnegative, pos diag entries mat M (is
pos def enough?, and a squared R, find all nonneg integer vec's
v of size n with v*(M*v) <= R.

If v = [vf,vl], with vf an (n-1)-vec and vl a nonneg int, then

M = Mf    Me|   n-1 rows
    Me.^  Ml|  last row
    --------
   n-1   last
   cols  col


with Mf like M of size n-1, Ml a pos int, and Me an n-1 vec. So

M*v = [Mf*vf + Me*vl, (Me.^)*vf + Ml*vl]

v*(M*v) = vf*(Mf*vf) + vf*Me*vl+ vl*(Me.^ *vf) + Ml*vl^2

	= vf*(Mf*vf) + 2(vl*(vf*Me)) + Ml*vl^2

SO should add to the data a nonneg n-ratvec w, and require

v*(M*v) + v*w <= R

Now if w = [wf,wl], we get

v*(M*v) + v*w  = [vf*(Mf*vf)+vf*wf] + vf*(2vl*Me) + vl*wl + Ml*vl^2

SO vl runs from 0 until (vl*wl +  Ml*vl^2 > R. For each vl, find vf
using R - (Ml*vl^2 + vl*wl), Mf and wf + 2vl*Me.
}

{ given an n by n symmetric nonnegative, pos def mat M, a non-neg n-vec
w, and a nonneg rat R, find all nonneg integer vec's
v of size n with v*(M*v) + w*v <= R}

set rec_fun ballpoints(rat R, mat M, ratvec w) = [[int]]:
    if =#w then return [[]] fi;
    let n = #w
    then () = assert(@:shape(M) = (n,n),"need M square of size #w")
    then () = assert(@:w.>=,"need w to have nonnegative entries")
    then () = assert(@:(M.^) = M,"M must be symmetric")
    then () = assert(@:M.>=,"M must be nonneg")
    then () = assert(@:all(for d:n+1 do @bool: det(swiss_matrix_knife(
    	      		   (0,M,0,d,0,d))) >= 0 od),"M must be pos def")
    then Mf = swiss_matrix_knife(0,M,0,n-1,0,n-1), wf = w[:n-1]
    then Me = M[n-1][:n-1]
    then Ml = M[n-1,n-1]
    then last_lim = first(for j:ceil(R) + 2 do Ml*j^2 + j*w[n-1] > R od) {guaranteed >= 1}
    in {prints("n = ",n,", last_lim = ",last_lim);}
       for last:last_lim
       do for rest in ballpoints(R - Ml*last^2 - last*w[n-1], Mf, wf+2*last*Me)
	  do rest#last
	  od
       od.##

{linear term zero}
set  ballpoints(rat R, mat M) = [[int]]:
    let (n,) = shape(M)
    in ballpoints(R,M,null(n))

{interior points only}
set  open_ballpoints(rat R, mat M, ratvec w) = [[int]]:
     let d = denom(w)
     in ballpoints(R-1/d, M, w)

{interior points only, no linear term}
set open_ballpoints(rat R, mat M) = [[int]]:
    let (n,) = shape(M)
    in open_ballpoints(R,M,null(n))