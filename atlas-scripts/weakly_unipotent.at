<weakly_unipotent_max_ideal.at {for candidates_integrally_dominant, prohibited_singular_data, check_mu}
<hash.at {for make_int_list_hash, make_RootDatum_hash, make_Param_hash}

{ Weakly unipotent tests (Claude, 2026-09-28; moved here from weakly_unipotent_claude.at
  2026-10-12, replacing an earlier is_weakly_unipotent@Param that translated character_formula(p)
  to every candidate infinitesimal character: it divided by zero in lower_bounds and ran out of
  memory at E6).

  is_weakly_unipotent_claude(RootDatum G, ratvec lambda) = bool
     David's definition: J_max(lambda) tensor F has no composition factor of infinitesimal
     character strictly shorter than lambda, F any finite-dimensional rep (WEIGHT lattice).
     Same answer as is_weakly_unipotent@(RootDatum,ratvec) in weakly_unipotent_max_ideal.at
     (same candidates and check_mu), applied to dominant(G,lambda), prohibited_singular_data memoized
     on (integrality datum, singular simple integral roots) and the answer memoized on
     (RootDatum,lambda). prohibited_singular_data is nearly all of the cost (0.2-2 s at E6/E7).
     NOT is_weakly_unipotent_fast in weakly_unipotent_LMB.at: that is the Losev-Mason-Brown
     notion (root lattice, <mu,rho^vee> < <lambda,rho^vee>, single translate), and says true
     where this says false, e.g. Sp(4,R) at [1,1] (mu = [1,0]).

  is_weakly_unipotent(Param q) = bool
     The infinitesimal character of q is weakly unipotent (above) and Ann(q) is the maximal
     primitive ideal, i.e. GK_dim(q) = GK_dim_maximal_ideal(q.root_datum,
     q.infinitesimal_character). Memoized on q. Cheap tests first: tau(q) must be all
     nonsingular simple integral roots (rejects without GK); if gamma is integrally regular
     that already suffices. A further shortcut (tau_suffices, see its definition) is controlled
     by tau_suffices_flag. Otherwise GK_dim_claude (block-memoized GK_dim) is compared with
     a memoized GK_dim_maximal_ideal. wuq_validate_flag := true runs the GK test in every
     case and asserts that the shortcuts agree.

  GK_dim_claude(Param p) = int
     Same as GK_dim@Param (checked on 1221 parameters of 9 real forms at 7 infinitesimal
     characters each), but the W-cells of a block are computed once and every surviving
     Param of the block is recorded; GK dimension per cell on demand.

  Counters: wuc_hits/wuc_misses, wuq_count, wuq_time, gk_parts. Memos never cleared
  automatically: wuc_clear(), wuq_clear(), gkb_clear().

  The unitarity test is_unitary_coh_ind_claude, which uses is_weakly_unipotent@Param, is in
  weakly_unipotent_claude.at.
}

set wuc_hits = int: 0
set wuc_misses = int: 0
set wuc_rd_hash = make_RootDatum_hash()
set wuc_keys = make_int_list_hash()
set wuc_vals = [bool]: []
set wus_keys = make_int_list_hash()
set wus_vals = [[vec]]: []
set wuc_clear() = void:
    wuc_rd_hash := make_RootDatum_hash(); wuc_keys := make_int_list_hash(); wuc_vals := [];
    wus_keys := make_int_list_hash(); wus_vals := []; wuc_hits := 0; wuc_misses := 0

{ (M, prohibited_singular_data(G,lambda)), M = integrality_datum(G,lambda), lambda dominant;
  memoized on (M, simple roots of M singular for lambda) }
set prohibited_singular_data_memo(RootDatum G, ratvec lambda) = (RootDatum,[vec]):
    let M = integrality_datum(G,lambda)
    then key = [wuc_rd_hash.match(M)] ## for av@j in M.simple_coroots if lambda*av = 0 do j fi od
    then N = wus_keys.size() then m = wus_keys.match(key)
    in if m = N then wus_vals #:= prohibited_singular_data(G,lambda) fi;
       (M, wus_vals[m])

set is_weakly_unipotent_claude_base(RootDatum G, ratvec lambda) = bool:
    if G.ss_rank = 0 then return true fi;
    let lam = dominant(G,lambda) then list = candidates_shorter(G,lam)
    in #list = 0 or
       (let (M,sings) = prohibited_singular_data_memo(G,lam)
        in all(list, (ratvec mu) bool: check_mu(M,lam,mu,sings)))

set is_weakly_unipotent_claude(RootDatum G, ratvec lambda) = bool:
    let (num,den) = %lambda
    then key = [wuc_rd_hash.match(G)] ## num ## [den]
    then M = wuc_keys.size() then m = wuc_keys.match(key)
    in if m = M
       then wuc_misses +:= 1; wuc_vals #:= is_weakly_unipotent_claude_base(G,lambda)
       else wuc_hits +:= 1
       fi;
       wuc_vals[m]

{ character tables memoized on RootDatum }
set ct_hash = make_RootDatum_hash()
set ct_vals = [CharacterTable]: []
set character_table_memo(RootDatum rd) = CharacterTable:
    let M = ct_hash.size() then m = ct_hash.match(rd)
    in if m = M then ct_vals #:= character_table(rd) fi; ct_vals[m]

{ GK_dim_maximal_ideal memoized on (RootDatum, gamma) }
set gkm_keys = make_int_list_hash()
set gkm_vals = [int]: []
set GK_dim_maximal_ideal_memo(RootDatum rd, ratvec gamma) = int:
    let (num,den) = %gamma
    then key = [wuc_rd_hash.match(rd)] ## num ## [den]
    then M = gkm_keys.size() then m = gkm_keys.match(key)
    in if m = M
       then {as GK_dim_maximal_ideal@(RootDatum,ratvec), with memoized character tables}
	    let rd_int = integrality_datum(rd,gamma)
	    then ct_int = character_table_memo(rd_int)
	    then rd_singular = singular_root_datum(rd,gamma)
	    then ct_singular = if rd_singular = rd_int then ct_int else character_table_memo(rd_singular) fi
	    in gkm_vals #:= GK_dim_maximal_ideal(rd,ct_int,ct_singular,gamma)
       fi; gkm_vals[m]

{ Necessary condition for Ann(q) to be the maximal primitive ideal: tau(q) is the set of
  simple roots of the integrality datum that are nonsingular for the infinitesimal
  character. (Ann(q) = J_max iff GK_dim(q) = GK_dim_maximal_ideal, since primitive ideals
  of equal GK dimension are incomparable.) }
set tau_is_max(Param q) = bool:
    let gamma = q.infinitesimal_character, id = integrality_datum(q)
    in tau(q) = for av@j in id.simple_coroots if gamma*av != 0 do j fi od

{ gamma regular for the integrality datum? Then tau(q) = all simple integral roots already
  means Ann(q) = J_max (primitive ideals <-> W_int, tau = descent set, only w_0 has all). }
set is_int_regular(Param q) = bool:
    let gamma = q.infinitesimal_character
    in all(for av in integrality_datum(q).simple_coroots do gamma*av != 0 od)

{ David's shortcut. S = simple roots of the integrality datum that are nonsingular for gamma,
  L_S the Levi of the integrality datum they generate. If
     GK_dim_maximal_ideal(gamma) = #posroots(G) - #posroots(L_S),
  then tau(q) = S forces Ann(q) = J_max.
  Validated (wuq_validate_flag): 68 uses, 0 failures on all parameters of Sp(4,R), SL(3,R), G2_s,
  SO(4,3), Sp(6,R), SU(2,1), SU(3,2) at 8 infinitesimal characters each (some nonintegral);
  15 uses, 0 failures on the derived factors in FPP_unitary_hash_bottom_layer(KGB(E7_s)
  [17000:17200]). No measurable time saving there (the GK work it skips was cheap). }
set tau_suffices_flag = true
set tau_suffices_integral_only = false {restrict the shortcut to integral gamma}
set tau_suffices(Param q, int D) = bool:
    let rd = q.root_datum, gamma = q.infinitesimal_character
    then id = integrality_datum(rd,gamma)
    then S = for av@j in id.simple_coroots if gamma*av != 0 do j fi od
    in (not tau_suffices_integral_only or id.nr_of_posroots = rd.nr_of_posroots) and
       (D = rd.nr_of_posroots - sub_datum(id,S).nr_of_posroots)

{ wuq_validate_flag := true: always run the GK test, and record (not stop on) every case
  where a shortcut disagrees with it, in wuq_fail. Uses no assert, so it works with
  seat_belt_on := false. }
set wuq_validate_flag = false
set wuq_fail = [(string,Param)]: []
set wuq_time = [int]: [0,0,0,0] {ms in: infl char test, tau, GK_dim_maximal_ideal, GK_dim}
set wuq_count = [int]: [0,0,0,0,0,0]
    {new q, infl char false, tau false, GK false, integrally regular + tau (no GK), tau_suffices + tau (no GK)}

set gk_parts = [int]: [0,0,0] {ms: block + W cells, character_table, special character}

{ GK dimension memoized for a whole block: the first time a Param of a block is seen, its
  W-cells are computed and every Param of the block is recorded with (block cell number);
  the GK dimension of a cell (from its special representation) is computed on demand. }
set gkb_params = make_Param_hash()
set gkb_cell = [int]: []   {for each Param in gkb_params: global cell number}
set gkb_cells = [WCell]: []
set gkb_npos = [int]: []   {per global cell: #posroots of the Param's root datum}
set gkb_gk = [int]: []     {per global cell: GK dim, or -1 if not yet computed}
set gkb_origin = [Param]: [] {for each Param in gkb_params: the Param whose block registered it}
set gkb_clear() = void:
    gkb_params := make_Param_hash(); gkb_cell := []; gkb_cells := []; gkb_npos := []; gkb_gk := []; gkb_origin := []

set GK_dim_claude(Param p) = int:
    let q = Finalize(p) then M = gkb_params.size() then m = gkb_params.match(q)
    in if m = M
       then {new block. W_cells numbers the FULL block (at a regular infinitesimal character);
	     block(q) lists only the elements surviving at gamma, built the same way as the
	     full list returned by block_Hasse(q). A survivor's own number z has full[z] equal
	     to it. To be safe against a non-surviving z giving an equal Param (not seen so far),
	     a survivor is registered only if its Param occurs exactly once in the full list;
	     that occurrence is then its own z. Any others get their own block computation if
	     they are ever asked for.}
	    let t = elapsed_ms() then (params,idx) = block(q) then (full,) = block_Hasse(q)
	    then (vertex,cells) = vertex_and_W_cells(q)
	    then () = gk_parts[0] +:= elapsed_ms()-t
	    then () = assert(@:params[idx] = q and full[vertex] = q,
			     "GK_dim_claude: block/W_cells numbering mismatch")
	    then fh = make_Param_hash(), fcount = [int]: [], fz = [int]: []
	    then () = for r@z in full
		      do let j = fh.match(r)
			 in if j = #fcount then fcount #:= 1; fz #:= z else fcount[j] +:= 1 fi
		      od
	    then z_of = [int]: {full-block number of each survivor, or -1 if ambiguous}
		 for r in params do let j = fh.match(r) in if fcount[j] = 1 then fz[j] else -1 fi od
	    then () = z_of[idx] := vertex
	    then offset = #gkb_cells, npos = #posroots(q.root_datum)
	    then cell_of = [int]: for i:#full do -1 od
	    in for cell@c in cells
	       do gkb_cells #:= cell; gkb_npos #:= npos; gkb_gk #:= -1;
		  for l in cell.labels do cell_of[l] := offset+c od
	       od;
	       {q itself was entered (as number m = #gkb_cell) by the match above}
	       gkb_cell #:= cell_of[vertex]; gkb_origin #:= q;
	       {register the other surviving Params of the block whose number is unambiguous}
	       for r@i in params
	       do if z_of[i] >= 0
		  then let j = gkb_params.match(r)
		       in if j = #gkb_cell then gkb_cell #:= cell_of[z_of[i]]; gkb_origin #:= q
			  elif j < #gkb_cell then () {already known}
			  else error("GK_dim_claude: hash out of step")
			  fi
		  fi
	       od
       fi;
       let c = gkb_cell[m]
       in if gkb_gk[c] < 0
	  then let t = elapsed_ms() then cell = gkb_cells[c] then ct = character_table_memo(cell.root_datum)
	       then () = gk_parts[1] +:= elapsed_ms()-t; t := elapsed_ms()
	       then d = ct.degree(ct.special_character_inefficient(cell))
	       then () = gk_parts[2] +:= elapsed_ms()-t
	       in gkb_gk[c] := gkb_npos[c] - d
	  fi;
	  gkb_gk[c]

{ The combined test used on derived factor params: the infinitesimal character of q is
  weakly unipotent, and Ann(q) is the maximal primitive ideal (GK_dim(q) =
  GK_dim_maximal_ideal). Memoized on q. }
set wuq_hash = make_Param_hash()
set wuq_vals = [bool]: []
set wuq_clear() = void: wuq_hash := make_Param_hash(); wuq_vals := []

set is_weakly_unipotent_base(Param q) = bool:
    let rd = q.root_datum, gamma = q.infinitesimal_character, t = elapsed_ms()
    {the infinitesimal character test sees only the roots and <gamma,alpha^vee>: do it on the
     simply connected derived datum, so it also applies to reductive (e.g. Levi) q}
    then wu = is_weakly_unipotent_claude(simply_connected(rd),
				ratvec: for av in rd.simple_coroots do gamma*av od)
    then () = wuq_time[0] +:= elapsed_ms()-t
    in wuq_count[0] +:= 1;
       if not wu then wuq_count[1] +:= 1; return false fi;
       let t = elapsed_ms() then tm = tau_is_max(q)
       then () = wuq_time[1] +:= elapsed_ms()-t
       in if not tm and not wuq_validate_flag then wuq_count[2] +:= 1; return false fi;
          let reg = tm and is_int_regular(q)
          in if reg and not wuq_validate_flag then wuq_count[4] +:= 1; return true fi;
             let t = elapsed_ms() then D = GK_dim_maximal_ideal_memo(rd,gamma)
             then () = wuq_time[2] +:= elapsed_ms()-t
             then ts = tm and (tau_suffices_flag or wuq_validate_flag) and tau_suffices(q,D)
             in if ts and not wuq_validate_flag then wuq_count[5] +:= 1; return true fi;
                let t = elapsed_ms() then gkq = GK_dim_claude(q) then gk = gkq = D
                then () = wuq_time[3] +:= elapsed_ms()-t
                then () = if wuq_validate_flag
                          then let g0 = GK_dim(q)
                               in if g0 != gkq
                                  then let m = gkb_params.match(Finalize(q)) then o = gkb_origin[m]
                                       in prints("GK MISMATCH q=",q," rf=",q.real_form," Finalize(q)=",Finalize(q),
                                                 " GK_dim_claude=",gkq," GK_dim=",g0,
                                                 " registered by ",o," rf=",o.real_form,
                                                 " same rf ",o.real_form=q.real_form, " origin GK_dim=",GK_dim(o));
                                          error("GK_dim_claude mismatch")
                                  fi
                          fi
                in if not tm and gk then wuq_fail #:= ("tau_is_max false, GK maximal",q) fi;
                   if reg and not gk then wuq_fail #:= ("regular, tau_is_max, GK not maximal",q) fi;
                   if ts and not gk
                   then wuq_fail #:= ("tau_suffices ("+(if integrality_datum(q).nr_of_posroots = rd.nr_of_posroots
                                      then "integral" else "nonintegral" fi)+"), tau_is_max, GK not maximal",q)
                   fi;
                   if not tm then wuq_count[2] +:= 1
                   elif reg then wuq_count[4] +:= 1
                   elif ts then wuq_count[5] +:= 1
                   elif not gk then wuq_count[3] +:= 1
                   fi;
                   tm and gk

set is_weakly_unipotent(Param q) = bool:
    let M = wuq_hash.size() then m = wuq_hash.match(q)
    in if m = M then wuq_vals #:= is_weakly_unipotent_base(q) fi;
       wuq_vals[m]
