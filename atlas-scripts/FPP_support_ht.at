{ FPP_support_ht.at

  Heavy branch-only "to_ht" machinery for the FPP unitary-dual suite port
  from branch origin/to_ht_branch_alt.  Split out of FPP_support.at because
  it must load LATE (after hermitian.at) to avoid include cycles.  Contains:
    - branch-only deform.at to_ht helpers (recursive_deform_scr, ...)
    - branch-only hermitian.at to_ht unitarity engine (200+ functions)
  All extracted VERBATIM by exact signature; none touch all.at behaviour.
  Included from FPP_faces_herm.at after <hermitian.at.
  NB: does NOT include bottom_layer.at (which cyclically includes
  FPP_faces_herm.at); the mat overloads of all_lambda_differential_0 /
  basis_lambda_differential_0 live in the light FPP_support.at instead. }

<FPP_support.at { light core supplements incl. all_lambda_differential_0(mat) }
<FPP_faces_geom.at { for herm_center, non_herm_center (used below) }

{ ======================================================================== }
{ Branch-only additions to deform.at (recursive_deform_scr and to-height
  deformation helpers).  The fork deform.at is divergent (15 fork-only
  functions used by non-FPP deform_plus.at / paramChamber.at), so it is
  supplemented, not clobbered.  Extracted verbatim (comment-aware, by exact
  signature) keeping only signatures absent from the fork deform.at.  Not
  loaded by all.at. }
{ ======================================================================== }

<deform.at { fork base deform functions }
<polynomial.at { for i_poly, eval }
<red_points.at
<hash.at

set_type maybe_KTP = (void timed_out | KTypePol done)

{ this function is now obsolete, as |partial_KL_block| now condenses internally }

set deformation_terms_scr (Param p) = ParamPol:
  let (B,KL_mat,length) = ([Param],mat,vec):
    let (block,M,polys) = partial_KL_block(p:=normal(p))
    then l = vec: for q in block do q.length od, n=#block
    , p_1= for Q in polys do eval(Q,minus_1) od
    in
    ( block
    , for col@j in M
      do let lj=l[j] in
	 for entry@i in col do minus_1^(lj-l[i])*p_1[entry] od
      od
    , l
    )
  then nB=#B in
  if =nB or B~[0]!=p
  then null_module(p) { if |p| itself is not among survivors, return 0 }
  else { compute final column |acc| of |Q| matrix by solving linear system
         $P'*acc=e_p$ with $P'$ a matrix of Split, columns from |KL_sum_at_s| }
    let remainder = null(nB-1)#1 { start with standard basis vector for |p| }
    , solution=null(nB)
    , !opposite_parity=1-length~[0]%2 { opposite to that of |length(p)| }
    , !on_p = orientation_nr(p)
    in
    for q_ind : nB
    ~do let contrib=remainder[q_ind]*KL_mat[q_ind] in
      remainder -:= contrib
    ; if length[q_ind]%2=opposite_parity
      then solution +:= contrib
      fi
    od
  ; null_module(p)+
    for c@i in solution
    do { twist (1-s)*solution according to orientation numbers of its terms }
      let x=B[i] then (q,r)=(on_p-orientation_nr(x))\%2 in
      assert(@:r=0,"odd orientation");
      (minus_1^q*c*one_minus_s,x) { we have |s^q*c*(1-s) = (-1)^q*c(1-s)| }
      { for the same reason we replaced |s| by |-1| in computations giving |c| }
    od
  fi

set deformation_terms_scr (Param p, int HT) = ParamPol:
  let (B,KL_mat,length) = ([Param],mat,vec):
    let (block,M,polys) = partial_KL_block(p:=normal(p))
    then l = vec: for q in block do q.length od{, n=#block}
    , p_1= for Q in polys do eval(Q,minus_1) od
    then low_inds = for q@j in block do if height(q)<=HT do j fi od.##
    in
    block:= for j in low_inds do block[j] od;
    M := for j in low_inds do for k in low_inds do M[j][k] od od;
    l := for j in low_inds do l[j] od;
    ( block
    , for col@j in M
      do let lj=l[j] in
	 for entry@i in col do minus_1^(lj-l[i])*p_1[entry] od
      od
    , l
    ) {replace entry P_{x,y}(q) in M by (-1)^{l(x)-l(y)} P_{x,y}(-1)}
      {columns of KL_mat are irr chars}
  then nB=#B in
  if =nB or B~[0]!=p
  then null_module(p) { if |p| itself is not among survivors, return 0 }
  else { compute final column |acc| of |Q| matrix by solving linear system
         $P'*acc=e_p$ with $P'$ a matrix of Split, columns from |KL_sum_at_s| }
    let remainder = null(nB-1)#1 { start with standard basis vector for |p| }
    , solution=null(nB)		      {sero vec of size nB}
    , !opposite_parity=1-length~[0]%2 {0 or 1, parity opposite to that of |length(p)| }
    , !on_p = orientation_nr(p)
    in
    for q_ind : nB
    ~do let contrib=remainder[q_ind]*KL_mat[q_ind] in
      remainder -:= contrib
    ; if length[q_ind]%2=opposite_parity
      then solution +:= contrib
      fi
    od {solution is odd levels of Jantzen(p), as sum of irrs???}
  ; null_module(p)+
    for c@i in solution
    do { twist (1-s)*solution according to orientation numbers of its terms }
      let x=B[i] then (q,r)=(on_p-orientation_nr(x))\%2 in
      assert(@:r=0,"odd orientation");
      (minus_1^q*c*one_minus_s,x) { we have |s^q*c*(1-s) = (-1)^q*c(1-s)| }
      { for the same reason we replaced |s| by |-1| in computations giving |c| }
    od
  fi

