	" neg is_unitary tests, in time = ",print_time_string(sum(tested_neg_times) - tnt));
	tph:=tested_pos_hash.size();
	tpt := sum(tested_pos_times);
	tnh:=tested_neg_hash.size();
	tnt := sum(tested_neg_times);
    prints(sum(tested_inter_counts) - tic, " interrupted is_unitary tests, of ",
    	   tested_inter_hash.size() - tih, " different parameters, in time ",
	print_time_string(sum(tested_inter_times) - tit));
	tic:= sum(tested_inter_counts);
	tih:= tested_inter_hash.size();
	tit:=sum(tested_inter_times);
    prints(new_line,sum(for hash in tested_pos_to_ht_hashes do hash.size() od) -tphh," pos tests to_ht, in time = ",
    	print_time_string(sum(for list in tested_pos_to_ht_times do sum(list) od) - tpht),"; ",
	   sum(for hash in tested_neg_to_ht_hashes do hash.size() od) - tnhh," neg tests to_ht, in time = ",
 	   	   print_time_string(sum(for list in tested_neg_to_ht_times do sum(list) od) - tnht));
        tphh:= sum(for hash in tested_pos_to_ht_hashes do hash.size() od);
	tpht:=sum(for list in tested_pos_to_ht_times do sum(list) od);
        tnhh:= sum(for hash in tested_neg_to_ht_hashes do hash.size() od);
	tnht:=sum(for list in tested_neg_to_ht_times do sum(list) od);
    prints(sum(for list in tested_inter_to_ht_counts do sum(list) od) - tihc,
    	" interrupted tests to_ht, of ",sum(for hash
       in tested_inter_to_ht_hashes do hash.size() od) - tihh," different parameters, in time = ",
       print_time_string(sum(for list in tested_inter_to_ht_times do sum(list) od) - tiht),new_line);
       	tihc:=sum(for list in tested_inter_to_ht_counts do sum(list) od);
 	tihh:=sum(for hash in tested_inter_to_ht_hashes do hash.size() od);
	tiht:=sum(for list in tested_inter_to_ht_times do sum(list) od);
    if OT_hash.size() - oth > 0
    then prints(OT_hash.size()-oth," params had ", sum(OT_counts)-otc, " interrupted tests go too long by ",
    	 print_time_string(sum(OT_times) -ott));
	 oth:=OT_hash.size();
	 otc := sum(OT_counts);
	 ott := sum(OT_times)
    fi;
    prints("#bottom_layer = ",hash_bottom_layerCounter.use_count(), ", #one_level = ",
    	   hash_one_levelCounter.use_count(), {", #real_dumb = "} ", #dumb = ",
	   hash_real_dumbCounter.use_count() +
    	   hash_dumbCounter.use_count() +
   	    hash_def_dumbCounter.use_count(), ", #hash = ",
    	    hashCounter.use_count(), ", #hash2 = ",
    	    hash2Counter.use_count(), ", #steve = ",hash_steveCounter.use_count());
    prints(print_time_string(unitaryTime - utt)," for ",unitary_test_counter.use_count() -utc,
    					 " utests; ",
    			     print_time_string(charTime - ct), " for ",char_counter.use_count() -cu,
			     " char calcs, ",
			     print_time_string(charTimeToHt - ctth), " for ",char_counter_to_ht.use_count() -cuth,
			     " char to ht calcs");
	 utt:= unitaryTime;
	 utc:=unitary_test_counter.use_count();
	 ct:=charTime; ctth:=charTimeToHt;
	 cu:= char_counter.use_count(); cuth:=char_counter_to_ht.use_count();
    prints("...",running_label,"...",DTcount + DBTcount," Dirac elim; status_time = ",
    	   print_time_string(status_time), " for ", status_count," reports");
    prints("FPP_def_time = ",print_time_string(FPP_def_time)," for ",
    	    FPP_use_count, " tests, ",FPP_def_count, " eliminations; FDcount = ", FDcount);
	   		{predictor_time = ", print_time_string(predictor_time));}
    prints(new_line,tph," pos is_unitary tests, in time = ", print_time_string(tpt),"; ",tnh,
	" neg is_unitary tests, in time = ",print_time_string(tnt));
    prints(tic, " interrupted is_unitary tests, of ",tih, " different parameters, in time ",
	print_time_string(tit));
    prints(new_line,tphh," pos tests to_ht, in time = ",print_time_string(tpht),"; ",tnhh," neg tests to_ht, in time = ",
 	print_time_string(tnht));
    prints(sum(for list in tested_inter_to_ht_counts do sum(list) od)," interrupted tests to_ht, of ",sum(for hash
       in tested_inter_to_ht_hashes do hash.size() od)," different parameters, in time = ",
 	 	   print_time_string(sum(for list in tested_inter_to_ht_times do sum(list) od)), new_line);
    if oth.>
    then prints(OT_hash.size()," params had ", sum(OT_counts), " interrupted tests go too long by ",
    	 print_time_string(sum(OT_times)))
    fi;
   prints("pred_flag = ",predictor_flag,", pred u-time = ",print_time_string(predictor_u_time),
    	   ", pred u-count = ", predictor_u_count, ", pred h-time = ",print_time_string(predictor_h_time),
    	   ", pred h-count = ", predictor_h_count);
    prints("#bottom_layer = ",hash_bottom_layerCounter.use_count(), ", #one_level = ",
    	   hash_one_levelCounter.use_count(), {", #real_dumb = "} ", #dumb = ",
	   hash_real_dumbCounter.use_count() +
    	   hash_dumbCounter.use_count() +
   	    hash_def_dumbCounter.use_count(), ", #hash = ",
    	    hashCounter.use_count(), ", #hash2 = ",
    	    hash2Counter.use_count(), ", #steve = ",hash_steveCounter.use_count());
    prints(print_time_string(unitaryTime)," for ",unitary_test_counter.use_count()," utests; ",
    print_time_string(charTime), " for ",char_counter.use_count(), " char calcs; ",
    print_time_string(charTimeToHt), " for ",char_counter_to_ht.use_count(), " char_to_ht calcs");
    prints(HF_false_low_count," form_to_ht calcs -> form because of low(p,HT); ",FD_new_count," full_deform_to_ht DISAPPEAR because of stored_full_deform");
    if KL_sum_to_ht_new_flag then prints(KL_new_count," KL_sum_at_s_to_ht calcs -> known KL_sum_at_s, ",
       KL_false_low_count," KL_sum_at_s_to_ht calcs -> new KL_sum_at_s because of low_char") fi;
    prints("  ----------------")
    , @: {clear_report_tested_cum}
     tph := 0; tpt := 0; tnh := 0; tnt :=0; oth :=0; otc :=0; ott :=0;
     tic := 0; tih := 0; tit :=0; tphh := 0; tpht :=0; tnhh := 0; tnht := 0;
     tihc:=0; tihh:=0; tiht:=0;
     utc := 0; utt := 0; ct :=0; cu := 0; ctth := 0; cuth :=0; DTc:=0; DBTc:=0; nhtC_time:=0)

set report_tested_cum() = report_tested_cum("","")

{how many pos, interrupted, neg, pos_to_ht, interrupted_to_ht, neg_to_ht tests}

set u_counts() = vec:
    [tested_pos_hash.size(), tested_inter_hash.size(), tested_neg_hash.size(),
    sum(for hash in tested_pos_to_ht_hashes do hash.size() od),
    sum(for hash in tested_inter_to_ht_hashes do hash.size() od),
    sum(for hash in tested_neg_to_ht_hashes do hash.size() od)]

{execute this behind ">>badps.at" or something similar}

set list_to_ht_bad(int minTime) = void:
    let badps = [Param]: [], badTs = [int]:[], badHs = [int]:[]
    in for hash@j in tested_inter_to_ht_hashes
       do for p@k in hash.list()
       	  do let T = tested_inter_to_ht_times[j][k]
	     in if T>= minTime
	     	then badps#:=p;
		     badTs#:=T;
		     badHs #:=j+height(p)
		fi
	  od
       od;
       prints("predictor_flag:=true; predictor_verbose:=true");
       prints("{|badps| is a list of ",#badps," Param's.  is_unitary_to_ht(badps[j],badHs[j]) ran for time badTs[j] >= ",minTime,"}");
       write_param_list(badps,"badps");
       prints("set badHs = ",badHs);
       prints("set badTs = ",badTs)

set list_bad(int minTime) = void:
    let badps = [Param]: [], badTs = [int]:[]
    in for p@k in tested_inter_hash.list()
       do let T = tested_inter_times[k]
	  in if T>= minTime
	     then badps#:=p;
		  badTs#:=T
	     fi
       od;
       prints("predictor_flag:=true; predictor_verbose:=true");
       prints("{|badps| is a list of ",#badps," Param's.  is_unitary(badps[j]) ran for time badTs[j] >= ",
       			minTime,"}");
       write_param_list(badps,"badps");
       prints("set badTs = ",badTs)

set wsf_time = int:0

{SHOULD ONLY USE FOR TO HT >= ht(p)}

set worst_so_far_ht(Param p, int H) = int:
    let start_wsf = elapsed_ms()
    then TH = #tested_pos_to_ht_times
    then top_j = min(TH, H-height(p)+1)
    in let I_s = for j:top_j {can't be negative tests below H, or we wouldn't be asking}
      	    	      do vec: [tested_pos_to_ht_hashes[j].lookup(p),
			       tested_inter_to_ht_hashes[j].lookup(p)]
	    	      od {where p shows up in each of these test lists}
       then j_last = last(for j:top_j do I_s[j] != [-1,-1] od) {greatest height where it appears}
       then index = int: -1
       in wsf_time +:= elapsed_ms() - start_wsf;
	  if j_last >= 0 {well, if it DOES appear}
     	  then if (index:= I_s[j_last][0])>=0
     	       then 2*tested_pos_to_ht_times[j_last][index]
	       else 5*tested_inter_to_ht_times[j_last][I_s[j_last][1]]
	       fi
     	   else {if p hasn't been tested at all, take worst of all q's tested to H}
		max( (tested_inter_to_ht_times[:top_j] ##  tested_neg_to_ht_times[:top_j]
	    	     	  ## tested_pos_to_ht_times[:top_j] ##[[0]]).##)
     	   fi {j_last >=0}

set worst_so_far_u(Param p) = int:
    let start_wsf = elapsed_ms(), wsfh = worst_so_far_ht(p, GAM(p))
    then index = tested_inter_hash.lookup(p) {where p shows up in interrupted list}
    in wsf_time +:= elapsed_ms() - start_wsf;
       if index >= 0 {IF it shows up}
       then max(5*tested_inter_times[index], wsfh)
       else {if p hasn't been tested at all, take worst of all q's tested}
	    max(tested_neg_times##tested_pos_times##tested_inter_times##[wsfh])
       fi {index >=0}

set worst_so_far(Param p, int H) = int:
    if H >= height(p)
    then worst_so_far_ht(p,H)
    else worst_so_far_u(p)
    fi

set didnt_finish_u_count = int: 0

{predicted time in milliseconds to complete is_unitary(p)}

set u_predictor_old(Param p, int time) = int:
    if not predictor_flag
    then return max(worst_so_far(p,-1),interrupt_base_time\5) {change \10 to \5 4/5/26}
    fi;
    let delta = p.real_form.distinguished_involution, start_pred = elapsed_ms()
    then list = for q in {partial_block(p)} monomials(KL_sum_at_s(p))
    if is_fixed(delta,q) do q fi od, rk = #delta
    {will do full_deform on each term in list}
    then times = [int]: for q in list do defHashTime.time_lookup(q) od
    {have we computed full_deform? time needed if yes, -1 if no}
    then unknown_indices = [int]: for T@j in times if T < 0 do j fi od
    then num_filled_unknown = int: 0
    then () = if #unknown_indices > 0 {there are unknown full_deforms; work on one}
    	      then let j = unknown_indices[(#unknown_indices)\3] {this is a tough one}
		   then q = list[j]
	      	   then RT = defHashTime.time_record_bounded(q,(2*time)\3 + interrupt_base_time)
		   in if RT >= 0 then num_filled_unknown+:=1 else didnt_finish_u_count +:= 1 fi;
		      times[j] := RT
	      fi
    then () = if #unknown_indices > 1 {there are unknown full_deforms; work on one}
    	      then let j = unknown_indices[(2*#unknown_indices)\3] {this is an easier one}
		   then q = list[j]
	      	   then RT = defHashTime.time_record_bounded(q,time\3 + interrupt_base_time)
		   in if RT >= 0 then num_filled_unknown+:=1 else didnt_finish_u_count +:= 1 fi;
		      times[j] := RT
	      fi
    then est_times = for T in times if T != -1 do if T<0 then -5*T else T+1 fi fi od
    	 {(abs(t+1)) -1 truer, but avoid 0}
    then N = #list, ne = #est_times, un = #unknown_indices - num_filled_unknown
    in if predictor_verbose
	     	then prints(new_line,"Start predicting to height -1 param ",p);
		     prints("(#terms,#unknown,#estimated) = (N,un,ne) = (",N,",",un,",",ne,
		     	    "), estimated times = ",est_times)
       fi; {DANGER: IBT/40 insuff to do lookups! Need to get something at runtime.}
       let ans = un*max(est_times) + ((N-un)*interrupt_base_time)\10
       	   {change \10 to \2 4/7/26}
       	   {un full deforms to compute} {tried dividing un*max by 1, 10}
       	   in if predictor_verbose
       	      then prints("prediction = ", print_time_string(ans))
       	      fi;
	    {would be good to see WHICH terms are known, and weight their times accordingly. If a term
	     near x_open is known, then the predecessors are often nearly known}
	     predictor_time+:= elapsed_ms() - start_pred;
	     predictor_count+:=1;
	     predictor_u_time+:= elapsed_ms() - start_pred;
	     predictor_u_count+:=1;
       	     ans

{record (GAM, height, #partial_block, #reducibility_points)}

set stats = (Param -> (int,int,int,int)):
    let phash = Param_hash: make_Param_hash()
    then stats = [(int,int,int,int)]: [] {one for each Param: (GAM,height, #partial_block, #reducibility_points)}
    then add_param(Param q) = int:
    	 let I = phash.size()
	 then i = phash.match(q)
	 in if i = I
	    then stats #:=(GAM(q),height(q), #partial_block(q), #reducibility_points(q))
	    fi;
	    i
     in
     (Param -> (int,int,int,int)): (Param q): stats[add_param(q)]

{idea is to estimate TIMES for full_deform_to_ht(q,HT) for q@j in monomials(KL_sum_at_s_to_ht(q,HT)
 by a monomial...}

set GAM_HT_EXP = int: 0{1}{power of GAM(q) - height(q) in monomial}

set PB_EXP = int: 0   	  {power of #partial_block(q) in monomial}

set RP_EXP = int: 0	  {power of #reducibility_points(q) in monomial}

set HTht_EXP = int: 0{1}  {power of (HT - height(q) + 1) in monomial}

set BL_EXP = int: 0	  {power of (bit_length(#monomials) - bit_length(j)+1)  in monomial}

set J_SHIFT = int: 5	  {must be >=1; maybe (length(trivial) - length(p) + 1??}

set INVJ_EXP = int: 2     {power of (j + J_SHIFT)^{-1}) in monomial}

set PRED_END = rat: 1/4	  {value at N-1 of linear monomial. Should be in (0,1)} {1/10??}

set LIN_EXP = int: 1      {power of 1 + (PRED_END-1)*j/(N-1) in monomial}

set LIN_EXP_HT = int: 2   {was 2}

{try a factor length(q)+1 for q in qlist. This function decreases, usually toward 1.}

set LGTH_EXP = int:2

set LGTH_flag = false

{assume all terms in qlist same inf char}

set GAM_HTs_easy(int N) = [rat]:
    {let blq = bit_length(N) in}
    let pred_end = 1/N in
    for j:N do (1 + (pred_end-1)*j/N)^LIN_EXP {* (blq - bit_length(j) +1)^BL_EXP}/(j+J_SHIFT)^INVJ_EXP od

set GAM_HTs_easy(int N, int HT) = [rat]:
    let pred_end = 1/N in
    for j:N do (1 + (pred_end-1)*(j/N))^LIN_EXP_HT od

set GAM_HTs_LGTH([Param] qlist) = [rat]:
    let GHE = GAM_HTs_easy(#qlist)
    in for q@j in qlist do (length(q)+1)^LGTH_EXP *GHE[j] od

set GAM_HTs([Param] qlist) = [rat]:
    if LGTH_flag then return GAM_HTs_LGTH(qlist) fi;
    if GAM_HT_EXP + PB_EXP + RP_EXP = 0 then return GAM_HTs_easy(#qlist) fi;
    let GHE = GAM_HTs_easy(#qlist)
    in for q@j in qlist do let (g,h,p,r) = stats(q) in (g-h)^GAM_HT_EXP * p^PB_EXP *r^RP_EXP*GHE[j]  od

{in to_ht case, default to C*(linear decrease from 1 to PRED_END)}

set lin_flag = false {true}

set GAM_HTs([Param] qlist, int HT) = [rat]:
    if lin_flag then return GAM_HTs_easy(#qlist,HT) fi;
    if GAM_HT_EXP + PB_EXP + RP_EXP + HTht_EXP = 0 then return GAM_HTs_easy(#qlist) fi;
    let GHE = GAM_HTs_easy(#qlist) in
    for q@j in qlist do let (g,h,p,r) = stats(q) in (g-h)^GAM_HT_EXP * p^PB_EXP * r^RP_EXP * (HT-h+1)^HTht_EXP *
    	       	     	GHE[j]  od

{Number of K-types in branch_std(q) to ht H}
{would need to load K_types.at}
{set NUMK(Param q, int HT) = int:
    sum(for c@tau in branch_std(1*q,HT) do c.int_part od)}

{predict times for full_deform on qlist based on some data, at locations data_inds in qlist}
{some_times is a list of times of size #data_inds}
{result is full list of predicted times}

{this is when we use only position in qlist; N is #qlist}

set pred_easy(int N,[int] some_times, [int] data_inds) = [int]:
    let unnorm_preds = [rat]: GAM_HTs_easy(N)
    	{first coord is from GAM_HT, second from some_times}
    then sums1 = sum(some_times), S0 =  sum(for j in data_inds do unnorm_preds[j] od)
    then sums0 = (S0.numer + 1)/S0.denom
    in for j:N do ceil((unnorm_preds[j]*sums1)/sums0) od

set pred_easy(int N,[int] some_times, [int] data_inds, int HT) = [int]:
    let unnorm_preds = [rat]: GAM_HTs_easy(N,HT)
    	{first coord is from GAM_HT, second from some_times}
    then sums1 = sum(some_times), S0 = sum(for j in data_inds do unnorm_preds[j] od)
    then  sums0 = (S0.numer + 1)/S0.denom
    in for j:N do ceil((unnorm_preds[j]*sums1)/sums0) od

set pred([Param] qlist,[int] some_times, [int] data_inds) = [int]:
    if GAM_HT_EXP + PB_EXP + RP_EXP = 0
    then return(pred_easy(#qlist, some_times, data_inds)) fi;
    let GAM_HTs = GAM_HTs(qlist)
    then sums1 = sum(data_inds), S0 = sum(for j in data_inds do GAM_HTs[j] od)
    then  sums0 = (S0.numer + 1)/S0.denom
    in for n in GAM_HTs do ceil((n*sums1)/sums0) od

set pred([Param] qlist,[int] some_times, [int] data_inds, int HT) = [int]:
    if GAM_HT_EXP + PB_EXP + RP_EXP + HTht_EXP = 0
    then return pred_easy(#qlist, some_times, data_inds, HT)
    fi;
    let unnorm_preds = [rat]: GAM_HTs(qlist,HT)
    then sums1 = sum(data_inds), S0 = sum(for j in data_inds do unnorm_preds[j] od)
    then  sums0 = (S0.numer + 1)/S0.denom
    in for n in unnorm_preds do ceil((n*sums1)/sums0) od

set u_predictor_old(Param p) = int:
    u_predictor_old(p,20*interrupt_base_time) {change 5 to 10 4/7/26; 20 4/9}

set u_predictor_old_flag = false

set from_scratch_flag = false

{what mult of interrupt_base_time to use for u_predictor}

set uIBT_factor = rat: 1/2

{what mult of interrupt_base_time to use for u_predictor_to_ht}

set uIBT_HT_factor = rat: 1/8

{what mult of IBT for use in data lookups for u_predictor; was 5 before 5/23/26}

set u_test_factor = rat: 1/4

{what mult of IBT for use in data lookups for u_to_ht_predictor; was 1/10 before 5/23/26}

set uht_test_factor = rat: 1/16

{how many full_deforms to look at to estimate time}

set num_trials = int: 2

set min_trials = int: 1
{set upred_time_factor = int: 10}

{whether to put a little wiggle in prediction}

set no_margin_flag = false

set uGAM_flag = false {was true; changed 5/21/26}

{predicted time in milliseconds to complete is_unitary(p)}

set u_predictor(Param p, int time) = int:
    if u_predictor_old_flag then return u_predictor_old(p,time) fi;
    if not predictor_flag
    then return max(worst_so_far_u(p),interrupt_base_time\4) {change \10 to \5 4/5/26 remove 4/17/26}
    fi;
    let delta = p.real_form.distinguished_involution, start_pred = elapsed_ms(),
    	expiration = elapsed_ms() + time
    then list = for q in monomials(KL_sum_at_s(p))
    if is_fixed(delta,q) do q fi od, rk = #delta
    then times = [int]: for q in list do defHashTime.time_lookup(q) od
    {have we computed full_deform? time needed if yes, -if no}
    then unknown_indices = [int]: for T@j in times if T <= -2 do j fi od
    {then () = time:= max(time, (#unknown_indices*interrupt_base_time)\upred_time_factor)
    then expiration = elapsed_ms() + time}
    then do_one_flag = (#unknown_indices >= 0)
    	 {if all(for T in times ~do @bool: T<=-2 od) then true else false fi}
    then () = num_trials:= max(2*bit_length(#unknown_indices),min_trials) {\2, *2 added 15:45 4/18/26:
    84.0 for Spin(5,6). So try 2* 16:00: 90.3}
    then found_time = int:0
    then () = while num_trials > 0 and #unknown_indices > 0 and found_time < interrupt_base_time\2
    	      do let ind = #unknown_indices - 1
	      	 then j = unknown_indices[ind] {these get harder as k increases}
		 then q = list[j]
		 then time_test =  if do_one_flag
		      		   then ceil(u_test_factor*interrupt_base_time)
				   else interrupt_base_time - 2*times[j]
				   fi
		 in if elapsed_ms() > expiration and not do_one_flag
		    then break
		    fi;
		    let RT = defHashTime.time_record_bounded(q,time_test)
		    in if RT >= 0
		       then unknown_indices:=delete(unknown_indices,ind);
		       	    found_time+:=RT
		       else didnt_finish_u_count +:= 1
		       fi;
		       times[j] := RT;
		       {if RT > 0
		       then} num_trials -:= 1;
		       	    do_one_flag:=false
		       {fi} {if this was free and gave no time data, keep trying}
	      od
     then data_inds = [int]:[]
     then data_times = [int]: for T@j in times
    	 	       	      do if T <= -3 then data_inds#:=j; [-5*(T+3)]
			      	 elif T >=0 then data_inds#:=j; [T]
			  	 else []
			  	 fi
		       	      od.##
    then N = #list, data_n = #data_inds, un = #unknown_indices
    then () = J_SHIFT:=length(p.real_form.trivial) - length(p)+1
    then pred_list = {if uGAM_flag
    	 	     then pred(list, data_times, data_inds, GAM(p)) {try adding GAM(p) arg 5/5/26}
		     {no longer understand why this could help}
		     else} pred(list, data_times, data_inds)
		     {fi}
    then pred = if from_scratch_flag
       	      	then sum(pred_list){+interrupt_base_time}
		elif no_margin_flag
		then sum(for j in unknown_indices do pred_list[j] od)
		else sum(for j in unknown_indices do pred_list[j] od) +
		   		((N-un+10)*interrupt_base_time)\10
		fi
    then {data_times = for j in data_inds do data_times_long[j] od,}
    	 pred_data_times = for j in data_inds do pred_list[j] od
    in if predictor_verbose
       then prints(new_line,"Start predicting to height -1 param ",p);
	    prints("(#terms,#unknown,#data_times) = (N,un,data_n) = (",N,",",un,",",data_n,")");
	    prints("data_inds = ",data_inds);
	    prints("  actual data times = ",data_times);
	    if from_scratch_flag
	    then prints("predicted data times = ", pred_data_times);
	    prints("full predicted times = ", pred_list)
	    fi;
            prints(if from_scratch_flag then "from scratch " else "" fi,
	       		"prediction = ", print_time_string(pred), " in time ",
		       print_time_string(elapsed_ms() - start_pred))
        fi;
	predictor_time+:= elapsed_ms() - start_pred;
	predictor_count+:=1;
	predictor_u_time+:= elapsed_ms() - start_pred;
	predictor_u_count+:=1;
       	pred

set u_predictor(Param p) = int:
    u_predictor(p,ceil(uIBT_factor*interrupt_base_time)) {change 5 to 10 4/7/26; 20 4/9; 2 4/18}

set didnt_finish_ht_count = int: 0

{predicted time in milliseconds to complete is_unitary{to_ht}(p,{HT}); time is how long to spend working}

set u_predictor_to_ht_old(Param p, int HT, int time) = int:
    if HT < 0 then return u_predictor(p) fi;
    let WSF = max(interrupt_base_time\5, worst_so_far(p,HT)), {change \10 to \5 4/5/26}
    	start_pred = elapsed_ms()
    in if not predictor_flag
       then WSF
       else let delta = p.real_form.distinguished_involution, est_start = 0
       	    {if we can finish computing zeroth full_deform, rest are
	     better estimated from 1}
	    then list = {is_unitary runs over terms in KL_sum_to_ht(p,HT)}
		       for q in monomials(KL_sum_at_s_to_ht(HT)(p))
		       if is_fixed(delta,q) do q fi od, rk = delta.n_rows
	    then times =  [int]: for q in list do defHashHtTime.time_lookup_to_ht(q,HT) od
    	    then unknown_indices = [int]: for T@j in times if T < 0 do j fi od
    	    then num_filled_unknown = int: 0, un = #unknown_indices
    	    then () = if un > 0 {there are unknown full_deforms; work on one}
    	      	      then let j = unknown_indices[0]
		      	   {for low HT, zeroth term can be only non-trivial one}
	      	      	   then q = list[j]
	      	      	   then RT = defHashHtTime.time_record_to_ht_bounded(q,HT,time{(2*time)\3 +1})
		      	    in if RT >= 0
			       then num_filled_unknown+:=1; if j=0 then est_start:=1 fi
			       else didnt_finish_ht_count +:= 1
			       fi;
			       times[j] := RT
	      	      fi
    	    then () = if un > 1 {there are more unknown full_deforms; work on next}
    	      	      then let j = unknown_indices[1]
	      	      	   then q = list[j]
	      	      	   then RT = defHashHtTime.time_record_to_ht_bounded(q,HT,time\3 +1)
		      	    in if RT >= 0 then num_filled_unknown+:=1
			       else didnt_finish_ht_count +:= 1
			       fi;
			       times[j] := RT
	      	      fi;
		      un -:= num_filled_unknown
	    then est_times = for T@j in times if T!=-1 do if T < 0 then -5*T else (T+1) fi fi od
	    then N = #times, ne = #est_times
    	    in if predictor_verbose
	       then prints(new_line,"Start predicting to height ", HT, " param ",p);
		    prints("(#terms,#unknown,#estimated) = (N,un,ne) = (",N,",",un,",",ne,
		     	    "), est times = ",est_times)
	       fi;
	       {figure term 0 is the worst.}
       	       let ans =  if est_start = 1 {means j WAS unknown but we finished it}
	       	       	  then un*max(est_times[1:]#0) + ((N-un)*interrupt_base_time)\10
			       {N-un lookups} {un deforms to compute, estimated time}
			  elif #est_times > 1
			  then (un-1)*max(est_times[1:]) + est_times[0] +
			       ((N-un)*interrupt_base_time)\10
			  else un*max(est_times) + ((N-un)*interrupt_base_time)\10
			  fi
	       in if predictor_verbose
		  then prints("prediction ",print_time_string(ans), " in time ",
		       print_time_string(elapsed_ms() - start_pred))
		  fi;
		  predictor_time+:= elapsed_ms() - start_pred;
		  predictor_count+:=1;
		  ans
	  fi

{predicted time in milliseconds to complete is_unitary{to_ht}(p,{HT})}

set u_predictor_to_ht_old(Param p, int HT) = int:
u_predictor_to_ht_old(p, HT, 10*interrupt_base_time)

set min_ht_trials = 1

set u_predictor_to_ht(Param p, int HT, int time) = int:
    if u_predictor_old_flag then return u_predictor_to_ht_old(p,HT,time) fi;
    if HT < 0 then return u_predictor(p) fi;
    if not predictor_flag
    then return max(interrupt_base_time\4, worst_so_far(p,HT)) {back to \10 4/17}
    fi;
    let delta = p.real_form.distinguished_involution, expiration = elapsed_ms() + time, start_pred = elapsed_ms()
       	    {if we can finish computing zeroth full_deform, rest are
	     better estimated from 1}
    then list = {is_unitary runs over terms in KL_sum_at_s_to_ht(p,HT)}
		for q in monomials(KL_sum_at_s_to_ht(HT)(p))
		    if is_fixed(delta,q) do q fi od, rk = delta.n_rows
    then times =  [int]: for q in list do defHashHtTime.time_lookup_to_ht(q,HT) od
    {-2 means unknown. <= -3 means trying to -T-3 failed}
    then unknown_indices = [int]: for T@j in times if T <= -2 do j fi od
    then INFO = sum(for T in times if T> 0 do T fi od) {how much good info we have}
    then do_one_flag = {all(for T in times do T +  2 = 0 od)} (#unknown_indices > 0)
    then () = num_trials:= max(bit_length(#unknown_indices),min_ht_trials)
    then () = while num_trials > 0 and  #unknown_indices > 0 and (do_one_flag or
    	      (elapsed_ms() < expiration)) and (INFO < time/4)
    	      do let ind = #unknown_indices - 1
	      	 then j = unknown_indices[ind] {these get easier as j increases}
		 then q = list[j]
		 then time_test =  if do_one_flag
		      		   then ceil(uht_test_factor*interrupt_base_time) - 2*(times[j])
				   else expiration - elapsed_ms()
				   {interrupt_base_time - 2*times[j]}
				   fi
		 in if elapsed_ms() < expiration or do_one_flag
		    then let RT = defHashHtTime.time_record_to_ht_bounded(q,HT, time_test)
		    	 in if RT >= 0
		       	    then unknown_indices:=delete(unknown_indices,ind);
			    	 INFO +:= RT
		       	    else didnt_finish_ht_count +:= 1
		       	    fi;
			    do_one_flag:=false;
		       	    times[j] := RT;
			    num_trials-:=1
			 {else start_look+:=1 {can't help last unknown index, so go to previous}}
		    fi
	       od
     then data_inds = [int]:[]
     then data_times = for T@j in times
    	 	       do if T <= -3 then data_inds#:=j; [-2*(T+3)]
			  elif T>=0 then data_inds#:=j; [T]
			  {elif T=-1 then data_inds#:=j; [0]}{should be impossible}
			  else []
			  fi
		       od.##
     then N = #list, data_n = #data_inds, un = #unknown_indices
     then pred_list = pred(list, data_times,data_inds,HT)
     then pred = if from_scratch_flag
       	    	    then sum(pred_list) {+ interrupt_base_time}
		    elif no_margin_flag
		    then sum(for j in unknown_indices do pred_list[j] od)
		    else sum(for j in unknown_indices do pred_list[j] od) +
		    	 	 ((N-un+10)*interrupt_base_time)\10
		    fi
     then pred_data_times = for j in data_inds do pred_list[j] od
     in if predictor_verbose
	then prints(new_line,"Start predicting to height ", HT, " param ",p);
	     prints("(#terms,#unknown,#data_times) = (N,un,ne) = (",N,",",un,",",data_n,")");
	     prints("data_times = ",data_times);
	     prints("data_inds = ",data_inds);
	     prints("  actual data times = ",data_times);
	     if from_scratch_flag
	     then prints("predicted data times = ", pred_data_times);
	     	  prints("full predicted times = ", pred_list)
	     fi;
             prints(if from_scratch_flag then "from scratch " else "" fi,
	       		"prediction = ", print_time_string(pred), " in time ",
		       print_time_string(elapsed_ms() - start_pred))
	 fi;
	 predictor_time+:= elapsed_ms() - start_pred;
	 predictor_count+:=1;
	 predictor_h_time+:= elapsed_ms() - start_pred;
	 predictor_h_times#:=(elapsed_ms() - start_pred, time);
	 predictor_h_count+:=1;
	 pred

{predicted time in milliseconds to complete is_unitary{to_ht}(p,{HT})}

set u_predictor_to_ht(Param p, int HT) = int:
u_predictor_to_ht(p, HT, ceil(uIBT_HT_factor*interrupt_base_time))

{set adjust_factor = int: 5}

{return predicted (u_time, to_ht_time)}

set adjust_to_ht_over_u(Param p,int HT) = (int,int):
    let th = u_predictor_to_ht(p, HT)
    in (u_predictor(p),th)

{return predicted (u_time, to_ht_time)}

set adjust_to_ht_over_uB(Param p,int HT) = (int,int):
    let th = u_predictor_to_ht(p,HT)
    then ut = u_predictor(p, min(th+10,interrupt_base_time))
    in (ut, u_predictor_to_ht(p,HT,min(ut+10,interrupt_base_time)))

{return predicted (u_time, to_ht_time)}

set adjust_to_ht_over_uC(Param p,int HT) = (int,int):
    let ut = u_predictor(p){,2*interrupt_base_time)}
    then th = u_predictor_to_ht(p, HT){, min(ut+10, {2*}interrupt_base_time))}
    in (ut, th)


{.write c-invariant form on standard module as a KTypePol }
{ never involves |twisted_full_deform| }

set c_form_std(Param p) = KTypePol:
    let pc = alcove_center(p)
    in full_deform(pc)

{if deformed_hash_flag
       then deformedHash.entry(pc,-1)
       else full_deform(pc)
       fi}

{.write c-invariant form on standard module as a KTypePol }
{ never involves |twisted_full_deform| }

set c_form_std_cut(int HT) = (Param p) KTypePol:
    let pc = alcove_center(p)
    in full_deform_to_ht(pc,HT) {deformedHash.entry(pc,HT)}

{if deformed_hash_flag
       then deformedHash.entry(pc,HT)
       else full_deform_to_height_MvL_base(pc,HT)
       {to_ht(full_deform(pc),HT)}
       fi}

{p must be fixed by standard involution!}

set twisted_c_form_std(Param p) = KTypePol: { c-form on extended group}
    let pc = alcove_center(p)
    in twisted_full_deform(pc)

{if deformed_hash_flag
       then deformedHash.entry(pc,-1)
       else twisted_full_deform(pc)
       fi}

{    c_form on irreducible representations   }

{ untwisted |c_form_irreducible|, for efficiency; only used in equal rank case }
{.c-invariant form on irreducible module of p as KTypePol }

set c_form_irreducible_cut (Param p,int HT) = KTypePol:
   let ori_nr_p = orientation_nr(p)
   then oriented_KL_sum = ParamPol: null_module(p) +
      for c@q in KL_sum_at_s_to_ht(HT)(p) do (c*orientation_nr_term(ori_nr_p,q),q) od
   then cfsc = (Param -> KTypePol): (Param p) KTypePol: c_form_std_cut(HT)(p)
in to_ht(if back_form_ht_flag then back_map(cfsc, oriented_KL_sum)
   	 else map(cfsc, oriented_KL_sum)
	 fi ,HT)

{    twisted_c_form_irreducible   }

{ utility: compute fixed and unfixed contributions to c-form on irreducible(p)
  no deformation is done, but orientation numbers are included;
  fixed contributions are already halved; for unfixed ones this needs to wait
}

{p must be fixed by standard involution!}

set twisted_c_form_irreducible_contributions_cut (Param p, int HT) =
    (ParamPol,ParamPol): { (fixed part, 2*unfixed part) }
  let G=p.real_form, ori_nr_p = orientation_nr(p)
  then formula = (1+s)*KL_sum_at_s_to_ht(HT)(p) + (1-s)*twisted_KL_sum_at_s_to_ht(HT)(p)
  in { two value-producing loops can be a lot more efficient than one: }
     let (first,second) = ( (
      	 G.null_module +
      	 for c@q in formula
         if twist(q)=q do (half(c)*orientation_nr_term(ori_nr_p,q),q) fi
      	    	       od)
   , (G.null_module +
      for c@q in formula
         if twist(q)!=q do (c*orientation_nr_term(ori_nr_p,q),q) fi
      od))
      in if HT<0 then (first,second)
      	 else let (first_low,) = height_split(first,HT)
	      then (second_low,) = height_split(second,HT)
	      in (first_low,second_low)
	 fi
    {if HT < 0 then return twisted_KL_sum_at_s(p)
    else let (below,) = height_split(twisted_KL_sum_at_s(p),HT)
    	 in below
    fi}

{ The following function implements algorithm from Vogan in email 9/22/16:
  * for each delta-fixed term q add c_form_std(q) (fully twisted-deformed)
  * for each pair {q,delta(q)} add q*0 (deformation to nu=0 of q).
  For second kind it it convenient to add q*0 and delta(q)*0
  separately and at the end divide the sum of such contributions by 2.
}
{.twisted c-invariant form on an irreducible in terms of standardrepKs.}
{p must be fixed by standard involution!}

set show_unitary_time() = void: prints("Time so far for is_unitary = ",
    		      print_time_string(unitaryTime))

{.Hermitian form on a irreducible module, normalization from its initial term.}

set hermitian_form_irreducible_cut(Param p, int HT) = KTypePol:
  {unitary_test_counter.use();}
  let start_time = elapsed_ms()
  then answer = if is_equal_rank(real_form(p))
       	      	then c_form_irreducible_cut(p,HT) { not twisted, in equal rank case this is faster }
 		else check_hermitian(p,true); to_ht(twisted_c_form_irreducible(p),HT)
  		fi.convert_cform_hermitian
  in unitaryTime+:=elapsed_ms() - start_time;
     was_tested_to_ht(p,HT, elapsed_ms() - start_time, is_pure(answer));
     answer

{ compute Hermitian form on p, and report if it is unitary }

set is_unitary_depth(Param p) = int:
    if not p.is_hermitian
    then -2
    else hermitian_form_irreducible(p).impure_height
    fi

{ compute Hermitian form on p, and report if it is unitary }

set is_unitaryB (Param p) = bool:
  {unitary_test_counter.use();}
  let start_time = elapsed_ms()
  in if is_equal_rank(p.real_form)
  then let CF = c_form_irreducible(p)
       in if not is_typewise_pure(CF)
       	  then unitaryTime+:=elapsed_ms() - start_time;
	       was_tested(p, elapsed_ms() - start_time, false);
	       false
     	  else let answer = CF.convert_cform_hermitian.is_pure
	       then () = unitaryTime+:=elapsed_ms() - start_time
	       then () = was_tested(p, elapsed_ms() - start_time, answer)
	       in answer
     	  fi
   else check_hermitian(p,true);
   	let TCF = twisted_c_form_irreducible(p)
	in if not is_typewise_pure(TCF)
	   then unitaryTime+:=elapsed_ms() - start_time;
	        was_tested(p, elapsed_ms() - start_time, false);
	       	false
	   else let answer = TCF.convert_cform_hermitian.is_pure
	       then () = unitaryTime+:=elapsed_ms() - start_time
	       then () = was_tested(p, elapsed_ms() - start_time, answer)
	       in answer
	   fi
   fi

{ compute Hermitian form on p, and report
certificate; unitary means empty certificate }

set is_unitary_cert (Param p) = [KType]:
  hermitian_form_irreducible(p).is_pure_cert

{ compute Hermitian form on p, report if it is unitary, and otherwise record certificate }

set is_unitary(Param p,KTypePol_hash cert_hash) = bool:
  p.is_hermitian and is_pure_cert_hash(hermitian_form_irreducible(p),cert_hash)


{ some time-limited functions, using new built-in |full_deform@(Param,int)| }

{ the next type is the same as |Maybe<KTypePol>|, but injector names differ }
{set_type maybe_KTP = (void timed_out | KTypePol done)}

{1 means pure, 0 means timed out, -1 means impure}

set is_pure(maybe_KTP P) = int:
    case P
    | timed_out: 0
    | done(r): if is_pure(r)
      	       then 1
	       else -1
	       fi
    esac

set back_map ((Param->maybe_KTP)f, ParamPol P) = maybe_KTP:
  sum(P.real_form
     ,for c@p in P
     do case f(p) | timed_out: return timed_out() | done(r): c*r esac
      od
     ).done

{ guaranteed to deform at least one term}
{finishes without interruption if all terms already deformed}

set c_form_irreducible_cut (Param p,int HT, int time) = maybe_KTP:
   let ori_nr_p = orientation_nr(p), expiration = elapsed_ms() + time, dummy = K_type_pol(p).done
   then oriented_KL_sum = ParamPol: null_module(p) +
      for c@q in KL_sum_at_s_to_ht(HT)(p) do (c*orientation_nr_term(ori_nr_p,q),q) od
   then list = monomials(oriented_KL_sum)
   then unknown_indices = for q@j in list if defHashHtTime.time_lookup_to_ht(q,HT) < 0 do j fi od
   in if #unknown_indices > 0
      then dummy := full_deform_to_ht(list[unknown_indices~[0]],HT, time);
	   if #unknown_indices > 2 then dummy := full_deform_to_ht(list[unknown_indices[#unknown_indices\2]],HT, time) fi
      fi;
      if back_form_ht_flag then back_map( (Param q) maybe_KTP:
      	 if expiration - elapsed_ms() < 0
      	 then timed_out()
      	 else {deformedHash.maybe_entry}full_deform_to_ht(q,HT,expiration - elapsed_ms())
      	 fi
      	 , oriented_KL_sum
      	 )
      else map( (Param q) maybe_KTP:
      	 if expiration - elapsed_ms() < 0
      	 then timed_out()
      	 else {deformedHash.maybe_entry}full_deform_to_ht(q,HT,expiration - elapsed_ms())
      	 fi
      	 , oriented_KL_sum
      	 )
      fi

{guaranteed to deform at least one term}

set twisted_c_form_irreducible_unnormalized (Param p,int time) = maybe_KTP:
( let (fixed,unfixed)=twisted_c_form_irreducible_contributions(p)
  , expiration = elapsed_ms() + time, dummy = K_type_pol(p).done
  then list = monomials(fixed)
  then unknown_indices = for q@j in list if defHashTime.time_lookup(q) < 0 do j fi od
  in if #unknown_indices > 0
     then dummy:= twisted_full_deform(list[unknown_indices~[0]],time)
     {
     if #unknown_indices > 2 then dummy:= twisted_full_deform(list[unknown_indices[#unknown_indices\2]], time) fi
     }
     fi;
     case if back_form_flag then back_map( (Param q) maybe_KTP:
     	     if expiration - elapsed_ms() < 0
      	     then timed_out()
     	     else twisted_full_deform(q, expiration - elapsed_ms())
     	     fi
	     , fixed
	     )
	  else map( (Param q) maybe_KTP:
     	     if expiration - elapsed_ms() < 0
      	     then timed_out()
     	     else twisted_full_deform(q, expiration - elapsed_ms())
     	     fi
	     , fixed
	     )
	  fi
     | timed_out: timed_out()
     | done(r): done(r + half(unfixed.K_type_pol))
     esac
)

set hermitian_form_irreducible_cut (Param p, int HT, int time) = maybe_KTP:
   {unitary_test_counter.use();}
   let start_time = elapsed_ms()
   then answer = case if is_equal_rank(real_form(p))
               	      then c_form_irreducible_cut(p,HT,time)
	 	      else check_hermitian(p,true);
		      	   twisted_c_form_irreducible(p,time)
	 	      fi
   		 | timed_out: was_tested_inter_to_ht(p, HT, elapsed_ms() - start_time);
		   	      timed_out()
   		 | done(r): let ans = to_ht(r.convert_cform_hermitian,HT)
		   	    then total_time=elapsed_ms() - start_time, boo = is_pure(ans)
			    in was_tested_to_ht(p, HT, total_time, boo);
			       ans.done
   		 esac
  in unitaryTime+:=elapsed_ms() - start_time;
     answer

set is_unitary_depth (Param p, int time) = int: 
    if p.is_hermitian
    else -1
    then case hermitian_form_irreducible(p,time)
       	 | timed_out: 0
       	 | done(result): let D = result.impure_height
	   		 in if D<0 then 1
			    else -2*(D+1)
			    fi
       	 esac
    fi


{ end of core unitarity functionality, remaining variations for user comfort }

{ same as |c_form_irreducible|, but also return a second component that
  exposes the linear combination of contributions from standard representations
  that produced the result (parameter, coefficient, c_form on this standard)

  formulas: write
    J(y)  =sum_x               (-1)^{ell(x)-ell(y)}P(x,y)(q=1)I(x)
  then
    J(y)_c=sum_x (-1)^{on(x,y)}(-1)^{ell(x)-ell(y)}P(x,y)(q=s)I(x)_c
  where
    P(x,y) is a cumulated KL polynomial
    (-1)^{ell(x)-ell(y)}P(x,y) is given by signed_KL_col(y)[i] with
    indices[i]=x on(x,y)=orientation number given by orientation_nr_term()
    I(x)_c given as combination of standards x' with nu(x')=0 by c_form_std(x)
  algorithm: compute the sum for J(y)_c, using signed_KL_col and c_form_std
}
{.c-form on an irreducible, with extra output.}

set good_Q(Param p) = (KGPElt, Param):
    let G = p.real_form, x = p.x, gamma = p.infinitesimal_character
    then theta = x.involution, suppS = support(x), SCR = G.simple_coroots
    then goodS = ((for j in complement(G.semisimple_rank,suppS)
		     do if (gamma*SCR[j]).=
		        then [j]
		       	else []
		       	fi
		     od.##)##suppS).sort_u
    then goodQ = KGPElt:(goodS, x)
    then goodL = goodQ.Levi
    then xL = inverse_embed_KGB(x,goodL)
    then goodpL = parameter(xL, p.lambda_minus_rho+goodL.rho, p.nu)
    in (goodQ,goodpL)

set good_L(Param p) = RealForm:
    let G = p.real_form, x = p.x, gamma = p.infinitesimal_character
    then theta = x.involution, suppS = support(x), SCR = G.simple_coroots
    then goodS = ((for j in complement(G.semisimple_rank,suppS)
		     do if (gamma*SCR[j]).=
		        then [j]
		       	else []
		       	fi
		     od.##)##suppS).sort_u
    in (goodS,x).Levi

{smallest easy theta-stable Q from which p is weakly good range cohomologically
induced, and the inducing parameter}

set wkgood_Q(Param p) = (KGPElt, Param):
    let G = p.real_form, x = p.x, gamma = p.infinitesimal_character
    then theta = x.involution, suppS = support(x) {, SCR = G.simple_coroots}
    then wkgoodQ = KGPElt:(suppS, x)
    then wkgoodL = wkgoodQ.Levi
    then xL = inverse_embed_KGB(x,wkgoodL)
    then wkgoodpL = parameter(xL, p.lambda_minus_rho+wkgoodL.rho, p.nu)
    in (wkgoodQ,wkgoodpL)

{these functions are not used; subsumed by big_unitary_hash}
{
set unitarity_hash = make_unitarity_bool_hash()

set is_unitary_hash(Param p) = bool:
    if not is_hermitian(p) then return false fi;
    let (,pL) = wkgood_Q(p), G=p.real_form
    then derpLs = derived_factor_params0(pL)
    then answer = all([(->bool)] : for derpL in derpLs do @bool:
       			unitarity_hash.entry(derpL) od)
    {then formL = hermitian_form_irreducible(pL)}
    {then answer = is_pure(formL)}
    in if answer or pL = p
       then answer
       else {answer is false, and pL is on proper Levi}
       	    let goodL = good_L(p)
       	    in is_pure(sum(G, for c@qL in hermitian_form_irreducible(pL)
			      do c*theta_induce_standard(param(qL),
			           goodL)
			      od))
       fi
    {unitarity_hash.entry(p)}

set do_you_know_is_unitary(Param p) = bool:
    unitarity_hash.do_you_know(p)

set attest_is_unitary(Param p, bool answer) = void:
    unitarity_hash.attest(p,answer)
}


