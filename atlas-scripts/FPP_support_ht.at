set deformation_terms_by_dual_scr (Param p) = ParamPol:
  assert(@:p.is_final,"deformation requires a final parameter");
  let (block,KL_mat,P_polys) = partial_KL_block(p)
  , (full_block,start,dual_KL_mat,dual_polys) = dual_KL_block(p)
  {row j of dual_KL_mat gives multipliciticies of irr full_block[j]
   in Jantzen filts of various standard}
  then subset = [int]: {parameters above p}
       let j0 = first(for q in full_block do height(q)>=height(p) od)
       in for q@i in full_block[j0:] do if find(block,q) >=0 do i fi od.##
   {want to cut down to rows and columns in subset...}
  then pol_eval =  for P in P_polys do eval(P,minus_1) od, Q_col = vec:[]
  , dual_pol_eval = for P in dual_polys do eval(P,minus_1) od
  , l_sg = for q in block do minus_1^length(q) od
  , to_full = (int->int):
    let map = p.null_module + for q@i in full_block do (Split:(i,1),q) od
    in (int i) int: let c=map[block[i]] in assert(@:c!=0,"absent"); c.int_part
  then P_mat = mat:
    for col@j in KL_mat do for e@i in col do l_sg[i]*l_sg[j]*pol_eval[e] od od
  , Q_mat = mat:
    for col in ^dual_KL_mat do for e in col do dual_pol_eval[e] od od
  , opposite_parity=1-length(p)%2 { opposite to that of |length(p)| }
  then solution = sum
    ( #block { size of vectors being summed (after conversion to matrix) }
    # for q@i in block
         if length(q)%2=opposite_parity do Q_mat[i.to_full,start]*P_mat[i] fi
      od
    )
  , !on_p = orientation_nr(p)
in null_module(p) +
   for q@i in block
   do { twist (1-s)*solution according to orientation numbers of its terms }
     ( orientation_nr_term(on_p,q)*solution[i]*one_minus_s , q )
   od

{to hold partial block}

set partial_param_hash = make_Param_hash()
{using this causes failure in FPP_unitary_hash_one_level(Spin(4,4))}

set deformation_terms_by_dual_scr (Param p,int HT) = ParamPol:
(  assert(@:p.is_final,"deformation requires a final parameter")
;  if HT < 0 then return deformation_terms_by_dual_scr(p) fi
;  assert(@:p.height<=HT,"height bound kills term to deform")
;  let (full_block,start,dual_KL_mat,polys) = dual_KL_block(p), h0 = height(p)
   then (partial_block,partial_KL_mat,partial_polys) = partial_KL_block(p)
   then partial_subset = [int]:
 	for q@i in partial_block if (q.height<=HT) do i fi od {taken from the END of partial_block}
   then partial_block_ht = for i in partial_subset do partial_block[i] od
   then partial_ev = for P in partial_polys do eval(P,minus_1) od
   then partial_KL_mat_ht = mat: (for j in partial_subset
   			    	  do for i in partial_subset do partial_ev[partial_KL_mat[j][i]] od
				  od)
   then partial_param_hash = make_Param_hash(partial_block_ht)
   then subset = [int]:
     for q@i in full_block if partial_param_hash.lookup(q) >= 0 do i fi od
     {(q.height<=HT) and (q.height)>=h0 do i fi od}
     {should only select i in partial_block(p)}
   , ev = for P in polys do eval(P,minus_1) od
   , Q_col = vec:[] { vector variable to be assigned below }
   {then () = prints("for p = ",p,", HT = ",HT,", FB = ",
   	for i in subset do partial_param_hash.lookup(full_block[i]) od)}
   {then () = prints("PB = ",for q in partial_block_ht do partial_param_hash.lookup(q) od)}
   then Q_mat = mat: { transpose dual_KL_mat, select rows/cols from |subset|, set $q:=-1$ }
     for i in subset {columns}
     do let col = vec: for j in subset do ev[dual_KL_mat[i,j]] od
     in if i=start then Q_col:=col else col fi { store the column for |p| }
     od
   , block = [Param]: for i in subset do full_block[i] od
   then () = assert(@: all(for q@j in block do q = partial_block_ht[j] od),"orders don't match")
   {then () = prints("Qm = ",Q_mat)}
   then signer = diagonal(for q in partial_block_ht do (-1)^(length(q)) od)
   then signed_P_mat = signer*partial_KL_mat_ht*signer
   {then () = prints("sPm = ",signed_P_mat); prints("sPm*Qm = ",signed_P_mat*Q_mat);}
   then () = assert(@:Q_mat*signed_P_mat-id_mat(#subset) = 0,"mats are not inv")
   { $(-1)^{l(x,y)}P_{x,y}[q:=-1]$ for $x,y$ in |block| }
   , lp_parity=p.length%2 { parity of length that is excluded below }
   then solution = vec:
      { compute more efficiently: |signed_P_mat*diagonal(odd_levels)*Q_col|,
        where |odd_levels=vec: for q@i in block do #q.length%2!=lp_parity| }
        subset := { reuse local variable, now for selecting odd levels }
           for q@i in block if q.length%2!=lp_parity do i fi od
      ; (mat: signed_P_mat.n_rows # for j in subset do signed_P_mat[j] od)
       *(vec: for i in subset do Q_col[i] od)
  , !on_p = orientation_nr(p)
in null_module(p) +
   for q@i in block
   do { twist (1-s)*solution according to orientation numbers of its terms }
     ( orientation_nr_term(on_p,q)*solution[i]*one_minus_s , q )
   od {will be nonzero only for q in partial_block(p)}
)

{time in milliseconds to invert an N x N upper triangular matrix is about inverse_rate * N^3}

set upper_ex(int N) = mat:
    let M = id_mat(N)
    in for j:N-1  do for i:j+1 do M[i,j+1]:=i+1 od od;
       M

set inverse_rate = rat:
    let N = 100
    then M = upper_ex(N), start = elapsed_ms()
    then inv = M.inverse
    in (elapsed_ms() - start)/N^3

set upper_ones(int N) = mat:
    let M = id_mat(N)
    in for j:N-1  do for i:j+1 do M[i,j+1]:=1 od od;
       M
{estimated time in milliseconds for original: partial_KL and dual full_KL}

set guessA(Param p) = int: KL_predictor_full(p) + KL_predictor(p)

{estimated time in millseconds for B: partial_KL + inversion}

set guessB(Param p) = int: KL_predictor(p) + floor(inverse_rate*(#partial_block(p))^3)

{inverting an n x n (upper tri?) matrix takes time proportional n^3; on my laptop, (1/(4*10^4))*n^3
milliseconds. Computing KL for a block of size N takes time roughly proportion to N^2: laptop it's
(1/2.5*10^4)*N^2. SO should prefer original if .6 * (#partial_block_ht)^3 > (#full_block)^2  }
{I suspect there will be overflow as soon as #partial_block_ht is more than 20 or so}
{SO THIS FUNCTION IS UNRELIABLE!}

set deformation_terms_by_dualB_scr (Param p,int HT) = ParamPol:
(  assert(@:p.is_final,"deformation requires a final parameter")
;  if HT < 0 then return deformation_terms_by_dual_scr(p) fi
;  assert(@:p.height<=HT,"height bound kills term to deform")
;  let (partial_block,partial_KL_mat,partial_polys) = partial_KL_block(p)
   then partial_subset = [int]:
 	for q@i in partial_block if (q.height<=HT) do i fi od {taken from the END of partial_block}
   then partial_block_ht = for i in partial_subset do partial_block[i] od
   then partial_ev = for P in partial_polys do eval(P,minus_1) od
   then partial_KL_mat_ht = mat: (for j in partial_subset
   			    	  do for i in partial_subset do partial_ev[partial_KL_mat[j][i]] od
				  od)
   {then partial_param_hash = make_Param_hash(partial_block_ht)}
   then signer = diagonal(for q in partial_block_ht do (-1)^(length(q)) od)
   then signed_P_mat = signer*partial_KL_mat_ht*signer
   then Q_mat = inverse(signed_P_mat) {GREAT danger of overflow!}
   then Q_col = Q_mat~[0], lp_parity=p.length%2 { parity of length that is excluded below }
   then solution = vec:
      { compute more efficiently: |signed_P_mat*diagonal(odd_levels)*Q_col|,
        where |odd_levels=vec: for q@i in block do #q.length%2!=lp_parity| }
        let odd_subset = { reuse local variable, now for selecting odd levels }
           for q@i in partial_block_ht if q.length%2!=lp_parity do i fi od
       in (mat: signed_P_mat.n_rows # for j in odd_subset do signed_P_mat[j] od)
       *(vec: for i in odd_subset do Q_col[i] od)
  , !on_p = orientation_nr(p)
in null_module(p) +
   for q@i in partial_block_ht
   do { twist (1-s)*solution according to orientation numbers of its terms }
     ( orientation_nr_term(on_p,q)*solution[i]*one_minus_s , q )
   od {will be nonzero only for q in partial_block_ht(p)}
)

{ go to next reducibility point (move even if at reducibility point) }

set reduction_at_to_ht (Param p,int HT) = Maybe<Param>:
   let rp=(0/1)#reducibility_points_rp(p,HT)
in if rp~[0]=1 then none() else some(p*rp~[0]) fi

set next_down (Param p,int HT) = Param:
   let rp=(0/1)#reducibility_points_rp(p,HT)
in assert(@:rp~[0]=1,"Not a reducibility: "+p.to_string); p*rp~[1]

{ go to next reducibility point (move even if at reducibility point) }

set reduction_at_to_ht_old (Param p,int HT) = Maybe<Param>:
   let rp=(0/1)#reducibility_points(p)
in if rp~[0]=1 then none() else some(p*rp~[0]) fi

set next_down_old (Param p,int HT) = Param:
   let rp=(0/1)#reducibility_points(p)
in assert(@:rp~[0]=1,"Not a reducibility: "+p.to_string); p*rp~[1]

{ use |deformation_terms_by dual| for a full deformation, in which we try to
  group all successive deformations involving a same block together }

set deform_to_height_scr (Param p,int HT) = KTypePol: {same as full_deform_to_ht...}
(  assert(@:p.height<=HT,"height bound kills term to deform")
;  let G=real_form(p)
   then !K_empty=null_K_module(G), !empty=null_module(G)
in { first ensure there is a potential deformation at |p| }
   case reduction_at_to_ht(p,HT) | some(q): p:=q | none(): () { keep p } esac
;  let queue = ParamPol: p, result = KTypePol: K_empty, lower = ParamPol:empty
in while >#queue or
       if >#lower else false
       then set (queue,lower) := height_split(lower,height(first_param(lower)))
       ; true
       fi
   do { invariant of the loop: all terms in |queue| have potential deformation }
      let (c0,q):term = first_term(queue)
   in queue:= (queue next queue:=empty) - term
   ;  if =nu(q) then result := (result next result:=K_empty) + (c0,q.K_type)
      else lower:= (lower next lower:=empty) + (c0,next_down(q,HT))
      fi
   ;  let terms = deformation_terms_by_dual_scr(q,HT)
   in for c@r in terms
      do case reduction_at_to_ht(r,HT)
         | none():
	    queue:= (queue next queue:=empty) + (c0*c,r)
         | some(qq): { element of initial block, but no further deformation }
	    lower:= (lower next lower:=empty) + (c0*c,qq)
         esac
      od
   od
;  result
)

{ use |deformation_terms_by dual| for a full deformation, in which we try to
  group all successive deformations involving a same block together }

set deform_to_height_old (Param p,int HT) = KTypePol: {same as full_deform_to_ht...}
(  assert(@:p.height<=HT,"height bound kills term to deform")
;  let G=real_form(p)
   then !K_empty=null_K_module(G), !empty=null_module(G)
in { first ensure there is a potential deformation at |p| }
   case reduction_at_to_ht_old(p,HT) | some(q): p:=q | none(): () { keep p } esac
;  let queue = ParamPol: p, result = KTypePol: K_empty, lower = ParamPol:empty
in while >#queue or
       if >#lower else false
       then set (queue,lower) := height_split(lower,height(first_param(lower)))
       ; true
       fi
   do { invariant of the loop: all terms in |queue| have potential deformation }
      let (c0,q):term = first_term(queue)
   in queue:= (queue next queue:=empty) - term
   ;  if =nu(q) then result := (result next result:=K_empty) + (c0,q.K_type)
      else lower:= (lower next lower:=empty) + (c0,next_down_old(q,HT))
      fi
   ;  let terms = deformation_terms_by_dual_scr(q,HT)
   in for c@r in terms
      do case reduction_at_to_ht_old(r,HT)
         | none():
	    queue:= (queue next queue:=empty) + (c0*c,r)
         | some(qq): { element of initial block, but no further deformation }
	    lower:= (lower next lower:=empty) + (c0*c,qq)
         esac
      od
   od
;  result
)

{ the original version of this file started here }

set weak_lower_scr (Param p,int HT) = Param:
  let (x,lambda,gamma)=%p, rp=reducibility_points_rp(p,HT)
  then lim = #rp
  in param(x,lambda,gamma*if lim=0 then 0 else rp[lim-1] fi)

{ go to next reducibility point (move even if at reducibility point) }

set lower_scr (Param p,int HT) = Param:
  let (x,lambda,gamma)=%p, rp=reducibility_points_rp(p,HT)
  then lim = let nrp=#rp in if nrp>0 and rp[nrp-1]=1/1 then nrp-1 else nrp fi
  in  param(x,lambda,gamma*if lim=0 then 0 else rp[lim-1] fi)

set deformation_scr (Param p, int HT) = (Param,ParamPol): { deformed Param and new terms }
  (lower_scr(p,HT), deformation_terms_by_dual_scr(p,HT))
 { deform(p))} { here |deform| may be replaced by |deformation_terms| }

{whether to use deformation_terms_by_dual in recursive_deform}

set by_dual_flag = false

{same as full_deform}

set recursive_deform_scr (Param p, int HT) = KTypePol:
  if d_verbose then prints("recursive_deform to height with:", p) fi;
  if not is_final(p) then error("improper parameter") fi;
  let empty=null_module(real_form(p)) in
  if d_verbose { choose verbose or non-verbose version of the function }
  then rec_fun full_def_scr (Split sc,Param p, int HT) KTypePol:
	 { |sc| will simply scale the coefficients of resulting KTypePol }
    begin
      p := alcove_center(p);
      prints("full_def_scr with: sc=", sc, ", p=", p, p.infinitesimal_character);
      assert(@:is_standard(p)
	    ,"non standard parameter encountered in deformation");
      let acc=empty, at_nu0=KTypePol: sc*(p.K_type) { fully deformed |p| } in
      for factor in reducibility_points_rp(p,HT)
      ~do
	let p_def=Finalize(p*factor) { next deformation of |p| }
	then def= {deform(p_def)} { bypass built-in |deform| here }
	     	  if by_dual_flag
		  then deformation_terms_by_dual_scr(p_def,HT)
		  else deformation_terms_scr(p_def,HT)
		  fi
        in
	  prints("adding deformation term: p=", p_def, new_line,"adding:", def)
      ; acc+:=def
      od
    ; for k@q in acc { traverse the sum of the deformation terms spun off }
      do { apply |full_def_scr| recursively to all those terms }
        at_nu0 +:= full_def_scr(sc*k,q,HT) { gather harvest from those deformations }
      od
    ; prints("full_def_scr complete, result:",at_nu0)
    ; at_nu0
    end
  else rec_fun full_def_scr (Split sc,Param p, int HT) KTypePol:
	 { |sc| will simply scale the coefficients of resulting KTypePol }
    begin
      p := alcove_center(p);
      assert(@:is_standard(p),"non standard parameter in deformation");
      let acc=empty, at_nu0=KTypePol: sc*(p.K_type) { fully deformed |p| } in
      for factor in reducibility_points_rp(p,HT)
      ~ { direction of deformation is down, towards 0; this is not essential }
      do acc+:={deform(p*factor)}
      	 if by_dual_flag
	 then deformation_terms_by_dual_scr(Finalize(p*factor),HT)
	 else deformation_terms_scr(Finalize(p*factor),HT)
	 fi
      od
    ; for k@q in acc { traverse the sum of the deformation terms spun off }
      do at_nu0 +:= full_def_scr(sc*k,q,HT) od
    ; at_nu0
    end
  fi { apply that recursive function to the initial argument: } (1,p,HT)

{same as full_deform interruptible}

set recursive_deform_scr (Param p, int HT, int TIME) = maybe_KTP:
  {if d_verbose then prints("recursive_deform to height with:", p) fi;}
  if not is_final(p) then error("improper parameter") fi;
  let empty=null_module(real_form(p)), expiration = elapsed_ms() + TIME
  {if d_verbose} { choose verbose or non-verbose version of the function }
  in (rec_fun full_def_scr (Split sc,Param p, int HT, int expiration) maybe_KTP:
	 { |sc| will simply scale the coefficients of resulting KTypePol }
    begin
      p := alcove_center(p);
      assert(@:is_standard(p),"non standard parameter in deformation");
      let acc=empty, at_nu0=KTypePol: sc*(p.K_type) { fully deformed |p| } in
      for factor in reducibility_points_rp(p,HT)
      ~ { direction of deformation is down, towards 0; this is not essential }
      do acc+:={deform(p*factor)}
      	 if by_dual_flag
	 then deformation_terms_by_dual_scr(Finalize(p*factor),HT)
	 else deformation_terms_scr(Finalize(p*factor),HT)
	 fi
      od
    ; for k@q in acc { traverse the sum of the deformation terms spun off }
      do at_nu0 +:= case full_def_scr(sc*k,q,HT,expiration)
      	 	    	 | timed_out: 0*at_nu0
			 | done(P): P
		    esac
      od
    ; if expiration < elapsed_ms()  then timed_out()
      else (at_nu0).done
      fi
    end)(1,p,HT,elapsed_ms() + TIME)
  { apply that recursive function to the initial argument: }

{same as built-in full_deform}

set recursive_deform_old (Param p, int HT) = KTypePol:
  if d_verbose then prints("recursive_deform to height with:", p) fi;
  if not is_final(p) then error("improper parameter") fi;
   let empty=null_module(real_form(p))
   in (rec_fun full_def_old (Split sc,Param p, int HT) KTypePol:
	 { |sc| will simply scale the coefficients of resulting KTypePol }
    begin
      p := alcove_center(p);
      assert(@:is_standard(p),"non standard parameter in deformation");
      let acc=empty, at_nu0=KTypePol: sc*(p.K_type) { fully deformed |p| } in
      for factor in reducibility_points_rp(p,-1)
      ~ { direction of deformation is down, towards 0; this is not essential }
      do acc+:={deform(p*factor)}
      	 deformation_terms_by_dual_scr(Finalize(p*factor),HT)
      od
    ; for k@q in acc { traverse the sum of the deformation terms spun off }
      do at_nu0 +:= full_def_old(sc*k,q,HT) od
    ; at_nu0
    end) (1,p,HT)
  { apply that recursive function to the initial argument: }

{ code that follows is adapted from hermitian.at to do unitarity computation
  in terms of the above functions rather than built-ins
}

set c_form_irreducible_scr (Param p) = KTypePol:
  let P=oriented_KL_sum(p), count=0 then nP=#P
  then
    f(Param p) = if count<11 or count%10=0 or nP-count<=10
                 then prints("Term ",count,": ",p)
		 fi; count+:=1; recursive_deform_scr(p,-1)
  in prints("Fully deforming ",nP," terms"); map(f, P)

{ utility: compute fixed and unfixed contributions to c-form on irreducible(p)
  no deformation is done, but orientation numbers are included;
  fixed contributions are already halved; for unfixed ones this needs to wait
}

set twisted_c_form_irreducible_contributions_scr (Param p) =
    (ParamPol,ParamPol): { (fixed part, 2*unfixed part) }
  let G=p.real_form, ori_nr_p = orientation_nr(p)
  then fixed_terms=G.null_module, unfixed_terms=G.null_module
  in
  for c@q in (1+s)*KL_sum_at_s(p) + (1-s)*twisted_KL_sum_at_s(p)
  do if twist(q)=q
     then fixed_terms+:=(half(c)*orientation_nr_term(ori_nr_p,q),q)
     else unfixed_terms+:=(c*orientation_nr_term(ori_nr_p,q),q)
     fi
  od; (fixed_terms,unfixed_terms)

{ for now we do not have any script for the twisted deformation; use built-in }

set twisted_c_form_irreducible_scr (Param p) = KTypePol:
( let (fixed,unfixed)=twisted_c_form_irreducible_contributions_scr(p)
{ |1+s| divides |unfixed|, no need for |scale_extended|; take half at |nu=0| }
  , count=0
  then nf=#fixed
  then
    f(Param p) = if count<11 or count%10=0 or nf-count<=10
                 then prints("Term ",count,": ",p)
		 fi; count+:=1; twisted_full_deform(p)
  in prints("Fully twisted deforming ",nf," terms (",#unfixed," unfixed).")
; map(f,fixed)+half(unfixed.K_type_pol)
)

{.whether J(p) admits an invariant Hermitian form.}

set is_hermitian_scr (Param p) = bool: equivalent(twist(p),p)

set check_hermitian_scr (Param p) = void:
  assert(@:p.is_hermitian_scr
        ,"Irreducible module does not admit any invariant Hermitian form"
	)

set hermitian_form_irreducible_scr (Param p) = KTypePol:
  if is_equal_rank(real_form(p))
  then c_form_irreducible_scr(p) { not twisted, in equal rank case this is faster }
  else check_hermitian_scr(p); twisted_c_form_irreducible_scr(p)
  fi.convert_cform_hermitian

{ compute Hermitian form on p, and report if it is unitary }

set is_unitary_scr (Param p) = bool:
  p.is_hermitian_scr and hermitian_form_irreducible_scr(p).is_pure


{ ======================================================================== }
{ Branch-only additions to hermitian.at (the "to_ht" unitarity engine).
  hermitian.at is loaded by all.at AND covering-group-modified in this fork
  (2 fork-only functions plus covering edits to ~16 shared functions), so it
  MUST NOT be clobbered.  The 200+ branch-only definitions below (the whole
  is_unitary_to_ht / full_deform_to_ht / u_predictor / stats-hashing machinery
  the FPP suite depends on) are extracted VERBATIM (comment-aware, by exact
  signature) from origin/to_ht_branch_alt:atlas-scripts/hermitian.at, keeping
  only signatures absent from the fork hermitian.at.  Loaded only by FPP
  scripts, so redefinitions here cannot affect all.at. }
{ ======================================================================== }

<hermitian.at { fork base: check_hermitian(Param,bool), is_unitary, c_form_* }
<hash.at
<count.at
<time.at
<convert_c_form.at
<cohom_reductionND.at

