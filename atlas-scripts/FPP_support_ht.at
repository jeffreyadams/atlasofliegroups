{take a KTypePol _apparently_ attached to G and make it _actually_ attached
to G. Need this to use looked-up deformations.}

set regroup(RealForm G, KTypePol P) = KTypePol:
    sum(G, for c@q in P do let (,m) = %q.x
    	   in c*K_type(KGB(G,m), q.lambda_minus_rho) od)

set regroup(RealForm G, maybe_KTP P) = maybe_KTP:
    case P
    |timed_out(): timed_out()
    |done(Q): regroup(Q.real_form,Q).done
    esac

set regroup(RealForm G, Param p) = Param:
    parameter(G, p.x.number, p.lambda, p.nu)

set low_height(KTypePol P) = int:
    if P.= then -1 else height(last_K_type(P)) fi

set low_height(ParamPol P) = int:
    if P.= then -1 else height(last_param(P)) fi

set impure_height(KTypePol P) = int:
    if is_pure(P) then -1
    else let (a, mu) = first_term(P)
    	 then () = if not is_pure(a) then return height(mu) fi
	 then () = for c@tau in a*P
	    	   do if not s_part(c).=
		      then return height(tau)
		      fi
		   od
	 in -1
     fi

set full_deform_library(Param p) = full_deform(p)

{repeating this is useful: library remembers partial info}

set full_deform_library(Param p, int time) = full_deform(p, time)

set twisted_full_deform_library(Param p) = twisted_full_deform(p)

set twisted_full_deform_library(Param p, int time) = twisted_full_deform(p, time)

{whether to use the script full_deform}

set deform_script_flag = false

{whether to use reducibility_points_rp}

set deform_rp_flag = false

{use reducibility_points_rp if #reducibility_points > rp_cutoff}

set some_deform_rp_flag = false

set rp_cutoff = int:20

{whether to use old (always to_ht) version}

set full_deform_old_flag = false

set full_deform_to_height_MvL_old(Param p, int height) = KTypePol:
  if height < 0 then return full_deform(p) fi;
  let start = elapsed_ms(), !empty_K=null_K_module(p.real_form), !empty=null_module(p)
  then output = empty_K, def = empty, time = interrupt_base_time
  then P = empty +
       	 { snap p down to a reducibility point, or tempered parameter }
     	 (let rp = reducibility_points(p)
      	  in if =#rp
      	     then output +:= p.K_type; []
	     else [p*rp~[0]]
	     fi)
      then () = while >#P
       	    do set (def,P) :=
               (let q=first_param(P) in block_deform(q,P next P:=empty,height))
  	       ;  let kt = for c@m in def if  =nu(m) do (c,m.K_type) fi od
     	       	  ,   pp = for c@m in def if !=nu(m) do (c,m) fi od
  	      in output := (output next output:=empty_K) + kt; P := (P next P:=empty) + pp
  	    od
  in output

set full_deform_to_height_MvL_old(Param p, int height,int TIME) = maybe_KTP:
  if height < 0 then return full_deform_library(p,TIME) fi;
  let start = elapsed_ms(), !empty_K=null_K_module(p.real_form), !empty=null_module(p)
  then output = empty_K, def = empty{ , time = max(TIME\32,interrupt_base_time)}
  then P = empty +
       	 { snap p down to a reducibility point, or tempered parameter }
     	 (let rp = reducibility_points(p)
      	  in if =#rp
      	     then output +:= p.K_type; []
	     else [p*rp~[0]]
	     fi)
      then () = while >#P
       	    do set (def,P) :=
               (let q=first_param(P) in block_deform(q,P next P:=empty,height))
	       ; if elapsed_ms() - start > TIME
	       	 then return timed_out()
		 fi
  	       ;  let kt = for c@m in def if  =nu(m) do (c,m.K_type) fi od
     	       	  ,   pp = for c@m in def if !=nu(m) do (c,m) fi od
  	      in output := (output next output:=empty_K) + kt; P := (P next P:=empty) + pp
  	    od
  in done(output)

set FDH_count = int:0

set FDH_time = int:0

{repeating this is NOT useful: library seems NOT to remember partial info}
{worst cases for block_deform appear to be low(p) = (N,n,N+m) where n and m are relatively small and N big.}

set full_deform_to_height_MvL_base(Param p, int height) = KTypePol:
if height < 0 then return full_deform_library(p) fi;
if full_deform_old_flag then return full_deform_to_height_MvL_old(p,height) fi;
if deform_script_flag then return recursive_deform_scr(p,height) fi;
FDH_count+:=1;
(    let !empty_K=null_K_module(p.real_form), !empty=null_module(p), start = elapsed_ms()
     then output = empty_K, def = empty
     then P = empty +
     { snap p down to a reducibility point, or tempered parameter }
     (let rp =  if deform_rp_flag
	      	then reducibility_points_rp(p,height)
		else let maybe = reducibility_points(p)
		     in if #maybe < rp_cutoff or not some_deform_rp_flag
		     	then maybe
			else reducibility_points_rp(p,height)
			fi
		fi
       in if =#rp then output +:= p.K_type; [] else [p*rp~[0]] fi)
       	  then () = while >#P
       	    do {prints("At A, q = ",first_param(P), ", height = ",height,", #P = ",#P);}

	       set (def,P) :=
               (let q= {first_param(P)} last_param(P) in block_deform(q,P next P:=empty,height))
  	       ; let kt = for c@m in def if  =nu(m) do (c,m.K_type) fi od
     	       	  ,   pp = for c@m in def if !=nu(m) do (c,m) fi od
  	      in output := (output next output:=empty_K) + kt; P := (P next P:=empty) + pp
  	    od
       in output next FDH_time+:=elapsed_ms() - start
      {esac}
      )
{whether to use script_deform in interrupted u_predictor_to_ht}

set secret_pred_flag = false

{make possible additional interruptions of full_deform_to_ht(p,HT,time)}

set force_interrupt_flag = false

{alternative is recursive_deform_scr(p) or (p,HT) or (p,HT,time)}

set full_deform_to_height_MvL_base(Param p, int height, int time) = maybe_KTP:
if height < 0 then return full_deform_library(p,time) fi;
if full_deform_old_flag then return full_deform_to_height_MvL_old(p,height,time) fi;
if deform_script_flag {or secret_pred_flag} then return recursive_deform_scr(p,height,time) fi;
FDH_count+:=1;
( let start = elapsed_ms(), !empty_K=null_K_module(p.real_form), !empty=null_module(p)
  then output = empty_K, def = empty, expiration = start + time, count = 2
  then P = empty +
  { snap p down to a reducibility point, or tempered parameter }
  (let rp = if deform_rp_flag
	    then reducibility_points_rp(p,height)
	    else let maybe = reducibility_points(p)
		 in if #maybe < rp_cutoff or not some_deform_rp_flag
		    then maybe
		    else reducibility_points_rp(p,height)
		    fi
	    fi
  {then () = prints("after rp, used ",print_time_string(elapsed_ms() - start))}
  in if =#rp then output +:= p.K_type; [] else [p*rp~[0]] fi)
     then () = while >#P
       do {prints("entering while, used ",print_time_string(elapsed_ms() - start));
          prints("At B, q = ",first_param(P), ", height = ",height,", #P = ",#P);}

	  set (def,P) :=
          (let q={first_param(P)} last_param(P)
	   in if force_interrupt_flag and count > 0 and
	      	 KL_predictor_full(q) > 10*(expiration - elapsed_ms())
	      then return timed_out() next FDH_time+:= start-elapsed_ms()
	      else count-:= 1 fi;
	   block_deform(q,P next P:=empty,height))
	  {; prints("after block_deform, used ",print_time_string(elapsed_ms() - start))}
  	  ; if elapsed_ms() > expiration then return timed_out() fi
  	  ;  let kt = for c@m in def if  =nu(m) do (c,m.K_type) fi od
     	       	  ,   pp = for c@m in def if !=nu(m) do (c,m) fi od
  	  in output := (output next output:=empty_K) + kt; P := (P next P:=empty) + pp
       od
     in return done(output) next FDH_time+:= start-elapsed_ms()
)


{just for full_deform}

set_type
[ deformation_hash_time =
( ( -> int) size {number of parameters stored}
  , ( -> ) clear
  , (Param -> int) time_record {time taken for full deform of p. answer < -2 means we've tried for
    -answer-2 and not succeeded. answer -2 means we haven't tried.}
  , ((Param,int) -> int) time_record_bounded {time taken for full deform of p, to max of bound}
  , (Param -> int) time_lookup {time taken for full deform of p if known,
    	      	   	       	else -1 if known but no time will ever be available,
				else -2 if completely unknown
				else -T-3 if failed with time T}
  , (Param -> int) param_lookup {index of p in list}
  , (Param -> KTypePol) full_deform
  , ((Param,int) -> maybe_KTP) maybe_full_deform
  , (Param -> bool) is_full_deformed
  , (int -> Param) param_index {parameter #j}
  , (int -> int) time_index {time to compute full_deform of parameter #j}
  , ( -> Param_hash) ParamHash {parameters considered}
  , ( -> vec) timeList {list of times for ParamHash}
  )
]

set make_deformation_hash_time () = deformation_hash_time:
( let param_hash = make_Param_hash()
  then time_list = vec:[]
  then dummy = maybe_KTP: (1*LKT(U(0,0).trivial)).done
  then FD = 1*LKT(GL(1,R).trivial)
  then mFD = FD.done
  then clearDHT() = void:
       param_hash.clear();
       time_list :=[]
  then add_param(Param p) = (KTypePol,int):
       let I = param_hash.size()
       then i = param_hash.match(p), start = elapsed_ms()
       in if i=I {haven't considered p} or time_list[i] <= -3
       	  then let rp = reducibility_points(p)
	       in if #rp = 0
	       	  then FD := if is_equal_rank(p.real_form)
		       	     then full_deform_library(p)
			     else twisted_full_deform_library(p) {These are NOT K_type_pol(p)!}
			     fi;
		       start:= -2
		  else if rp~[0] < 1 then p:= herm_center(Finalize(p*rp~[0])) fi;
		       mFD := if is_equal_rank(p.real_form)
	       	       	      then stored_full_deform(p)
		      	      else stored_twisted_full_deform(p)
		      	      fi;
	       	       FD:= case mFD
		       	    | done(FD): start:=-1;
			      FD
		      	    | timed_out: start:=elapsed_ms();
	       		         	 if is_equal_rank(p.real_form)
		      	 	 	 then full_deform_library(p)
			 	 	 else twisted_full_deform_library(p)
			 	 	 fi
		     	    esac
		   fi; {#rp = 0}
	      	   if i = I
	      	   then time_list #:= if start = -2
		   		      then 0
				      elif start = -1
	       	       		      then 0
		  		      else elapsed_ms() - start
				      fi
	      	   else {time_list[i] <= -3}
	      	   	time_list[i]:= if start = -2
				       then 0
				       elif start = -1
		   		       then 0
				       else (elapsed_ms()- start) - (time_list[i] + 3)
				       fi
		   fi {i=I}
	  else {i < I and time_list[i].>= -2; -2 should be impossible, FD already computed}
	       FD := if is_equal_rank(p.real_form)
	       	     then full_deform_library(p)
	       	     else twisted_full_deform_library(p) {these ought to be instant}
	       	     fi
	  fi; {end of i=I or time_list[i] <= -3}
	  (FD,i)
  then maybe_add_param(Param p, int time) = (maybe_KTP,int): {full_deform, loc of p in param_hash}
       let I = param_hash.size()
       then i = param_hash.match(p), start = elapsed_ms()
       in  if i=I or time_list[i] <= -3
       	   then let rp = reducibility_points(p)
	        in if #rp = 0
	       	   then mFD := if is_equal_rank(p.real_form)
		       	       then full_deform_library(p).done
			       else twisted_full_deform_library(p).done {These are NOT K_type_pol(p)!}
			       fi;K_type_pol(p).done;
		        start:= -2
		   else if rp~[0] < 1 then p:= herm_center(Finalize(p*rp~[0])) fi;
	   	       mFD := if is_equal_rank(p.real_form)
	   	       	      then stored_full_deform(p)
	   	       	      else stored_twisted_full_deform(p)
		       	      fi;
       	   	       mFD := case mFD
	   	       	      |done(FD): start :=-1;
			    	  	 mFD
		       	      |timed_out: start := elapsed_ms();
	   		    	   	  if is_equal_rank(p.real_form)
		       	    	   	  then full_deform_library(p,time)
		       	    	   	  else twisted_full_deform_library(p,time)
		       	    	   	  fi
		       	      esac
		   fi; {#rp = 0}
	  	   if i = I
	  	   then time_list #:= if start = -2
		   		      then 0
				      elif start = -1
	       	       	       	      then 0
		  	     	      else case mFD
			     	   	   |done(FD): elapsed_ms() - start
				  	   |timed_out: (start - elapsed_ms()) - 3
				  	   esac
			     	      fi
	  	   else {time_list[i] <= -3; we prevously tried full_deform, timed out}
	       	    	 time_list[i] := if start = -2
			 	      	 then 0
					 elif start = -1
	       	       	       	     	 then 0
		  	       	     	 else case mFD
			     	     	      |done(FD): elapsed_ms() - start - (time_list[i] + 3)
				    	      |timed_out(): time_list[i] - (elapsed_ms() - start)
				    	      esac
				         fi
		   fi {i=I}
	  else {i < I and time_list[i] >= -1}
	       mFD := if is_equal_rank(p.real_form)
	       	      then full_deform_library(p).done
	       	      else twisted_full_deform_library(p).done
	       	      fi

	  fi;
	  (mFD,i)
   in
  ( ( -> int): {size} @int: param_hash.size()
  , ( -> ): {clear} clearDHT
  , (Param -> int): {time_record} (Param p):
    let (,i) = add_param(p) in time_list[i]
  , ((Param,int) -> int): {time_record_bounded} (Param p, int time):
    let (,j) = maybe_add_param(p,time)
    in time_list[j]
  , (Param -> int): {time_lookup}  (Param p):
    let j = param_hash.lookup(p)
    in if j<0 then -2 else time_list[j] fi
  , (Param -> int): {param_lookup} (Param p): param_hash.lookup(p)
  , (Param -> KTypePol): {full_deform} (Param p):
    let (FD,) = add_param(p) in FD
  , ((Param,int) -> maybe_KTP): {maybe_full_deform} (Param p, int time):
    let (mFD,) = maybe_add_param(p,time) in mFD
  , (Param -> bool): {is_full_deformed} (Param p):
    let j = param_hash.lookup(p) in j>=0 and time_list[j] >= -1
  , (int -> Param): {param_index} (int j): param_hash.index(j)
  , (int -> int): {time_index} (int j): time_list[j]
  , ( -> Param_hash): {ParamHash} @Param_hash: param_hash
  , ( -> vec): {timeList} @vec: time_list
  )
  )

set defHashTime = make_deformation_hash_time()

set_type
[ deformation_hash_height_time =
( ( -> int) size {number of parameters stored}
  , ( -> ) clear
  , ((Param,int) -> int) time_record_to_ht {find time taken for full deform to ht of p. -1 means we'll
    		    	 		   never know. <= -2 not a possible response.}
  , ((Param,int,int) -> int) time_record_to_ht_bounded {find time taken for full deform to ht of p,
    		   	     			       to max of bound. -1 means we'll never know. -2 not
						       a possible response.  <= -3
    		    	 		   means we tried for (minus) this time+3 but did not complete.}
  , ((Param,int) -> int) time_lookup_to_ht {time taken for full deform to ht of p if known with time,
    		    	 		    else 0 if stored,
					    else -2 if completely unknown,
					    else -T-3 if we failed with time T}
  , (Param -> int) param_lookup {index of p in list}
  , ((Param,int) -> KTypePol) full_deform_to_ht
  , ((Param,int,int) -> maybe_KTP) maybe_full_deform_to_ht
  , ((Param,int) -> bool) is_deformed_to_height
  , (int -> Param) param_index {parameter #j}
  , (int -> vec) heights_index {heights to which param j has been full_deformed}
  , (int -> int) trial_height {a height > height_index~[0] where we've tried unsucc to deform}
  , (int -> vec) times_index {times to compute full_deform to heights of parameter #j; -2 if no
    	    	 	      time will ever be available}
  , (int -> int) trial_time {max time tried trial_height}
  , ( -> Param_hash) ParamHash {parameters considered}
  , ( -> [vec]) heightsList {list of max hts for ParamHash}
  , ( -> [vec]) timesList {list of times for ParamHash}
  , ( -> vec) polList {locations in PolHash of deformations to max height}
  , ( -> KTypePol_hash) PolHash {holding full_deform_to_ht's}
  )
]

set full_deform_to_ht_new_flag = false

{meant to count occasions when a desired full_deform_to_ht is obtained from a known full_deform}

set FD_new_count = int:0

set FD_false_low_count = int:0

{ALWAYS HT >= 0}

set make_deformation_hash_height_time () = deformation_hash_height_time:
( let param_hash = make_Param_hash()
  then pol_hash = make_KTypePol_hash() {to store full_deform_to_ht, which library does not}
  then pol_list = vec:[] {jth entry is location in pol_hash of full_deform to max height of Param #j}
  then times_list = [vec]:[] {one for each Param in Param_hash. -1 means val known, not time.}
  then heights_list = [vec]:[] {one for each Param in Param_hash}
  then trial_time_list = vec:[] {one for each Param in Param_hash: time for unsuccessful. (-1 means not tried)}
  then trial_height_list = vec:[] {one for each Param in Param_hash: height for unsuccessful}
  then dummy = maybe_KTP: (1*LKT(U(0,0).trivial)).done
  then FDH = 1*LKT(GL(1,R).trivial)
  then mFDH = FDH.done
  {then badrat = 0/1
  then badp = parameter(E7_s,20912,[3,3,0,2,0,1,2]/1,[1,1,0,2,0,1,1]/2)}
  then clearDHT() = void:
       param_hash.clear();
       pol_hash.clear();
       pol_list := [];
       times_list :=[];
       heights_list := [];
       trial_time_list := [];
       trial_height_list:= []
  then add_param(Param p, int HT) = (KTypePol,int):
       let I = param_hash.size()
       then i = param_hash.match(p), start = elapsed_ms()
       in if i=I or (#heights_list[i] = 0 or heights_list[i]~[0] < HT)
       	  {haven't finished p to HT}
       	  then let rp = reducibility_points(p)
	       in if #rp = 0
	       	  then FDH := if is_equal_rank(p.real_form)
		       	      then full_deform_library(p)
			      else twisted_full_deform_library(p){These are NOT K_type_pol(p)!}
			      fi;
		       start:= -2
		  else if rp~[0] < 1 then p:= herm_center(Finalize(p*rp~[0])) fi;
	  	       FDH := (mFDH := if is_equal_rank(p.real_form)
	       	     	      	      then stored_full_deform(p)
		     	      	      else stored_twisted_full_deform(p)
		     	      	      fi;
	       		       case mFDH
	       	  	       | done(FD): FD_new_count+:=1;
			       		   start:=-1;
		    	       		   to_ht(HT)(FD)
			       | timed_out: start:=elapsed_ms();
					    if is_equal_rank(p.real_form)
		      	       	      	    then full_deform_to_height_MvL_base(p,HT)
			       		    else to_ht(twisted_full_deform_library(p),HT)
			       		    fi
			       esac)
		   fi; {#rp = 0}
	       	   if i = I {new Param}
	       	   then times_list #:= (vec: if start = -2
		   		       	     then [0]
					     elif start = -1
		       		      	     then [0]
					     else [elapsed_ms() - start]
					     fi);
	       	       pol_list #:=pol_hash.match(FDH);
	       	       heights_list #:= (vec: [HT]); {henceforth heights_list[i]~[0] < HT}
		       trial_time_list #:= -1;
		       trial_height_list #:= -1
		  else times_list[i]#:= elapsed_ms() - start; {known Param, prev unfinished at HT}
		       pol_list[i]:=pol_hash.match(FDH);
		       heights_list[i]#:=HT
		  fi;
		  {badrat:= if p = badp
		  	   then 1/0
		  	   else 1/1
		  	   fi;}
		  (FDH, i)
	  else (to_ht(pol_hash.index(pol_list[i]),HT),i)
	       {we already deformed to a greater height}
	  fi
  then maybe_add_param(Param p, int HT, int time) = (maybe_KTP,int):
       let I = param_hash.size()  {always HT >= 0}
       then i = param_hash.match(p), start = elapsed_ms()
       in  if i=I or (#heights_list[i] = 0 or heights_list[i]~[0] < HT)
       	   {haven't finished p to HT}
       	   then let rp = reducibility_points(p)
	       	in if #rp = 0
	       	   then mFDH := if is_equal_rank(p.real_form)
		       	       	then full_deform_library(p).done
			       	else twisted_full_deform_library(p).done {These are NOT K_type_pol(p)!}
			       	fi;
		       	start:= -2
		   else (if rp~[0] < 1 then p:= herm_center(Finalize(p*rp~[0])) fi;
	   	   	mFDH := if is_equal_rank(p.real_form) {this is maybe_KTP}
	       	     	      	then stored_full_deform(p)
		     	      	else stored_twisted_full_deform(p)
		     	      	fi;
		        mFDH:= case mFDH
	       	  	       | done(FD): FD_new_count+:=1;
			       	    	   start :=-1;
		    	       	    	   to_ht(mFDH,HT)
			       | timed_out: start := elapsed_ms();
			       	     	    if is_equal_rank(p.real_form)
		      	       	     	    then full_deform_to_height_MvL_base(p,HT,time)
			       	     	    else to_ht(twisted_full_deform_library(p,time),HT)
			       	     	    fi
			 	esac)
			 {prints("time offered = ",time,", taken = ", elapsed_ms() - start);
			 prints("result = ",mFDH)}
		    fi; {#rp = 0}
	       	    if i = I
	       	    then case mFDH
		    	 | done(FDH): times_list#:= (vec: if start = -2
			   	      		    	  then [0]
							  elif start = -1 {means stored full deform worked}
			   	      		    	  then [0]
							  else [elapsed_ms() - start]
							  fi);
			      	      pol_list #:= pol_hash.match(FDH);
	       	       	 	      heights_list #:= (vec: [HT]);
				      trial_time_list #:= -1;
		       		      trial_height_list #:= -1
			 | timed_out: times_list#:= (vec:[]);
			   	      pol_list #:= -1;
				      heights_list#:=(vec:[]);
				      trial_height_list#:=HT;
				      trial_time_list#:=elapsed_ms() - start
			 esac
		    else case mFDH {known p, HT not prev finished}
		    	 | done(FDH): times_list[i]#:= if start = -2
			   	      		       then 0
						       elif start = -1
			   	      		       then 0
						       else (elapsed_ms() - start)
						       fi;
			   	      pol_list[i] := pol_hash.match(FDH);
		       	 	      heights_list[i]#:=HT
			 | timed_out: trial_height_list[i]:=HT;
			   	      trial_time_list[i]:=elapsed_ms() - start
			 esac
		    fi;
		    {badrat:= if p = badp
		  	     then 1/0
		  	     else 1/1
		  	     fi;}
		    (mFDH, i)
	    else (to_ht(pol_hash.index(pol_list[i]), HT).done, i)
	    fi {i=I or #heights...}
   in
  ( ( -> int): {size} @int: param_hash.size()
  , ( -> ): {clear} clearDHT
  , ((Param,int) -> int): {time_record_to_ht} (Param p, int HT):
    if HT < 0 then return defHashTime.time_record(p) fi;
    let (,j) = add_param(p,HT)
    in let k = first(for ht in heights_list[j] do ht >= HT od)
       in times_list[j][k]
  , ((Param,int,int) -> int): {time_record_to_ht_bounded} (Param p, int HT, int time):
    if HT < 0 then return defHashTime.time_record_bounded(p,time) fi;
    let (,j) = maybe_add_param(p,HT,time)
    in if #heights_list[j] > 0 and heights_list[j]~[0] >= HT
       then let k = first(for ht in heights_list[j] do ht >= HT od)
       	    in times_list[j][k]
       else -trial_time_list[j]-3
       fi
  , ((Param,int) -> int): {time_lookup_to_ht} (Param p, int HT):
    {this is T>=0 if that was the time for full_deform_to_ht, -2 if p is unknown,
     -1 if full_deform_to_ht is known, but not time, and -3 -T if we tried for time T
     without success}
    if HT < 0 then return defHashTime.time_lookup(p) fi;
    let j = param_hash.lookup(p)
    in if j<0
       then -2 {p not known to defHashTime}
       elif #heights_list[j] = 0 or heights_list[j]~[0] < HT
       then if trial_height_list[j] >= HT then -trial_time_list[j]-3 else -2 fi {changed -3 to -2 4/20}
       	    {we've tried but not yet succeeded}
        else let k = first(for ht in heights_list[j] do ht >= HT od)
       	    in times_list[j][k]
	    {we know the full_deform; this is -1 if can't know time}
       fi
  , (Param -> int): {param_lookup} (Param p): param_hash.lookup(p)
  , ((Param,int) -> KTypePol): {full_deform_to_ht} (Param p, int HT):
    if HT < 0 then return defHashTime.full_deform(p) fi;
    let (FD,) = add_param(p,HT) in FD
  , ((Param,int,int) -> maybe_KTP): {maybe_full_deform_to_ht} (Param p, int HT, int time):
    if HT < 0 then return defHashTime.maybe_full_deform(p,time) fi;
    let (mFD,) = maybe_add_param(p,HT,time) in mFD
  , ((Param,int) -> bool): {is_deformed_to_height} (Param p, int HT):
    if HT < 0 then return defHashTime.is_full_deformed(p) fi;
    let j = param_hash.lookup(p)
    in j >= 0 and #heights_list[j] > 0 and heights_list[j]~[0] >= HT
  , (int -> Param): {param_index} (int j): param_hash.index(j)
  , (int -> vec): {heights_index} (int j): heights_list[j]
  , (int -> int): {trial_height} (int j): trial_height_list[j]
  , (int -> vec): {times_index} (int j): times_list[j]
  , (int -> int): {trial_time} (int j): trial_time_list[j]
  , ( -> Param_hash): {ParamHash} @Param_hash: param_hash
  , ( -> [vec]): {heightsList} @[vec]: heights_list
  , ( -> [vec]): {timesList} @[vec]: times_list
  , ( -> vec): {polList} @vec: pol_list
  , ( -> KTypePol_hash): {PolHash} @KTypePol_hash: pol_hash
  )
  )

set defHashHtTime = make_deformation_hash_height_time()

set full_deform(Param p) = KTypePol:
    if is_simple(p.root_datum) or #simple_factorsRF(p.real_form) = 1
    then regroup(p.real_form,defHashTime.full_deform(p))
    else let mu0 = LKTs(p)[0]
    	 in glue_sigs(for dpL in derived_factor_params0(p)
	    	      do regroup(dpL.real_form,defHashTime.full_deform(dpL))
		      od, mu0)
    fi

set full_deform(Param p, int time) = maybe_KTP:
    if is_simple(p.root_datum) or #simple_factorsRF(p.real_form) = 1
    then regroup(p.real_form,defHashTime.maybe_full_deform(p,time))
    else full_deform_library(p,time)
    fi

set twisted_full_deform(Param p) = KTypePol:
    {if is_simple(p.root_datum) or #simple_factorsRF(p.real_form) = 1
    then} regroup(p.real_form,defHashTime.full_deform(p))
    {else twisted_full_deform_library(p)
    fi}

set twisted_full_deform(Param p, int time) = maybe_KTP:
    {if is_simple(p.root_datum) or #simple_factorsRF(p.real_form) = 1
    then} regroup(p.real_form,defHashTime.maybe_full_deform(p,time))
    {else twisted_full_deform_library(p,time)
    fi}

set full_deform_to_ht(Param p, int HT) = KTypePol:
    if is_simple(p.root_datum) or #simple_factorsRF(p.real_form) = 1
    then regroup(p.real_form,defHashHtTime.full_deform_to_ht(p,HT))
    else full_deform_to_height_MvL_base(p,HT)
    fi

set full_deform_to_ht(Param p, int HT, int time) = maybe_KTP:
    if is_simple(p.root_datum) or #simple_factorsRF(p.real_form) = 1
    then regroup(p.real_form,defHashHtTime.maybe_full_deform_to_ht(p, HT, time))
    else full_deform_to_height_MvL_base(p,HT,time)
    fi

set twisted_full_deform_to_ht(Param p, int HT) = KTypePol:
    regroup(p.real_form,defHashHtTime.full_deform_to_ht(p,HT))

set twisted_full_deform_to_ht(Param p, int HT, int time) = maybe_KTP:
    regroup(p.real_form,defHashHtTime.maybe_full_deform_to_ht(p,HT,time))

{should require number of -alphav*theta >= number of alphav}

set red_coroots(KGBElt x) = [vec]:
    let G = x.real_form,  theta = x.involution
    then rho = G.rho, pos_co = G.poscoroots
    in for alphav@j in pos_co
       do if (alphav*theta*rho).< and poscoroot_index(G, -alphav*theta) >= j
       	  then [alphav]
	  else []
	  fi
       od.##

{this version guarantees that the range function in steve.at produces NONNEGATIVE integers, allowing
the value to be stored as a bitset}

set red_coroots_DV(KGBElt x, ratvec lambda) = [vec]:
   let rd = x.root_datum
in for alpha_v@j in rd.poscoroots
   {retain real poscoroots and complex descents nonneg on d_lambda}
      if coroot_index(rd,alpha_v*x.involution).< and (alpha_v*((1+x.involution)*lambda)).>=
      do alpha_v
      fi
   od

{like is_pure, but in case of false, second value is the lowest K-type where
the KTypePol changes sign. Better to put the guilty K-type in a hash table.}

set is_pure_cert(KTypePol P) = [KType]:
    if is_pure(P) then [KType]: []
    else let terms = for c@p in P
    	     	     do let (a,b) = %c
    	     	     	in (a,b,p)
		     od
    	 then (a0,b0,p0) = terms[0]
	 then j=int:0
	 then () = if a0*b0 != 0
	           then let ()= j:=0
		   	in ()
	           elif b0 = 0
	      	   then let ()= j:= first(for (,b,)@j in terms
	      	      	     	      	   do b!=0
				      	   od)
			in ()
	      	   else {now b0!=0 and a0=0}
		   	let () = j:= first(for (a,,)@j in terms
	      	      	     	      do a!=0
				      od)
			in ()
		   fi
	  then (,,pj) = terms[j]
	  in [pj]
    fi

{like is_pure_cert, but in case of false, writing the guilty K-types in a
hash table.}

set is_pure_cert_hash_old(KTypePol P, KTypePol_hash cert_hash) = bool:
    if not is_pure(P)
    then let terms = for c@p in P
    	     	     do let (a,b) = %c
    	     	     	in (a,b,p)
		     od
    	 then (a0,b0,p0) = terms[0]
	 then j=int:0
	 then () = if a0*b0 != 0
	           then let ()= j:=0
		   	in ()
	           elif b0 = 0
	      	   then let ()= j:= first(for (,b,)@j in terms
	      	      	     	      	   do b!=0
				      	   od)
			in ()
	      	   else {now b0!=0 and a0=0}
		   	let () = j:= first(for (a,,)@j in terms
	      	      	     	      do a!=0
				      od)
			in ()
		   fi
	  then (,,pj) = terms[j]
	  then x = cert_hash.match(1*pj)
	  in false
    else true
    fi

{like is_pure_cert, but in case of false, writing the guilty K-types in a
hash table.}
{ want this version to record SUM of lowest impurity }

set is_pure_cert_hash(KTypePol P, KTypePol_hash cert_hash) = bool:
    if not is_pure(P)
    then let terms = for c@p in P
    	     	     do let (a,b) = %c
    	     	     	in (a,b,p)
		     od
    	 then (a0,b0,p0) = terms[0]
	 then j=int:0 {next line is the lowest negative terms}
	 then B = if a0*b0 != 0
	          then to_ht(P,height(p0))
	          elif b0 = 0
	      	  then let N = sum(P.real_form, for (a,b,p) in terms
		   	      			do if b!=0 then [1*p] else [] fi od.##)
		   	in to_ht(N,height(first_K_type(N)))
	      	  else  {now b0!=0 and a0=0}
		       let N = sum(P.real_form, for (a,b,p) in terms
		   	      			do if a!=0 then [1*p] else [] fi od.##)
		       in to_ht(N,height(first_K_type(N)))
		  fi
	  then x = cert_hash.match(B)
	  in false
    else true
    fi

{meant to hold number of NEGATIVE Dirac inequality tests}

set DTcount = int: 0

{meant to hold number of NEGATIVE Dirac_best inequality tests}

set DBTcount = int: 0

set next_heightC_time = int: 0

{will be modified to name of local test being run}

set test_string = string: ""

{whether to report on slow is_unitary and is_unitary_to_ht}

set drain_plug_flag = bool: false

{report on tests requiring more than this time; default is 100000 = 10 seconds}

set drain_plug_time = int: 100000

set tested_pos_hash = make_Param_hash() {all Param's that have had a positive is_unitary test}

set tested_pos_times = [int]: [] {one for each tested_pos_hash.list() entry; TOTAL time
    		       	 	    for all positive is_unitary tests of entry}

set tested_pos_strings = [string]: []

set tested_pos_counts = [int]: [] {hope this is 0 or 1!}

set tested_neg_hash = make_Param_hash() {all Param's that have had a negative is_unitary test}

set tested_neg_times = [int]: [] {one for each tested_list entry; TOTAL time
    		       	 	    for all negative is_unitary tests of entry}

set tested_neg_strings = [string]: []

set tested_neg_counts = [int]: [] {hope this is 0 or 1!}

set tested_inter_hash = make_Param_hash() {all Param's that have had an interrupted is_unitary test}

set tested_inter_times = [int]: [] {one for each tested_inter_hash.list() entry; TOTAL time
    		       	 	    for all interrupt is_unitary tests of entry}

set tested_inter_counts = [int]: []

set tested_inter_strings = [string]: []

set tested_pos_to_ht_hashes = [Param_hash]: [] {jth is all Param's that had a positive is_unitary
    			      		       	to height(p)+j test}

set tested_pos_to_ht_times = [[int]]: []

set tested_pos_to_ht_strings = [[string]]: []

set tested_pos_to_ht_counts = [[int]]: []

set tested_neg_to_ht_hashes = [Param_hash]: [] {jth is all Param's that had a negative is_unitary
    			      		       	to height(p)+j test}

set tested_neg_to_ht_times = [[int]]: []

set tested_neg_to_ht_strings = [[string]]: []

set tested_neg_to_ht_counts = [[int]]: []

set tested_inter_to_ht_hashes = [Param_hash]: [] {jth is all Param's that had an interrupted is_unitary
    			      		       	to height(p)+j test}

set tested_inter_to_ht_times = [[int]]: []

set tested_inter_to_ht_strings = [[string]]: []

set tested_inter_to_ht_counts = [[int]]: []

set OT_hash = make_Param_hash() {used to record interrupted tests that ran too long; maybe not used now?}

set OT_times = [int]: [] {cumulative time for each OT_hash.list() entry}

set OT_counts = [int]: [] {number of occurrences for each OT_hash.list() entry}

{set cSp = int:0}

set was_tested(Param p, int T, bool ans) = void:
    {let () = if p = parameter(Sp(6,R),8,[2,1,1],[1,-1,0]/2)
    	     then cSp+:=1; 1/(cSp-4)
	     else 1/1
	     fi}
    {if p = parameter(F4_s,101,[1,1,1,-1]/1,[0,1,0,-2]/1)
    then assert(@:false); prints("testing p0")
    fi;}
    {if p = parameter(F4_s,102,[2,2,1,-4]/1,[1,4,0,-9]/4)
    then assert(@:false); prints("testing p1")
    fi;}
    if drain_plug_flag and T > drain_plug_time
    then prints(p," took ",print_time_string(T)," to test is_unitary = ", ans)
    fi;
    unitary_test_counter.use();
    let i = tested_inter_hash.lookup(p)
    in if i >= 0
       then T+:=tested_inter_times[i]
       fi;
    if ans
    then let M = tested_pos_hash.size()
       	 then m = tested_pos_hash.match(p)
       	 {then prints("M = ",M,", m = ",m)}
	 in if m = M
	    then tested_pos_times#:=T;
	    	 tested_pos_strings #:= test_string;
		 tested_pos_counts #:=1
	    else tested_pos_times[m] +:= T;
	    	 tested_pos_counts[m] +:= 1
	    fi
    else let M = tested_neg_hash.size()
       	 then m = tested_neg_hash.match(p)
	 {then prints("M = ",M,", m = ",m)}
	 in if m = M
	    then tested_neg_times#:=T;
	    	 tested_neg_strings #:= test_string;
		 tested_neg_counts #:=1
	    else tested_neg_times[m] +:= T;
	    	 tested_neg_counts[m] +:= 1
	    fi
    fi

set was_tested_inter(Param p, int T) = void:
    if drain_plug_flag and T > drain_plug_time
    then prints(p," took ",print_time_string(T)," for interrupted is_unitary")
    fi;
    unitary_test_counter.use();
    let M = tested_inter_hash.size()
    then m = tested_inter_hash.match(p)
    in if m=M
       then tested_inter_times #:= T;
	    tested_inter_strings #:= test_string;
       	    tested_inter_counts #:=1
       else tested_inter_times[m] +:= T;
       	    tested_inter_counts[m] +:=1
       fi

{keep track of whether interruption ran too long}

set was_tested_inter(Param p, int T, int T_target) = void:
    if drain_plug_flag and T > drain_plug_time
    then prints(p," took ",print_time_string(T)," for interrupted is_unitary")
    fi;
    if T>(5/4)*T_target
    then let OTM = OT_hash.size()
    	 then OTm = OT_hash.match(p)
	 in if OTm=OTM
	    then OT_times #:= T - T_target;
	    	 OT_counts #:= 1
	    else OT_times[OTm] +:= T - T_target;
	    	 OT_counts[OTm] +:= 1
	    fi
    fi;
    unitary_test_counter.use();
    let M = tested_inter_hash.size()
    then m = tested_inter_hash.match(p)
    in if m=M
       then tested_inter_times #:= T;
       	    tested_inter_counts #:=1
       else tested_inter_times[m] +:= T;
       	    tested_inter_counts[m] +:=1
       fi

set was_tested_to_ht(Param p,int N, int T, bool ans) = void:
    if drain_plug_flag and T > drain_plug_time
    then prints(p," took ",print_time_string(T)," to test is_unitary_to_ht ", N,
    	 	 " = ",ans)
    fi;
    unitary_test_counter.use();
    let h = N - height(p)
    then add = h+1 - #tested_pos_to_ht_hashes
    in if add>0
        then {if N = 17 and T > 8000 then 0/0 fi;}
	     tested_pos_to_ht_hashes ##:= for j:add do make_Param_hash() od;
	     tested_neg_to_ht_hashes ##:= for j:add do make_Param_hash() od;
	     tested_inter_to_ht_hashes ##:= for j:add do make_Param_hash() od;
	     tested_pos_to_ht_times ##:= for j:add do [int]: [] od;
	     tested_neg_to_ht_times ##:= for j:add do [int]: [] od;
	     tested_inter_to_ht_times ##:= for j:add do [int]: [] od;
	     tested_pos_to_ht_strings ##:= for j:add do [string]: [] od;
	     tested_neg_to_ht_strings ##:= for j:add do [string]: [] od;
	     tested_inter_to_ht_strings ##:= for j:add do [string]: [] od;
	     tested_pos_to_ht_counts ##:= for j:add do [int]: [] od;
	     tested_neg_to_ht_counts ##:= for j:add do [int]: [] od;
	     tested_inter_to_ht_counts ##:= for j:add do [int]: [] od
       fi;
       let i = tested_inter_to_ht_hashes[h].lookup(p)
       in if i >= 0 then T+:= tested_inter_to_ht_times[h][i] fi;
       if ans
       then let M = tested_pos_to_ht_hashes[h].size()
    	    then m = tested_pos_to_ht_hashes[h].match(p)
       	    in if m = M
	       then tested_pos_to_ht_times[h]#:=T;
	    	    tested_pos_to_ht_strings[h] #:= test_string;
		    tested_pos_to_ht_counts[h] #:=1
	       else let tpthh = tested_pos_to_ht_times[h], tpthc = tested_pos_to_ht_counts[h]
		    in tpthh[m] +:= T;
		       tested_pos_to_ht_times[h] := tpthh;
		       tpthc[m] +:= 1;
		       tested_pos_to_ht_counts[h] := tpthc
	       fi
        else let M = tested_neg_to_ht_hashes[h].size()
    	     then m = tested_neg_to_ht_hashes[h].match(p)
	     in	if m = M
	       	then tested_neg_to_ht_times[h] #:=T;
	    	    tested_neg_to_ht_strings[h] #:= test_string;
		    tested_neg_to_ht_counts[h] #:=1
	       else let tnthh = tested_neg_to_ht_times[h], tnthc = tested_neg_to_ht_counts[h]
	    	    in tnthh[m] +:= T;
		       tnthc[m] +:= 1;
		       tested_neg_to_ht_times[h] := tnthh;
		       tested_neg_to_ht_counts[h] := tnthc
	       fi
        fi

set was_tested_inter_to_ht(Param p,int HT, int T) = void:
    if drain_plug_flag and T > drain_plug_time
    then prints(p," took ",print_time_string(T)," for interrupted is_unitary_to_ht ", HT)
    fi;
    unitary_test_counter.use();
    let h = HT - height(p)
    then add = h+1 - #tested_pos_to_ht_hashes
    then () = if add>0
    	      then tested_pos_to_ht_hashes ##:= for j:add do make_Param_hash() od;
	      	   tested_neg_to_ht_hashes ##:= for j:add do make_Param_hash() od;
	      	   tested_inter_to_ht_hashes ##:= for j:add do make_Param_hash() od;
		   tested_pos_to_ht_times ##:= for j:add do [int]: [] od;
		   tested_neg_to_ht_times ##:= for j:add do [int]: [] od;
		   tested_inter_to_ht_times ##:= for j:add do [int]: [] od;
		   tested_pos_to_ht_strings ##:= for j:add do [string]: [] od;
		   tested_neg_to_ht_strings ##:= for j:add do [string]: [] od;
		   tested_inter_to_ht_strings ##:= for j:add do [string]: [] od;
		   tested_pos_to_ht_counts ##:= for j:add do [int]: [] od;
		   tested_neg_to_ht_counts ##:= for j:add do [int]: [] od;
		   tested_inter_to_ht_counts ##:= for j:add do [int]: [] od
	      fi
    in let M = tested_inter_to_ht_hashes[h].size()
       then m = tested_inter_to_ht_hashes[h].match(p)
       in if m = M
	  then tested_inter_to_ht_times[h]#:=T;
	       tested_inter_to_ht_strings[h] #:= test_string;
	       tested_inter_to_ht_counts[h] #:=1
	  else let tithh = tested_inter_to_ht_times[h], tithc = tested_inter_to_ht_counts[h]
	       in tithh[m] +:= T;
	       	  tested_inter_to_ht_times[h] := tithh;
	    	  tithc[m] +:= 1;
		  tested_inter_to_ht_counts[h] := tithc
	  fi

{keep track of whether interruption failed}
{set was_tested_inter_to_ht(Param p, int HT, int T, int T_target) = void:
