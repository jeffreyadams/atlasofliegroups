<ballpoint.at {for integer points in balls}
{
the various notions of "weakly unipotent" concern a rep X0 of a
reductive g of (real dominant) infinitesimal character gamma0, and the
possible infinitesimal characters gamma1 of composition factors X1 of
X\otimes F, with F certain finite-dimensional reps.

In DV's original definition from "Unitarizability of certain..." (here
called "weakly unipotent), F is allowed to be any algebraic rep of G,
and the requirement is that _gamma1 cannot be strictly shorter than
gamma0_ (in some fixed invariant form). This is interesting because it
leads to a unitarizability theorem for cohomological induction.

Changing the condition "strictly shorter" to "weakly shorter" makes the
def of weakly unipotent more restrictive: FEWER reps satisfy it. But
maybe it's interesting, so we compute it as "strictly weakly unipotent."

There is also a definition by Lucas Mason-Brown and Dougal Davis
(Def 4.11 https://arxiv.org/pdf/2503.14794) in which F is allowed to
be any ADJOINT rep of G, and the requirement
is that gamma1 cannot belong to [(convex hull of W*gamma0) minus
(W*gammm0)]. We call this DMB-weakly unipotent. There is no
implication either way with weakly unipotent, because we allow fewer
F, but impose a stricter requirement on gamma1.

Each of these conditions is a condition on the annihilator ideal I(X0)
(because Ann(X0\otimes F) can be computed from Ann(X0) and Ann(F)). In
this file we analyze the condition for the MAXIMAL primitive ideal
J_max(gamma0).

Main idea: for gamma0 fixed and gamma1 varying, the ball {|gamma1| \le |gamma0|}
is contained in the half-space {<gamma1,gamma0> \le <gamma0,gamma0>}.
}

{given a RootDatum G and an infl char lambda, produces a pair (RootDatum, [int]) consisting of the
integrality datum M of lambda (an endoscopic group) and the special W_M-rep corresponding to
V(I_{max}(lambda))}

set special_data(RootDatum G, ratvec lambda) = (RootDatum, vec):
let M=integrality_datum(G,lambda) then
SpM=Springer_table(M) then
OM=av_maximal_ideal(M,lambda) in
(M,springer_character(SpM)(OM))

{compute and store ind from WL to WM of trivial on WL}

set (indLs, clear_indLs, indLs_size) = (((RootDatum, RootDatum) -> ([int],CharacterTable)),
    (void -> void), (void -> (int,int))):
    let rdHash = make_RootDatum_hash()
    then cts = [CharacterTable]:[] {one for each rd in rdHash}
    then indHash = make_vec_hash() {possible answers}
    then testedHash = make_vec_hash() {vecs of size 2 recording pairs (M,L) from rdHash
    	 	      		      where we've computed}
    then answers = [[int]]: [] {for each pair in testedHash, location of answer in indHash}
    then add_rd(RootDatum rd) = int: {location of rd in rdHash}
    	 let N = rdHash.size()
	 then n = rdHash.match(rd)
	 in if n=N
	    then cts #:= character_table(rd)
	    fi; n
    then add_pair(RootDatum M,RootDatum L) = vec: {location of answer in indHash, ctM in cts}
    	 let J = testedHash.size()
	 then v=vec:[add_rd(M),add_rd(L)]
	 then j = testedHash.match(v)
	 in if j = J {haven't seen this pair before}
	    then answers #:= induce_character(cts[v[1]], cts[v[0]], trivial(cts[v[1]]))
	    fi;
	    [j,v[0]]
    in
    ( (((RootDatum, RootDatum)->([int],CharacterTable)): {indLs} (RootDatum M, RootDatum L)
      ([int],CharacterTable):
      let ans = add_pair(M,L)
      in (answers[ans[0]], cts[ans[1]]))
      , (( -> ): {clear} @:  rdHash.clear(); cts:=[]; indHash.clear(); testedHash.clear();
      	answers:=[])
      , (( -> (int,int)): {indLs_size} @(int,int): (rdHash.size(), testedHash.size())) 
    )

{given a special rep E of a Weyl group W_M and a Levi subgroup L of M, determines whether
trivial rep of standard Levi W_L corresponding to S appears in the restriction of E to W_L}


set appears_in(RootDatum M, vec E, RootDatum L) = bool:
    let (ind,ctM) = indLs(M,L)
    in ctM.inner(E,ind) > 0

set appears_in_old(RootDatum M, CharacterTable ctM, vec E, RootDatum L) = bool:
let ctL=character_table(L) then
trivL=trivial(ctL) then
ind=induce_character(ctL,ctM,trivL) in
ctM.inner(E,ind)>0

{given a RootDatum G and an infl char lambda, produces a list of all subsets S of simple lambda-integral 
roots such that appears_in(M,E,Levi_datum(M,S))=true, where E is the special W_M-rep associated to 
(G,lambda)}

set prohibited_singular_data(RootDatum G, ratvec lambda) = [vec]:
let (M,E)=special_data(G,lambda) then
ctM=character_table(M) in
##(for S in power_set(M.all_simples) do if appears_in(M,E,Levi_datum(M,S)) then [S] else [] 
fi od)

{given RootDatum G and a ratvec gamma, determines whether gamma is in root lattice of G} 

set in_root_lattice(RootDatum G, ratvec gamma) = bool:
let F=fundamental_coweights(G)
then X=for f in F do f*gamma od
in is_integer(X)

set in_root_lattice_B(RootDatum G, ratvec gamma) = bool:
(ratvec: for f in fundamental_coweights(G) do f*gamma od).denom = 1

{given a positive rational number x, and a positive integer n, this function lists all n-tuples
[a_1,...,a_n] of nonnegative integers such that \sum a_i <= x}

set weak_tuples(rat x, int n) = [vec]:
let N=floor(x) in
compositions_le(N,n)

{given a positive rational number x, and a positive integer n, this function lists all n-tuples
[a_1,...,a_n] of nonnegative integers such that \sum a_i < x}

set tuples(rat x, int n) = [vec]:
let N=if is_integer(x) then floor(x-1) else floor(x) fi in
compositions_le(N,n)

{given a positive rational number x and a strictly positive ratvec weights,
this function lists all #weights-tuples [a_1,...,a_n] of nonnegative integers
such that \sum a_i weights_i <= x}

set weak_tuples_weighted(rat x, ratvec weights) = [vec]:
    let t=min(weights), T=max(weights)
    then () = if t = 0 then return [] fi
    then n=#weights
    then tuples=weak_tuples(T*x/t,n)
    in for X in tuples if X*weights<=x do X fi od

{given a positive rational number x and a ratvec weights, this function lists all #weights-tuples
[a_1,...,a_n] of nonnegative integers such that \sum a_i weights_i < x}

set tuples_weighted(rat x, ratvec weights) = [vec]:
    let t=min(weights), T = max(weights)
    then () = if t = 0 then return [] fi
    then n=#weights
    then tuples=tuples(T*x/t,n)
    in for X in tuples if X*weights < x do X fi od


{given a ratvec X with nonnegative entries, a ratvec weights with positive entries, and a
ratvec Y with arbitrary entries, lists all ratvecs Z such that
1) sum Z_i weights_i <= sum X_i weights_i
2) Y_i - Z_i is an integer for each i}
{weights_i will be pairings of fund wts with some dominant lambda
 X_i will be pairings of lambda with simple coweights; equiv, lambda = sum X_i F_i
 Y_i will be pairings of gamma with simple coweights (defining integrality of Z);
    equiv, coeffs in gamma = sum Y_i F_i
 Z_i will be pairings of tuple with simple coweights; equiv, coeffs in tuple = sum Z_i F_i}

set weak_tuples_weighted(ratvec X, ratvec weights, ratvec Y) = [ratvec]:
let remainders=for y in Y do y-floor(y) od then
total=X*weights then tuples=weak_tuples_weighted(total,weights) in for Z in
tuples if (Z+remainders)*weights <= X*weights do Z+remainders fi od

{given a ratvec X with nonnegative entries, a ratvec weights with positive entries, and a
ratvec Y with arbitrary entries, lists all ratvecs Z such that
1) sum Z_i weights_i < sum X_i weights_i
2) Y_i - Z_i is an integer for each i}

set tuples_weighted(ratvec X, ratvec weights, ratvec Y) = [ratvec]:
let remainders=for y in Y do y-floor(y) od then
total=X*weights then
tuples=tuples_weighted(total,weights) in
for Z in tuples if (Z+remainders)*weights < X*weights do Z+remainders fi od


{given a dominant ratweight lambda and an arbitrary ratweight gamma, lists all dominant weights mu so
1) Q(mu,lambda) <= Q(lambda,lambda) (This is the below-tangent hyperplane condition that ALLOWS all
   		   		     shorter mu.)
2) gamma-mu is in the weight lattice
3) mu is not lambda}

set weak_candidates_dominant_old(RootDatum G, ratvec lambda, ratvec gamma) = [ratvec]:
   let F = fundamental_weights(G) {[ratvec]}
   then mF=ratvecs_as_ratmat(F) {ratmat}
   then C=simple_coroots(G) {[vec]}
   then X=for c in C do lambda*c od {ratvec}
   then Y=for c in C do gamma*c od {ratvec}
   then Q = invariant_form(G) {(ratvec,ratvec) -> rat}
   then weights= for f in F do Q(f,lambda) od {ratvec, pairings of fund wts with lambda}
   then tuples=weak_tuples_weighted(X,weights,Y) {[ratvec]}
   in for Z in tuples {to make lin comb of fund weights}
      do let cand = mF*Z
      	 in if Q(cand,lambda) <= Q(lambda,lambda) and cand!=lambda
	    then [cand]
	    else []
	    fi
	    od.##

{given a dominant ratweight lambda and an arbitrary ratweight gamma, lists all dominant weights mu so
1) Q(mu,mu) <= Q(lambda,lambda)
2) gamma-mu is in the weight lattice
3) mu is not lambda}

set weak_candidates_dominant(RootDatum G, ratvec lambda, ratvec gamma) = [ratvec]:
   let F = fundamental_weights(G) {[ratvec]}
   then mF=ratvecs_as_ratmat(F) {ratmat}
   then C=simple_coroots(G) {[vec]}
   then base_coords =  ratvec: for f@j in F do frac(C[j]*gamma) od {fundamental weight coords}
   then base = ratvec: sum(G.rank, for f@j in F do frac(C[j]*gamma)*f od)
   then Q = invariant_form(G) {(ratvec,ratvec) -> rat}
   then M = mat: for f in F do for g in F do rat_as_int(Q(f,g)) od od
   in for Z in ballpoints(Q(lambda,lambda) - Q(base,base), M, 2*M*base_coords)
      if mF*Z  + base != lambda
      do mF*Z + base
      fi
      od

{given a dominant weight lambda and an arbitrary weight gamma, lists all dominant weights mu so
1) Q(mu,lambda) < Q(lambda,lambda) (This is the below-tangent hyperplane condition that ALLOWS all
   		   		     strictly shorter mu.)
2) gamma-mu is in the weight lattice}

set candidates_dominant_old(RootDatum G, ratvec lambda, ratvec gamma) = [ratvec]:
let F=fundamental_weights(G) then
mF=ratvecs_as_ratmat(F) then
C=simple_coroots(G) then
X=for c in C do lambda*c od then
Y=for c in C do gamma*c od then
Q = invariant_form(G) then
weights= for f in F do Q(f,lambda) od then
tuples=tuples_weighted(X,weights,Y) in
for Z in tuples do let cand = mF*Z
in if Q(cand,lambda) < Q(lambda,lambda)
   then [cand]
   else []
   fi
   od.##

{given a dominant weight lambda and an arbitrary weight gamma, lists all dominant weights mu so
1) Q(mu,lambda) < Q(lambda,lambda) (This is the below-tangent hyperplane condition that ALLOWS all
   		   		     strictly shorter mu.)
2) gamma-mu is in the weight lattice}

set candidates_dominant(RootDatum G, ratvec lambda, ratvec gamma) = [ratvec]:
   let F = fundamental_weights(G) {[ratvec]}
   then mF=ratvecs_as_ratmat(F) {ratmat}
   then C=simple_coroots(G) {[vec]}
   then base_coords =  ratvec: for f@j in F do frac(C[j]*gamma) od {fundamental weight coords}
   then base = ratvec: sum(G.rank, for f@j in F do frac(C[j]*gamma)*f od)
   then Q = invariant_form(G) {(ratvec,ratvec) -> rat}
   then M = mat: for f in F do for g in F do rat_as_int(Q(f,g)) od od
   in for Z in open_ballpoints(Q(lambda,lambda) - Q(base,base), M, 2*M*base_coords)
      do mF*Z + base
      od

{next few functions compute coset representatives for W/(integral Weyl group for infl char lambda)}

set W_orbit(RootDatum G,[int] S,((int,ratvec)->ratvec) action, ratvec gamma)=
let orbit=[([int],ratvec)]:[([],gamma)] then
todo=[([int],ratvec)]:[([],gamma)] in
while #todo>0 do
   let (w,v)=todo[0] in
   for s in S do
   let sv=action(s,v) then
   j=first(for (,y) in orbit do y=sv od) in
   if j=-1 then orbit#:=([s]##w,sv); todo#:=([s]##w,sv) fi
   od;
   todo:=todo[1:]
od;orbit

set W_orbit(RootDatum G,((int,ratvec)->ratvec) action, ratvec gamma)=
W_orbit(G,for i:ss_rank(G) do i od,action,gamma)

set star_action(RootDatum G,int i, ratvec v)=
let w=reflect(G,i,v)
in dominant(integrality_datum(G,w),w)

set star_W_orbit(RootDatum G,ratvec v)=
let f(int i,ratvec v)=star_action(G,i,v) in W_orbit(G,f,v)

set W_mod_W_int(RootDatum G,ratvec v)=for (w,) in star_W_orbit(G,v) do W_elt(G,w) od


{given a RootDatum G and a dominant weight lambda, lists all integrally dominant weights mu such that
1) Q(mu,mu) <= Q(lambda,lambda)
2) w*lambda-mu is in the weight lattice for some w in W}

set weak_candidates_integrally_dominant(RootDatum G, ratvec lambda) = [ratvec]:
let ws=W_mod_W_int(G,lambda) in
##(for w in ws do let list=weak_candidates_dominant(G,lambda,w*lambda) in
for x in list do w.inverse*x od od)


{given a RootDatum G and a dominant weight lambda, lists all integrally dominant weights mu such that
1) Q(mu,mu) < Q(lambda,lambda)
2) w*lambda-mu is in the weight lattice for some w in W}

set candidates_integrally_dominant(RootDatum G, ratvec lambda) = [ratvec]:
let ws=W_mod_W_int(G,lambda) in
##(for w in ws do let list=candidates_dominant(G,lambda,w*lambda) in
for x in list do w.inverse*x od od)


{given a RootDatum G and a dominant weight lambda, lists all integrally dominant weights mu such that
1) Q(mu,mu) <= Q(lambda,lambda)
2) w*lambda-mu is in the root lattice for some w in W}

{SAME AS weak_candidates_integrally_dominant}
set weak_candidates_shorter(RootDatum G, ratvec lambda) = [ratvec]:
    weak_candidates_integrally_dominant(G,lambda)

{given a RootDatum G and a dominant weight lambda, lists all integrally dominant weights mu such that
1) Q(mu,mu) < Q(lambda,lambda)
2) lambda-mu is in the weight lattice}

set candidates_shorter(RootDatum G, ratvec lambda) = [ratvec]:
    candidates_integrally_dominant(G,lambda) 

{given a RootDatum G and a dominant weight lambda, lists all integrally dominant weights mu such that
1) Q(mu,mu) <= Q(lambda,lambda)
2) lambda-mu is in the root lattice}
{is_integer: testing for in X^*}

set weak_candidates_integrally_dominant_root_lattice(RootDatum G, ratvec lambda) = [ratvec]:
let C=weak_candidates_integrally_dominant(G,lambda) in
for mu in C if in_root_lattice(G,mu-lambda) do mu fi od


{given a RootDatum G and a dominant weight lambda, lists all integrally dominant weights mu such that
1) Q(mu,mu) < Q(lambda,lambda)
2) lambda-mu is in the root lattice}
{is_integer: testing for in X^*}

set candidates_integrally_dominant_root_lattice(RootDatum G, ratvec lambda) = [ratvec]:
let C=candidates_integrally_dominant(G,lambda) in
for x in C if in_root_lattice(G,x-lambda) do x fi od


{given a RootDatum G and a dominant weight lambda, lists all integrally dominant weights mu such that
1) Q(mu,mu) <= Q(lambda,lambda)
2) lambda-mu is in the weight lattice}
{
set weak_candidates_shorter_root_lattice(RootDatum G, ratvec lambda) = [ratvec]:
{let C=}weak_candidates_integrally_dominant_root_lattice(G,lambda) {then
I=invariant_form(G) then
ell=I(lambda,lambda) in
for x in C do if I(x,x)<= ell do x fi od}
}


{given a RootDatum G and a dominant weight lambda, lists all integrally dominant weights mu such that
1) |mu| <= |lambda|
2) lambda-mu is in the root lattice}

set weak_candidates_shorter_root_lattice(RootDatum G, ratvec lambda) = [ratvec]:
    weak_candidates_integrally_dominant_root_lattice(G,lambda)

set candidates_shorter_root_lattice(RootDatum G, ratvec lambda) = [ratvec]:
    candidates_integrally_dominant_root_lattice(G,lambda)

{given a RootDatum G, a dominant weight lambda, and an arbitrary weight mu, determines whether
the singular datum of mu is NOT on the list prohibited_singular_data(G,lambda). I_{max}(lambda) is weakly unipotent
(resp. very weakly unipotent) if and only if the answer is "true" for every mu in candidates_integrally_dominant(G,lambda) 
(resp. candidates_integrally_dominant_root_lattice(G,lambda)}

set check_mu(RootDatum G, ratvec lambda, ratvec mu) = bool:
let sings=prohibited_singular_data(G,lambda) then
M=integrality_datum(G,lambda) then
S=##(for rv@i in simple_coroots(M) do if rv*mu=0 then [i] else [] fi od) in
find(sings,S)=-1

set check_mu(RootDatum M, ratvec lambda, ratvec mu, [vec] sings)=bool:
let S=##(for rv@i in simple_coroots(M) do if rv*mu=0 then [i] else [] fi od) in
find(sings,S)=-1

set iwu_time = int:0
set iwu_count = int:0

{given a RootDatum G and a dominant weight lambda, determines whether the maximal ideal I_{max}(lambda)
is weakly unipotent}

set is_weakly_unipotent(RootDatum G, ratvec lambda)=bool:
    iwu_count+:=1;
    let start = elapsed_ms(), list=candidates_shorter(G,lambda)
    in if #list=0
       then true
       else let sings=prohibited_singular_data(G,lambda)
       	    then M=integrality_datum(G,lambda)
	    in all(for mu in list
	       	    do @bool: check_mu(M,lambda,mu,sings)
		    od) next iwu_time+:= elapsed_ms() - start
       fi
{0=sum(for mu in list do #(check_mu(M,lambda,mu,sings)=false) od) fi next iwu_time+:= elapsed_ms() - start}

{See intro above: fewer lambda will pass this test}
set is_strictly_weakly_unipotent(RootDatum G, ratvec lambda)=bool:
    iwu_count+:=1;
    let start = elapsed_ms(), list=weak_candidates_shorter(G,lambda)
    in if #list=0
       then true
       else let sings=prohibited_singular_data(G,lambda)
       	    then M=integrality_datum(G,lambda)
	    in all(for mu in list
	       	   do @bool: check_mu(M,lambda,mu,sings)
		   od)
       fi next iwu_time+:= elapsed_ms() - start
{0=sum(for mu in list do #(check_mu(M,lambda,mu,sings)=false) od) fi next iwu_time+:= elapsed_ms() - start}

{given a RootDatum G and a dominant weight lambda, determines whether the maximal ideal I_{max}(lambda) is DMB weakly unipotent}

set is_DMB_weakly_unipotent(RootDatum G, ratvec lambda)=bool:
    iwu_count+:=1;
    let start = elapsed_ms(), list=candidates_shorter_root_lattice(G,lambda)
    in list:=for mu in list
       	         if all(for f in fundamental_coweights(G)
			do @bool: f*(lambda-mu) >= 0
			od)
	             do mu
		  fi {require lambda-mu = sum of _pos_ roots; since mu is dominant, this is
		      same as mu in cvx hull(W*lambda)}
	      od;
       if #list = 0 then true
       else let sings=prohibited_singular_data(G,lambda)
       	    then M=integrality_datum(G,lambda)
       in all([(->bool)]: for mu in list
	       		       	  do @bool: check_mu(M,lambda,mu,sings)
			       	  od)
       	   fi next iwu_time+:= elapsed_ms() - start
{0=sum(for mu in list do #(check_mu(M,lambda,mu,sings)=false) od) fi}


