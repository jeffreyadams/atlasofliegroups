<basic.at
<parameters.at { square@RealForm for is_pure }
<misc.at { simple_root_index }
<torus.at
<restricted_roots.at { remove_duplicates([vec]) }

{ Folding / restricted-root helpers needed by endoscopic_groups.at, ported
  from the endoscopy_side branch's twisted_root_datum.at. They are kept in
  this separate support file so that master's twisted_root_datum.at (used by
  other scripts, and carrying a divergent |folded|) is left untouched. }

set orbit_size (mat delta, vec alpha) = int:
  let j=first(for i:10 from 1 do (delta^i)*alpha=alpha od)+1
  in assert(j!=0,"orbit_size failed"); j

set orbit_of_simple_root (RootDatum G,mat delta, int j) = [int]: {indices}
  let alpha=G.simple_roots[j] in
  for j:orbit_size(delta,alpha) do simple_root_index(G,delta^j*alpha) od

{ roots of |rd| whose restriction to |T| is |alpha|, |2*alpha| or |alpha/2| }
set roots_restricting_to_multiple (RootDatum rd,SubTorus T,vec alpha) = [vec]:
  ## for beta in rd.roots
     do let res=T.restrict(beta) in
        if res=alpha or res=2*alpha or alpha=2*res then [beta] else [] fi
     od

{ to_dominant: inverse-direction wrapper of from_dominant, used across the
  endoscopy files (also defined identically in endoscopic_groups.at) }
set to_dominant (RootDatum rd, vec wt) = (WeylElt,vec):
  let (w,wt_dom)=from_dominant(rd,wt) in (inverse(w),wt_dom)
set to_dominant (vec cowt,RootDatum rd) = (vec,WeylElt):
  let (cowt_dom,w)=from_dominant(cowt,rd) in (cowt_dom,inverse(w))
set to_dominant (RootDatum rd, ratvec wt) = (WeylElt,ratvec):
  let (n,d)=%wt then (w,v)=to_dominant(rd,n) in (w,v/d)
set to_dominant (ratvec cowt,RootDatum rd) = (ratvec,WeylElt):
  let (n,d)=%cowt then (v,w)=to_dominant(n,rd) in (v/d,w)

{ branch-only helpers from the endoscopy_side basic.at (master's basic.at
  lacks these; |fac| omitted -- master already has it) }
set in_weight_lattice (RootDatum rd,ratvec v) = bool: is_integer(v*rd.simple_coroots)
set in_coweight_lattice (RootDatum rd,ratvec v) = bool: is_integer(v*rd.simple_roots)
{ remove_zeros/prune omitted: not needed by the closure, and [vec] collides
  with mat under current axis. left_solve/right_solve ARE needed by
  homomorphism.at (root_map/coroot_map); they wrap master's solve@(mat,mat). }
set right_solve (mat A,mat B) = Maybe<mat>: solve(A,B)  { solve AX=B }
set left_solve (mat A,mat B) = Maybe<mat>:              { solve XA=B }
   case solve(^A,^B) | none: none() | some(sol): (^sol).some esac

{ branch-only strong-real-form purity (different notion from master's
  is_pure@Split): a real form is pure iff its central-cocharacter datum
  matches the quasisplit form's. Needs square@(RealForm/KGBElt) (parameters.at) }
set is_pure (KGBElt x) = bool: square(x)=square(quasisplit_form(x.real_form))
set is_pure (RealForm G) = bool: square(G)=square(quasisplit_form(G))
