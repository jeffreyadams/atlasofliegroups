{ FPP_support.at

  Supplement file for the FPP facet-based unitary-dual suite port from
  branch origin/to_ht_branch_alt.

  This file collects branch-only additions to atlas scripts that must NOT be
  clobbered because they are (a) loaded transitively by all.at and/or (b)
  covering-group-modified in this atlasCovering fork.  Every definition below
  is reproduced VERBATIM (by exact signature) from origin/to_ht_branch_alt,
  keeping only signatures absent from the corresponding fork file, so all.at
  behaviour is untouched.  This file is loaded only by FPP scripts.
}

{ NB: this file must stay CYCLE-FREE.  It is included very early (e.g. from
  goodroots.at, and from bottom_layer.at via smallQ.at) so it must NOT pull in
  bottom_layer.at / FPP_faces_herm.at, which cyclically include each other.
  Only light, cycle-free prerequisites are included here. }

<induction.at { for parabolic/induction helpers; theta_stable_quasi_data }
<lattice.at { for in_lattice_basis (basis_lambda_differential_0) }
<parabolics.at { for parabolic_by_wt }
<derived_cover.at { for inverse_embed_KGB }
<hash.at { fork base hash constructors (make_vec_hash(), .fill, etc.) }

{ ---- branch-only data-initializing hash overloads (hash.at is core) ----
  origin/to_ht_branch_alt:atlas-scripts/hash.at adds make_*_hash([...] data)
  overloads via a multi-arg make_hash the fork's hash.at lacks.  The fork's
  Hash<T> exposes a .fill method, so we provide behaviourally equivalent
  overloads (construct empty, then fill) without touching core hash.at.
  Used by red_points.at (make_vec_hash), weak_unip.at (make_ratvec_hash),
  and FPP_support/up_mu (make_Param_hash). }
set make_vec_hash ([vec] data) = Hash<vec>:
    let h = make_vec_hash() in h.fill(data); h
set make_ratvec_hash ([ratvec] data) = Hash<ratvec>:
    let h = make_ratvec_hash() in h.fill(data); h
set make_Param_hash ([Param] data) = Hash<Param>:
    let h = make_Param_hash() in h.fill(data); h

{ ---- branch-only additions to basic.at (core) ----
  back_map: like map but with forward (small-x first) iteration; branch adds
  three overloads the fork basic.at lacks.  branch_builtin_time: a global
  timing counter the FPP suite reads/resets.  Verbatim from
  origin/to_ht_branch_alt:atlas-scripts/basic.at . }
set back_map ((Param->KType)f, ParamPol P) = KTypePol:
  P.real_form.null_K_module + for c@p in P do (c,f(p)) od
set back_map ((KType->KTypePol)f, KTypePol P) = KTypePol:
  sum(P.real_form,for c@p in P do c*f(p) od)
set back_map ((Param->KTypePol)f, ParamPol P) = KTypePol:
  sum(P.real_form,for c@p in P do c*f(p) od)

set branch_builtin_time = int:0

{ ---- branch-only addition to induction.at (covering-modified; core) ----
  theta_stable_quasi_data_im: as theta_stable_quasi_data, but shrinks L so the
  Cartan is the maximally split one in L.  Verbatim from
  origin/to_ht_branch_alt:atlas-scripts/induction.at .  Used by goodroots.at. }
set theta_stable_quasi_data_im (Param q) = (Parabolic,Param):
    let qIm = parameter(q.x, q.lambda + 2*rho_i(q.x), q.nu)
    then (,q2)=qIm.from_dlambda_dom
    then dlambda2 = d_lambda(q2), x2=q2.x, lambda2=q2.lambda
    then Q2 = parabolic_by_wt(dlambda2,x2)
    then L2 = Q2.Levi
    then x2_L2=inverse_embed_KGB(x2,L2)
    in
    (Q2, parameter(x2_L2, lambda2 -2*rho_i(x2) -rho(real_form(q2))+rho(L2), q2.nu))

{ delta_on_simple: branch-only addition to induction.at.  Verbatim from
  origin/to_ht_branch_alt:atlas-scripts/induction.at .  Used by smallQ.at
  (which is pulled in transitively by bottom_layer.at below, so this MUST
  precede that include). }
set delta_on_simple(InnerClass ic) = [int]:
    let (r,SR,delta) = (ic.semisimple_rank, ic.simple_roots, ic.distinguished_involution)
    in for i:r do root_index(ic, delta*SR[i]) od

{ ---- branch-only additions to K_highest_weights.at (core) ----
  The branch K_highest_weights.at carries mat-argument overloads of
  basis_lambda_differential_0 and all_lambda_differential_0; the fork only has
  the KGBElt versions (the mat basis lives in bottom_layer.at, which we cannot
  include here without a cycle).  Both are reproduced VERBATIM from
  origin/to_ht_branch_alt:atlas-scripts/K_highest_weights.at .  Used by
  FPP_lambdas.at (all_lambda_differential_0(x.involution)).  The fork's
  bottom_layer.at defines an identical basis_lambda_differential_0(mat); the
  later (harmless) re-binding there is fine. }
set basis_lambda_differential_0 (mat theta) = mat:
  let E=eigen_lattice(theta,-1)
  then (A,v)=adapted_basis(in_lattice_basis(E,1-theta))
  in E * columns_with((int j):v[j]=2,A)
set all_lambda_differential_0 (mat theta) = [vec]:
  let basis=basis_lambda_differential_0(theta) in
  for v in all_0_1_vecs(n_columns(basis)) do basis*v od
